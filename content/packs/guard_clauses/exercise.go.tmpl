// Package gate is the Groundwork exercise "Guard clauses".
package gate

import (
	"fmt"
	"slices"
	"strconv"
	"strings"
)

// Change is a request to deploy a new version of a service.
type Change struct {
	Service     string
	Environment string // "staging" or "production"
	TestsPassed bool
	Approvals   int
	Frozen      bool // true during a change freeze, such as a holiday
}

// Verdict says whether c may be deployed: "ok", or the reason it may not.
func Verdict(c Change) string {
	// TODO(1): Flatten this into guard clauses: one if per rule, no else.
	if c.Service != "" {
		if !c.Frozen {
			if c.TestsPassed {
				if c.Approvals >= 1 {
					if c.Environment == "production" && c.Approvals < 2 {
						return "production needs 2 approvals"
					}
					return "ok"
				} else {
					return "needs an approval"
				}
			} else {
				return "tests failed"
			}
		} else {
			return "change freeze in effect"
		}
	} else {
		return "missing service name"
	}
}

// Host is one server in the fleet.
type Host struct {
	Name            string
	Up              bool
	DiskUsedPercent int
	Tags            []string
}

// PatchTargets returns the names of the hosts to patch tonight, in order:
// hosts that are up, not tagged "do-not-patch", and less than 90% full.
func PatchTargets(hosts []Host) []string {
	// TODO(2): Flatten the loop body: skip each host you don't want with
	// continue.
	var targets []string
	for _, host := range hosts {
		if host.Up {
			if !slices.Contains(host.Tags, "do-not-patch") {
				if host.DiskUsedPercent < 90 {
					targets = append(targets, host.Name)
				}
			}
		}
	}
	return targets
}

// ParseReplicas reads a setting like "replicas=3" and returns the count. See
// the README for the errors it returns.
func ParseReplicas(setting string) (int, error) {
	// TODO(3): Flatten this so every error returns early and the happy path
	// runs down the left edge.
	key, value, found := strings.Cut(setting, "=")
	if found {
		if key == "replicas" {
			n, err := strconv.Atoi(value)
			if err == nil {
				if n >= 0 && n <= 50 {
					return n, nil
				} else {
					return 0, fmt.Errorf("replicas must be between 0 and 50, got %d", n)
				}
			} else {
				return 0, fmt.Errorf("replicas %q is not a number", value)
			}
		} else {
			return 0, fmt.Errorf("unknown setting %q", key)
		}
	} else {
		return 0, fmt.Errorf(`missing "=" in %q`, setting)
	}
}
