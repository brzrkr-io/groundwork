// Package hashring is the Groundwork exercise "Hash rings: find a key's node".
package hashring

import (
	"hash/crc32"
	"slices"
)

// Point returns where s sits on the ring: a number from 0 to 4,294,967,295.
func Point(s string) uint32 {
	return crc32.ChecksumIEEE([]byte(s))
}

// Next returns the index of the first point in points at or after h, or 0
// when h is past the last point. points must be sorted from low to high and
// must not be empty.
func Next(points []uint32, h uint32) int {
	i, _ := slices.BinarySearch(points, h)
	if i == len(points) {
		return 0 // past the last point: wrap around to the first
	}
	return i
}

// Ring routes keys to nodes. Every node sits on the ring at one point, and a
// key belongs to the node at the first point at or after the key's hash,
// wrapping around after the last point.
type Ring struct {
	points []uint32          // every point on the ring, sorted from low to high
	owners map[uint32]string // point -> the node that sits there
}

// New returns an empty Ring.
func New() *Ring {
	return &Ring{owners: make(map[uint32]string)}
}

// Add places each node on the ring at Point(node). Points that are already
// on the ring are skipped, so adding a node twice changes nothing.
func (r *Ring) Add(nodes ...string) {
	for _, node := range nodes {
		p := Point(node)
		if _, taken := r.owners[p]; taken {
			continue
		}
		r.owners[p] = node
		r.points = append(r.points, p)
	}
	slices.Sort(r.points)
}

// Get returns the node that owns key, or "" if the ring is empty.
func (r *Ring) Get(key string) string {
	if len(r.points) == 0 {
		return ""
	}
	return r.owners[r.points[Next(r.points, Point(key))]]
}
