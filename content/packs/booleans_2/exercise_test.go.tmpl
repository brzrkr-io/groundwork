package booleans

import "testing"

func TestShouldPage(t *testing.T) {
	if !ShouldPage("critical", false) {
		t.Errorf(`ShouldPage("critical", false) = false, want true`)
	}
	if ShouldPage("critical", true) {
		t.Errorf(`ShouldPage("critical", true) = true, want false`)
	}
	if ShouldPage("warning", false) {
		t.Errorf(`ShouldPage("warning", false) = true, want false`)
	}
	if ShouldPage("warning", true) {
		t.Errorf(`ShouldPage("warning", true) = true, want false`)
	}
}

func TestIsHealthy(t *testing.T) {
	if !IsHealthy(0.005, 120) {
		t.Errorf("IsHealthy(0.005, 120) = false, want true")
	}
	if !IsHealthy(0.001, 500) {
		t.Errorf("IsHealthy(0.001, 500) = false, want true")
	}
	if IsHealthy(0.01, 120) {
		t.Errorf("IsHealthy(0.01, 120) = true, want false")
	}
	if IsHealthy(0.2, 120) {
		t.Errorf("IsHealthy(0.2, 120) = true, want false")
	}
	if IsHealthy(0.005, 501) {
		t.Errorf("IsHealthy(0.005, 501) = true, want false")
	}
}

func TestInMaintenanceWindow(t *testing.T) {
	if !InMaintenanceWindow(22) {
		t.Errorf("InMaintenanceWindow(22) = false, want true")
	}
	if !InMaintenanceWindow(23) {
		t.Errorf("InMaintenanceWindow(23) = false, want true")
	}
	if !InMaintenanceWindow(0) {
		t.Errorf("InMaintenanceWindow(0) = false, want true")
	}
	if !InMaintenanceWindow(1) {
		t.Errorf("InMaintenanceWindow(1) = false, want true")
	}
	if InMaintenanceWindow(2) {
		t.Errorf("InMaintenanceWindow(2) = true, want false")
	}
	if InMaintenanceWindow(12) {
		t.Errorf("InMaintenanceWindow(12) = true, want false")
	}
	if InMaintenanceWindow(21) {
		t.Errorf("InMaintenanceWindow(21) = true, want false")
	}
}
