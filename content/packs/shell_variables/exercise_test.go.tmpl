	"fmt"
	"os/exec"
	"slices"
	"strings"
	"testing"
)

func TestAnnounce(t *testing.T) {
	expect(t, "Deploying checkout to production\n", "1_announce.sh", "checkout", "production")
	expect(t, "Deploying api to staging\n", "1_announce.sh", "api", "staging")
}

func TestImageRef(t *testing.T) {
	expect(t, "registry.example.com/api:v1.4.2\n", "2_image_ref.sh", "api", "v1.4.2")
	expect(t, "registry.example.com/worker:latest\n", "2_image_ref.sh", "worker")
}

func TestCountHosts(t *testing.T) {
	expect(t, "testdata/web_hosts.txt: 4 hosts\n", "3_count_hosts.sh", "testdata/web_hosts.txt")
	expect(t, "testdata/db_hosts.txt: 2 hosts\n", "3_count_hosts.sh", "testdata/db_hosts.txt")
}

func TestRunCheck(t *testing.T) {
	expectWithEnv(t, nil, "DEPLOY_ENV=staging\nLOG_LEVEL=debug\n", "4_run_check.sh", "staging")
	expectWithEnv(t, []string{"LOG_LEVEL=warn"}, "DEPLOY_ENV=production\nLOG_LEVEL=warn\n", "4_run_check.sh", "production")
	expectWithEnv(t, []string{"LOG_LEVEL="}, "DEPLOY_ENV=production\nLOG_LEVEL=debug\n", "4_run_check.sh", "production")
}

// expect runs the script with bash in the exercise folder, just as you do
// in your terminal, and checks that it succeeds and prints want.
func expect(t *testing.T, want, script string, args ...string) {
	t.Helper()
	expectWithEnv(t, nil, want, script, args...)
}

// expectWithEnv is expect with env (like "LOG_LEVEL=warn") added to the
// script's environment. DEPLOY_ENV and LOG_LEVEL are never inherited from
// yours, so the result doesn't depend on your terminal.
func expectWithEnv(t *testing.T, env []string, want, script string, args ...string) {
	t.Helper()
	got, stderr, code := run(t, env, script, args...)
	command := strings.Join(append(slices.Clone(env), commandLine(script, args...)), " ")
	if code != 0 {
		exitFailure(t, command, code, got, stderr)
		return
	}
	switch {
	case got == want:
		return
	case got == "":
		t.Errorf("%s printed nothing, want:\n%s", command, want)
	case strings.Count(want, "\n") > 1:
		t.Errorf("%s printed:\n%s\nwant:\n%s", command, got, want)
	default:
		t.Errorf("%s printed %q, want %q", command, got, want)
	}
	if stderr != "" {
		t.Errorf("%s also printed to stderr:\n%s", command, stderr)
	}
}

// exitFailure explains a script that stopped with a non-zero status: what it
// printed before it stopped, and what bash said on stderr.
func exitFailure(t *testing.T, command string, code int, stdout, stderr string) {
	t.Helper()
	msg := fmt.Sprintf("%s exited with status %d, want 0.", command, code)
	if stdout != "" {
		msg += "\nIt printed:\n" + strings.TrimRight(stdout, "\n")
	}
	if stderr != "" {
		msg += "\nbash said:\n" + stderr
	} else {
		msg += "\nbash said nothing: a command failed without a message, and set -e stopped the script there."
	}
	t.Error(msg)
}

// run runs "bash script args..." with env added to its environment, and
// returns what it printed to stdout and stderr, and its exit status.
func run(t *testing.T, env []string, script string, args ...string) (stdout, stderr string, code int) {
	t.Helper()
	cmd := exec.Command("bash", append([]string{script}, args...)...)
	for _, kv := range cmd.Environ() {
		if !strings.HasPrefix(kv, "DEPLOY_ENV=") && !strings.HasPrefix(kv, "LOG_LEVEL=") {
			cmd.Env = append(cmd.Env, kv)
		}
	}
	cmd.Env = append(cmd.Env, "LC_ALL=C", "TZ=UTC")
	cmd.Env = append(cmd.Env, env...)
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	if err := cmd.Run(); cmd.ProcessState == nil {
		t.Fatalf("could not start bash: %v", err)
	}
	return out.String(), errOut.String(), cmd.ProcessState.ExitCode()
}

// commandLine shows how to run the script by hand: bash, the script and its
// arguments, with quotes around any argument that is empty or has a space.
func commandLine(script string, args ...string) string {
	line := "bash " + script
	for _, arg := range args {
		if arg == "" || strings.Contains(arg, " ") {
			arg = `"` + arg + `"`
		}
		line += " " + arg
	}
	return line
}
