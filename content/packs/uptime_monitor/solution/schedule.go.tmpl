package uptime

import (
	"context"
	"time"
)

// Every calls fn straight away and then once every interval until ctx is
// cancelled. It returns ctx.Err().
func Every(ctx context.Context, interval time.Duration, fn func(ctx context.Context)) error {
	ticker := time.NewTicker(interval)
	defer ticker.Stop()

	fn(ctx)
	for {
		select {
		case <-ticker.C:
			fn(ctx)
		case <-ctx.Done():
			return ctx.Err()
		}
	}
}
