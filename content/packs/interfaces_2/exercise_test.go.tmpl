package interfaces2

import (
	"slices"
	"testing"
)

func TestHTTPCheck(t *testing.T) {
	tests := []struct {
		name     string
		check    HTTPCheck
		wantName string
		wantOK   bool
	}{
		{
			name:     "200 is healthy",
			check:    HTTPCheck{URL: "https://api.example.com/healthz", StatusCode: 200},
			wantName: "http https://api.example.com/healthz",
			wantOK:   true,
		},
		{
			name:     "503 is unhealthy",
			check:    HTTPCheck{URL: "https://shop.example.com/healthz", StatusCode: 503},
			wantName: "http https://shop.example.com/healthz",
			wantOK:   false,
		},
		{
			name:     "404 is unhealthy",
			check:    HTTPCheck{URL: "https://api.example.com/ready", StatusCode: 404},
			wantName: "http https://api.example.com/ready",
			wantOK:   false,
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Ask "does HTTPCheck satisfy HealthChecker?" without breaking
			// the build while it doesn't.
			hc, ok := any(tt.check).(HealthChecker)
			if !ok {
				t.Fatal("HTTPCheck does not satisfy HealthChecker: it needs the methods Name() string and Check() bool")
			}
			if got := hc.Name(); got != tt.wantName {
				t.Errorf("%#v.Name() = %q, want %q", tt.check, got, tt.wantName)
			}
			if got := hc.Check(); got != tt.wantOK {
				t.Errorf("%#v.Check() = %t, want %t", tt.check, got, tt.wantOK)
			}
		})
	}
}

func TestTCPCheck(t *testing.T) {
	tests := []struct {
		name     string
		check    TCPCheck
		wantName string
		wantOK   bool
	}{
		{
			name:     "open port is healthy",
			check:    TCPCheck{Host: "db-1", Port: 5432, Open: true},
			wantName: "tcp db-1:5432",
