			if got := hc.Name(); got != tt.wantName {
				t.Errorf("%#v.Name() = %q, want %q", tt.check, got, tt.wantName)
			}
			if got := hc.Check(); got != tt.wantOK {
				t.Errorf("%#v.Check() = %t, want %t", tt.check, got, tt.wantOK)
			}
		})
	}
}

func TestFailingChecks(t *testing.T) {
	tests := []struct {
		name   string
		checks []HealthChecker
		want   []string
	}{
		{
			name: "some failing",
			checks: []HealthChecker{
				DiskCheck{Path: "/", FreePercent: 42},
				DiskCheck{Path: "/var", FreePercent: 3},
				DiskCheck{Path: "/data", FreePercent: 55},
				DiskCheck{Path: "/tmp", FreePercent: 9},
			},
			want: []string{"disk /var", "disk /tmp"},
		},
		{
			name: "all healthy",
			checks: []HealthChecker{
				DiskCheck{Path: "/", FreePercent: 10},
				DiskCheck{Path: "/var", FreePercent: 80},
			},
			want: []string{},
		},
		{
			name: "all failing",
			checks: []HealthChecker{
				DiskCheck{Path: "/logs", FreePercent: 0},
				DiskCheck{Path: "/", FreePercent: 1},
			},
			want: []string{"disk /logs", "disk /"},
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := FailingChecks(tt.checks)
			if !slices.Equal(got, tt.want) {
				t.Errorf("FailingChecks(%#v) = %q, want %q", tt.checks, got, tt.want)
			}
		})
	}
}
