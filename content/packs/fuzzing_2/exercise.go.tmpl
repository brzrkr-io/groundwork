// Package alerts is the Groundwork exercise "Fuzzing: properties of a truncated alert".
package alerts

// Truncate shortens an alert message to at most limit bytes, because chat and
// pager APIs reject longer messages. It never cuts a UTF-8 character in half:
// if the cut would land inside one, the whole character is dropped. The
// result is always the start of msg. A negative limit counts as 0.
//
// This code has a bug. Task 3 asks you to fix it.
func Truncate(msg string, limit int) string {
	return truncate(msg, limit)
}

// truncate points at the real implementation. Groundwork's grader swaps in
// broken versions to check that your test catches them.
var truncate = realTruncate

// TODO(3): Fix the bug: never cut a character in half. Add "unicode/utf8" to
// the imports.
func realTruncate(msg string, limit int) string {
	limit = max(limit, 0)
	if len(msg) <= limit {
		return msg
	}
	return msg[:limit]
}
