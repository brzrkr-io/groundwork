// Package logscan is the Groundwork exercise "Standard streams: grep-style exit codes".
package logscan

import (
	"bufio"
	"fmt"
	"io"
	"strings"
)

// Run is the whole logscan program. args is os.Args[1:]. It copies the lines
// of stdin that contain the pattern to stdout, and returns grep-style exit
// codes: 0 if any line matched, 1 if none did, 2 for an error.
func Run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
	if len(args) != 1 {
		fmt.Fprintln(stderr, "usage: logscan PATTERN")
		return 2
	}
	pattern := args[0]

	matches := 0
	sc := bufio.NewScanner(stdin)
	for sc.Scan() {
		line := sc.Text()
		if strings.Contains(line, pattern) {
			fmt.Fprintln(stdout, line)
			matches++
		}
	}
	if err := sc.Err(); err != nil {
		// 2, not 1: "no match" must never be confused with "could not read".
		fmt.Fprintf(stderr, "logscan: reading stdin: %v\n", err)
		return 2
	}

	fmt.Fprintf(stderr, "logscan: %d matching line(s)\n", matches)
	if matches == 0 {
		return 1
	}
	return 0
}
