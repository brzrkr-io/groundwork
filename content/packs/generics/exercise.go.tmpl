// Set is a collection of distinct values.
type Set[T comparable] map[T]bool

// NewSet returns a set holding the given items.
func NewSet[T comparable](items ...T) Set[T] {
	s := Set[T]{}
	for _, item := range items {
		s[item] = true
	}
	return s
}

