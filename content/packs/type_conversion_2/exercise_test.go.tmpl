package conversion

import "testing"

func TestAvgMemoryMiB(t *testing.T) {
	if got := AvgMemoryMiB(1000, 4); got != 250 {
		t.Errorf(`AvgMemoryMiB(1000, 4) = %v, want 250`, got)
	}

	if got := AvgMemoryMiB(1000, 8); got != 125 {
		t.Errorf(`AvgMemoryMiB(1000, 8) = %v, want 125`, got)
	}

	if got := AvgMemoryMiB(3, 2); got != 1.5 {
		t.Errorf(`AvgMemoryMiB(3, 2) = %v, want 1.5`, got)
	}
}

func TestPortLabel(t *testing.T) {
	if got := PortLabel(8080); got != "port 8080" {
		t.Errorf(`PortLabel(8080) = %q, want "port 8080"`, got)
	}

	if got := PortLabel(443); got != "port 443" {
		t.Errorf(`PortLabel(443) = %q, want "port 443"`, got)
	}
}

func TestAffordableReplicas(t *testing.T) {
	if got := AffordableReplicas(100, 30); got != 3 {
		t.Errorf(`AffordableReplicas(100, 30) = %d, want 3`, got)
	}

	if got := AffordableReplicas(90, 30); got != 3 {
		t.Errorf(`AffordableReplicas(90, 30) = %d, want 3`, got)
	}

	if got := AffordableReplicas(250, 12.5); got != 20 {
		t.Errorf(`AffordableReplicas(250, 12.5) = %d, want 20`, got)
	}

	if got := AffordableReplicas(10, 2.5); got != 4 {
		t.Errorf(`AffordableReplicas(10, 2.5) = %d, want 4 (divide first, then drop the fraction)`, got)
	}

	if got := AffordableReplicas(29.99, 30); got != 0 {
		t.Errorf(`AffordableReplicas(29.99, 30) = %d, want 0`, got)
	}
}
