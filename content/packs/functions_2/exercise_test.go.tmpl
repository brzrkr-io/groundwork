package functions

import "testing"

func TestUsageLine(t *testing.T) {
	if got := UsageLine("api", 3, 8); got != "api: 37.5% CPU" {
		t.Errorf(`UsageLine("api", 3, 8) = %q, want "api: 37.5%% CPU"`, got)
	}
	if got := UsageLine("worker", 1, 4); got != "worker: 25.0% CPU" {
		t.Errorf(`UsageLine("worker", 1, 4) = %q, want "worker: 25.0%% CPU"`, got)
	}
	if got := UsageLine("db", 2, 2); got != "db: 100.0% CPU" {
		t.Errorf(`UsageLine("db", 2, 2) = %q, want "db: 100.0%% CPU"`, got)
	}
}

func TestTagOrLatest(t *testing.T) {
	if got := TagOrLatest("1.4.2"); got != "1.4.2" {
		t.Errorf(`TagOrLatest("1.4.2") = %q, want "1.4.2"`, got)
	}
	if got := TagOrLatest("stable"); got != "stable" {
		t.Errorf(`TagOrLatest("stable") = %q, want "stable"`, got)
	}
	if got := TagOrLatest(""); got != "latest" {
		t.Errorf(`TagOrLatest("") = %q, want "latest"`, got)
	}
}

func TestImageRef(t *testing.T) {
	if got := ImageRef("ghcr.io/acme", "api", "1.4.2"); got != "ghcr.io/acme/api:1.4.2" {
		t.Errorf(`ImageRef("ghcr.io/acme", "api", "1.4.2") = %q, want "ghcr.io/acme/api:1.4.2"`, got)
	}
	if got := ImageRef("docker.io", "nginx", ""); got != "docker.io/nginx:latest" {
		t.Errorf(`ImageRef("docker.io", "nginx", "") = %q, want "docker.io/nginx:latest"`, got)
	}
	if got := ImageRef("registry.local", "worker", "v2"); got != "registry.local/worker:v2" {
		t.Errorf(`ImageRef("registry.local", "worker", "v2") = %q, want "registry.local/worker:v2"`, got)
	}
}
