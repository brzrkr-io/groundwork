// Package deploy is the Groundwork exercise "Practice: reproduce a bug report".
package deploy

import "fmt"

// NormalizeEnvironment checks the environment name given to the deploy
// command and returns its canonical form: "development", "staging" or
// "production". Any other name is an error.
func NormalizeEnvironment(name string) (string, error) {
	return normalizeEnvironment(name)
}

// normalizeEnvironment points at the real implementation. Groundwork's grader
// swaps in broken versions to check that your test catches them.
var normalizeEnvironment = realNormalizeEnvironment

func realNormalizeEnvironment(name string) (string, error) {
	// TODO(2): Accept the name in any mix of upper and lower case.
	// TODO(4): Ignore spaces around the name.
	switch name {
	case "development", "staging", "production":
		return name, nil
	}
	return "", fmt.Errorf("unknown environment %q", name)
}
