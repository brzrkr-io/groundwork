// Command statusd answers health checks for the deploy dashboard. The
// Dockerfiles in this folder package it as a container image.
package main

import (
	"fmt"
	"log"
	"net/http"
	"os"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	env := os.Getenv("APP_ENV")
	if env == "" {
		env = "dev"
	}
	http.HandleFunc("/healthz", func(w http.ResponseWriter, _ *http.Request) {
		fmt.Fprintf(w, "ok (%s)\n", env)
	})
	log.Printf("statusd listening on :%s (%s)", port, env)
	log.Fatal(http.ListenAndServe(":"+port, nil))
}
