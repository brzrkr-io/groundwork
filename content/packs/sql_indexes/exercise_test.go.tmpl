package sqlindexes

import (
	"database/sql"
	"os"
	"slices"
	"strings"
	"testing"

	_ "modernc.org/sqlite" // the SQLite driver, registered as "sqlite"
)

const latestDeploys = `SELECT id, version FROM deploys WHERE service = 'api' ORDER BY started_at DESC LIMIT 5`

func TestIndexService(t *testing.T) {
	const file = "1_index_service.sql"
	db := newDB(t)
	runFile(t, db, file)
	checkIndex(t, db, file, "deploys_by_service", false, "service")
	checkSearches(t, db, file, `SELECT * FROM deploys WHERE service = 'api'`, "deploys_by_service")
}

func TestIndexLatest(t *testing.T) {
	const file = "2_index_latest.sql"
	db := newDB(t)
	runFile(t, db, file)
	checkIndex(t, db, file, "deploys_by_service_time", false, "service", "started_at")
	steps := checkSearches(t, db, file, latestDeploys, "deploys_by_service_time")
	if strings.Contains(steps, "TEMP B-TREE") {
		t.Errorf("after %s, the plan for\n    %s\nstill sorts the rows separately:\n%s\nwant the index to hand them over already in started_at order", file, latestDeploys, steps)
	}
}

func TestUniqueRelease(t *testing.T) {
	const file = "3_unique_release.sql"
	db := newDB(t)
	runFile(t, db, file)
	checkIndex(t, db, file, "deploys_one_per_release", true, "service", "version", "environment")

	ok := `INSERT INTO deploys (service, version, environment, status, started_at, duration_s) VALUES ('api', 'v1.5.0-rc.1', 'production', 'succeeded', '2026-03-07 09:00:00', 90)`
	if _, err := db.Exec(ok); err != nil {
		t.Errorf("after %s, a new release is rejected:\n    %s\n    error: %v", file, ok, err)
	}
	duplicate := `INSERT INTO deploys (service, version, environment, status, started_at, duration_s) VALUES ('api', 'v1.4.0', 'production', 'succeeded', '2026-03-07 10:00:00', 90)`
	if _, err := db.Exec(duplicate); err == nil {
		t.Errorf("after %s, the database accepted a second production deploy of api v1.4.0:\n    %s", file, duplicate)
	}
}

func TestOneDay(t *testing.T) {
	const file = "4_one_day.sql"
	db := newDB(t)
	query := readSQL(t, file)
	got := queryRows(t, db, query)
	want := [][]string{{"9", "api"}, {"10", "billing"}, {"11", "billing"}}
	if !slices.EqualFunc(got, want, slices.Equal) {
		t.Errorf("%s returned:\n%s\nwant:\n%s", file, table(got), table(want))
	}
	checkSearches(t, db, file, query, "deploys_by_start")
}

// newDB returns a fresh in-memory database loaded from testdata/schema.sql
// and testdata/data.sql.
func newDB(t *testing.T) *sql.DB {
	t.Helper()
	db, err := sql.Open("sqlite", ":memory:")
	if err != nil {
		t.Fatal(err)
	}
	// Every connection to ":memory:" gets its own empty database: use one.
	db.SetMaxOpenConns(1)
	t.Cleanup(func() { db.Close() })
	for _, fixture := range []string{"testdata/schema.sql", "testdata/data.sql"} {
		if _, err := db.Exec(readSQL(t, fixture)); err != nil {
			t.Fatalf("loading %s: %v", fixture, err)
		}
	}
	return db
}

// runFile runs every statement in file.
func runFile(t *testing.T, db *sql.DB, file string) {
	t.Helper()
	if _, err := db.Exec(readSQL(t, file)); err != nil {
		t.Fatalf("%s failed: %v", file, err)
	}
}

// readSQL returns the contents of file without its "--" comment lines. It
// fails the test if nothing is left, because then there's nothing to run yet.
func readSQL(t *testing.T, file string) string {
	t.Helper()
	data, err := os.ReadFile(file)
	if err != nil {
		t.Fatal(err)
	}
	var b strings.Builder
	for line := range strings.Lines(string(data)) {
		if !strings.HasPrefix(strings.TrimSpace(line), "--") {
			b.WriteString(line)
		}
	}
	if strings.TrimSpace(b.String()) == "" {
		t.Fatalf("%s has no SQL yet: write it under the TODO", file)
	}
	return b.String()
}

// checkIndex checks that an index called name exists on deploys, whether it
// is unique, and which columns it covers, in order.
func checkIndex(t *testing.T, db *sql.DB, file, name string, unique bool, columns ...string) {
	t.Helper()
	found := queryRows(t, db, `SELECT "unique" FROM pragma_index_list('deploys') WHERE name = '`+name+`'`)
	if len(found) == 0 {
		t.Fatalf("after %s there is no index named %s on deploys", file, name)
	}
	if isUnique := found[0][0] == "1"; isUnique != unique {
		t.Errorf("after %s, index %s unique = %v, want %v", file, name, isUnique, unique)
	}
	var got []string
	for _, row := range queryRows(t, db, `SELECT name FROM pragma_index_info('`+name+`') ORDER BY seqno`) {
		got = append(got, row[0])
	}
	if !slices.Equal(got, columns) {
		t.Errorf("after %s, index %s covers columns (%s), want (%s)", file, name, strings.Join(got, ", "), strings.Join(columns, ", "))
	}
}

// checkSearches asks SQLite how it would run query (EXPLAIN QUERY PLAN) and
// reports an error unless it searches deploys through the named index. It
// returns the plan, one step per line.
func checkSearches(t *testing.T, db *sql.DB, file, query, index string) string {
	t.Helper()
	var steps []string
	for _, row := range queryRows(t, db, "EXPLAIN QUERY PLAN "+query) {
		steps = append(steps, "    "+row[3])
	}
	plan := strings.Join(steps, "\n")
	if !strings.Contains(plan, "    SEARCH deploys USING INDEX "+index+" ") &&
		!strings.Contains(plan, "    SEARCH deploys USING COVERING INDEX "+index+" ") {
		t.Errorf("after %s, the plan for\n    %s\nis:\n%s\nwant a step starting \"SEARCH deploys USING INDEX %s\"",
			file, strings.TrimSpace(query), plan, index)
	}
	return plan
}

// queryRows runs query and returns its rows with every value as text.
func queryRows(t *testing.T, db *sql.DB, query string) [][]string {
	t.Helper()
	rows, err := db.Query(query)
	if err != nil {
		t.Fatalf("%s: %v", strings.TrimSpace(query), err)
	}
	defer rows.Close()
	columns, err := rows.Columns()
	if err != nil {
		t.Fatal(err)
	}
	var result [][]string
	for rows.Next() {
		values := make([]sql.NullString, len(columns))
		targets := make([]any, len(columns))
		for i := range values {
			targets[i] = &values[i]
		}
		if err := rows.Scan(targets...); err != nil {
			t.Fatal(err)
		}
		row := make([]string, len(columns))
		for i, v := range values {
			row[i] = "NULL"
			if v.Valid {
				row[i] = v.String
			}
		}
		result = append(result, row)
	}
	if err := rows.Err(); err != nil {
		t.Fatalf("%s: %v", strings.TrimSpace(query), err)
	}
	return result
}

// table writes rows one per line, with " | " between the values.
func table(rows [][]string) string {
	var b strings.Builder
	for _, row := range rows {
		b.WriteString("    ")
		b.WriteString(strings.Join(row, " | "))
		b.WriteString("\n")
	}
	if len(rows) == 0 {
		b.WriteString("    (no rows)\n")
	}
	return b.String()
}
