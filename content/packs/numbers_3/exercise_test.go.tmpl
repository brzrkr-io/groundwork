package numbers

import "testing"

func TestRequestsPerDay(t *testing.T) {
	if got := RequestsPerDay(1); got != 86400 {
		t.Errorf(`RequestsPerDay(1) = %d, want 86400`, got)
	}

	if got := RequestsPerDay(10); got != 864000 {
		t.Errorf(`RequestsPerDay(10) = %d, want 864000`, got)
	}
}

func TestNodesNeeded(t *testing.T) {
	if got := NodesNeeded(10, 500, 2000); got != 3 {
		t.Errorf(`NodesNeeded(10, 500, 2000) = %d, want 3`, got)
	}

	if got := NodesNeeded(4, 500, 2000); got != 1 {
		t.Errorf(`NodesNeeded(4, 500, 2000) = %d, want 1`, got)
	}

	if got := NodesNeeded(3, 1500, 4000); got != 2 {
		t.Errorf(`NodesNeeded(3, 1500, 4000) = %d, want 2`, got)
	}

	if got := NodesNeeded(0, 500, 2000); got != 0 {
		t.Errorf(`NodesNeeded(0, 500, 2000) = %d, want 0`, got)
	}
}

func TestMonthlyCost(t *testing.T) {
	if got := MonthlyCost(0.125, 4); got != 365 {
		t.Errorf(`MonthlyCost(0.125, 4) = %v, want 365`, got)
	}

	if got := MonthlyCost(0.5, 2); got != 730 {
		t.Errorf(`MonthlyCost(0.5, 2) = %v, want 730`, got)
	}

	if got := MonthlyCost(0.0625, 1); got != 45.625 {
		t.Errorf(`MonthlyCost(0.0625, 1) = %v, want 45.625`, got)
	}
}
