package server

import (
	"net/http"
)

// statusRecorder wraps a ResponseWriter and remembers the status code the
// handler sent. A handler that never calls WriteHeader sends 200.
type statusRecorder struct {
	http.ResponseWriter
	status int
}

// WriteHeader records code, then sends it on.
func (rec *statusRecorder) WriteHeader(code int) {
	rec.status = code
	rec.ResponseWriter.WriteHeader(code)
}

// Unwrap returns the wrapped ResponseWriter, so http.ResponseController can
// still reach features like Flush through the recorder.
func (rec *statusRecorder) Unwrap() http.ResponseWriter {
	return rec.ResponseWriter
}

// observe serves each request through next, then counts it in s.metrics
// and writes one access log line with s.logger.
func (s *Server) observe(next http.Handler) http.Handler {
	// TODO(5): Return a handler that records the status, serves the request
	// through next, then counts and logs it.
	return next
}
