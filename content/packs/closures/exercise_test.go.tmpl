package closures

import "testing"

func TestNewThresholdChecker(t *testing.T) {
	atEighty := NewThresholdChecker(80)
	if atEighty(79) {
		t.Errorf("NewThresholdChecker(80)(79) = true, want false")
	}
	if !atEighty(80) {
		t.Errorf("NewThresholdChecker(80)(80) = false, want true")
	}
	if !atEighty(95) {
		t.Errorf("NewThresholdChecker(80)(95) = false, want true")
	}

	atFive := NewThresholdChecker(5)
	if atFive(4) {
		t.Errorf("NewThresholdChecker(5)(4) = true, want false")
	}
	if !atFive(5) {
		t.Errorf("NewThresholdChecker(5)(5) = false, want true")
	}
}

func TestNewRequestCounter(t *testing.T) {
	// A counter counts up from 1.
	count := NewRequestCounter()
	if got := count(); got != 1 {
		t.Errorf("first count() = %d, want 1", got)
	}
	if got := count(); got != 2 {
		t.Errorf("second count() = %d, want 2", got)
	}
	if got := count(); got != 3 {
		t.Errorf("third count() = %d, want 3", got)
	}

	// Two counters don't share their count.
	api := NewRequestCounter()
	web := NewRequestCounter()
	api()
	api()
	if got := web(); got != 1 {
		t.Errorf("first web() after two api() calls = %d, want 1", got)
	}
	if got := api(); got != 3 {
		t.Errorf("third api() = %d, want 3", got)
	}
}

func TestRetry(t *testing.T) {
	// try counts its calls and returns true on attempt number succeedsOn.
	// Before each check we reset calls and pick a new succeedsOn.
	calls := 0
	succeedsOn := 0
	try := func(attempt int) bool {
		calls++
		if attempt != calls {
			t.Errorf("call %d got attempt %d, want %d", calls, attempt, calls)
		}
		return attempt == succeedsOn
	}

	calls = 0
	succeedsOn = 1
	if got := Retry(5, try); got != 1 {
		t.Errorf("Retry(5, succeeds on 1) = %d, want 1", got)
	}
	if calls != 1 {
		t.Errorf("Retry(5, succeeds on 1) called try %d times, want 1", calls)
	}

	calls = 0
	succeedsOn = 3
	if got := Retry(5, try); got != 3 {
		t.Errorf("Retry(5, succeeds on 3) = %d, want 3", got)
	}
	if calls != 3 {
		t.Errorf("Retry(5, succeeds on 3) called try %d times, want 3", calls)
	}

	calls = 0
	succeedsOn = 4
	if got := Retry(4, try); got != 4 {
		t.Errorf("Retry(4, succeeds on 4) = %d, want 4", got)
	}
	if calls != 4 {
		t.Errorf("Retry(4, succeeds on 4) called try %d times, want 4", calls)
	}

	// When try never succeeds, Retry uses every attempt and returns 0.
	calls = 0
	succeedsOn = 3
	if got := Retry(2, try); got != 0 {
		t.Errorf("Retry(2, succeeds on 3) = %d, want 0", got)
	}
	if calls != 2 {
		t.Errorf("Retry(2, succeeds on 3) called try %d times, want 2", calls)
	}

	calls = 0
	succeedsOn = 1
	if got := Retry(0, try); got != 0 {
		t.Errorf("Retry(0, succeeds on 1) = %d, want 0", got)
	}
	if calls != 0 {
		t.Errorf("Retry(0, succeeds on 1) called try %d times, want 0", calls)
	}
}
