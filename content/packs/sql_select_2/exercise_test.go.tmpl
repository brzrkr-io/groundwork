package sqlselect

import (
	"database/sql"
	"os"
	"slices"
	"strings"
	"testing"

	_ "modernc.org/sqlite" // the SQLite driver, registered as "sqlite"
)

func TestStagingDeploys(t *testing.T) {
	got := runQuery(t, "1_staging_deploys.sql")
	want := [][]string{
		{"api", "v1.4.0"},
		{"checkout", "v2.7.1"},
		{"search", "v3.1.0"},
		{"search", "v3.1.1"},
		{"api", "v1.5.0-rc.1"},
		{"billing", "v1.0.0"},
		{"search", "v3.2.0"},
		{"billing", "v1.1.0-rc.1"},
	}
	checkRowsAnyOrder(t, "1_staging_deploys.sql", got, want)
}

func TestProductionProblems(t *testing.T) {
	got := runQuery(t, "2_production_problems.sql")
	want := [][]string{
		{"4", "checkout", "failed"},
		{"11", "billing", "rolled_back"},
		{"14", "checkout", "failed"},
	}
	checkRowsAnyOrder(t, "2_production_problems.sql", got, want)
}

func TestReleaseCandidates(t *testing.T) {
	got := runQuery(t, "3_release_candidates.sql")
	want := [][]string{
		{"api", "v1.5.0-rc.1"},
		{"billing", "v1.1.0-rc.1"},
