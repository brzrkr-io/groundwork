package functions

import (
	"math"
	"testing"
)

// Float results can be slightly off, so each check accepts any answer within
// 0.05 of the expected value and prints it with one decimal place (%.1f).

func TestAllowedDowntimeMinutes(t *testing.T) {
	if got := AllowedDowntimeMinutes(99.9, 30); math.Abs(got-43.2) >= 0.05 {
		t.Errorf("AllowedDowntimeMinutes(99.9, 30) = %.1f, want 43.2", got)
	}
	if got := AllowedDowntimeMinutes(99.0, 7); math.Abs(got-100.8) >= 0.05 {
		t.Errorf("AllowedDowntimeMinutes(99.0, 7) = %.1f, want 100.8", got)
	}
	if got := AllowedDowntimeMinutes(99.5, 1); math.Abs(got-7.2) >= 0.05 {
		t.Errorf("AllowedDowntimeMinutes(99.5, 1) = %.1f, want 7.2", got)
	}
}

func TestRemainingBudget(t *testing.T) {
	if got := RemainingBudget(99.9, 30, 30); math.Abs(got-13.2) >= 0.05 {
		t.Errorf("RemainingBudget(99.9, 30, 30) = %.1f, want 13.2", got)
	}
	if got := RemainingBudget(99.9, 30, 50); math.Abs(got-(-6.8)) >= 0.05 {
		t.Errorf("RemainingBudget(99.9, 30, 50) = %.1f, want -6.8", got)
	}
	if got := RemainingBudget(99.0, 7, 0.8); math.Abs(got-100.0) >= 0.05 {
		t.Errorf("RemainingBudget(99.0, 7, 0.8) = %.1f, want 100.0", got)
	}
}

func TestBudgetReport(t *testing.T) {
	if got := BudgetReport("api", 99.9, 30, 30); got != "api: 13.2 of 43.2 minutes left" {
		t.Errorf(`BudgetReport("api", 99.9, 30, 30) = %q, want "api: 13.2 of 43.2 minutes left"`, got)
	}
	if got := BudgetReport("web", 99.0, 7, 0); got != "web: 100.8 of 100.8 minutes left" {
		t.Errorf(`BudgetReport("web", 99.0, 7, 0) = %q, want "web: 100.8 of 100.8 minutes left"`, got)
	}
	if got := BudgetReport("api", 99.9, 30, 50); got != "api: budget exceeded by 6.8 minutes" {
		t.Errorf(`BudgetReport("api", 99.9, 30, 50) = %q, want "api: budget exceeded by 6.8 minutes"`, got)
	}
	if got := BudgetReport("db", 99.5, 1, 10); got != "db: budget exceeded by 2.8 minutes" {
		t.Errorf(`BudgetReport("db", 99.5, 1, 10) = %q, want "db: budget exceeded by 2.8 minutes"`, got)
	}
}
