// Package toolrun is the Groundwork exercise "Running commands: stdin, stderr and PATH lookups".
package toolrun

import (
	"os/exec"
	"strings"
)

// RolloutStatus runs "kubectl rollout status deployment/<deployment>" with
// KUBECONFIG set to kubeconfig, and returns kubectl's trimmed stdout. An empty
// namespace leaves out the -n flag, so kubectl uses its default namespace.
func RolloutStatus(kubectl, kubeconfig, namespace, deployment string) (string, error) {
	args := []string{"rollout", "status", "deployment/" + deployment}
	if namespace != "" {
		// TODO(1): Bug: kubectl receives "-n kube-system" as ONE argument.
		args = append(args, "-n "+namespace)
	}
	cmd := exec.Command(kubectl, args...)
	// TODO(1): Bug: kubectl loses PATH, HOME and every other variable.
	cmd.Env = []string{"KUBECONFIG=" + kubeconfig}
	out, err := cmd.Output()
	return strings.TrimSpace(string(out)), err
}

// Apply runs "kubectl apply -f -", feeding manifest to kubectl's stdin, and
// returns exactly what kubectl wrote to stdout and to stderr.
func Apply(kubectl, manifest string) (stdout, stderr string, err error) {
	cmd := exec.Command(kubectl, "apply", "-f", "-")
	// TODO(2): Feed manifest to cmd.Stdin, and collect cmd.Stdout and
	// cmd.Stderr in two separate bytes.Buffers. (Add "bytes" to the imports.)
	err = cmd.Run()
	// TODO(2): Return what the two buffers collected.
	return "", "", err
}

