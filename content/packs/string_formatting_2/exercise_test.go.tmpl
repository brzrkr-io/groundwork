package formatting

import "testing"

func TestScaleMessage(t *testing.T) {
	if got := ScaleMessage("api", 2, 5); got != "scaling api from 2 to 5 replicas" {
		t.Errorf(`ScaleMessage("api", 2, 5) = %q, want "scaling api from 2 to 5 replicas"`, got)
	}

	if got := ScaleMessage("worker", 10, 4); got != "scaling worker from 10 to 4 replicas" {
		t.Errorf(`ScaleMessage("worker", 10, 4) = %q, want "scaling worker from 10 to 4 replicas"`, got)
	}
}

func TestLogLine(t *testing.T) {
	if got := LogLine("info", "deploy finished", 1530); got != `level=info msg="deploy finished" duration_ms=1530` {
		t.Errorf(`LogLine("info", "deploy finished", 1530) = %q, want "level=info msg=\"deploy finished\" duration_ms=1530"`, got)
	}

	if got := LogLine("error", "health check failed", 87); got != `level=error msg="health check failed" duration_ms=87` {
		t.Errorf(`LogLine("error", "health check failed", 87) = %q, want "level=error msg=\"health check failed\" duration_ms=87"`, got)
	}
}

func TestIncidentID(t *testing.T) {
	if got := IncidentID(42); got != "INC-00042" {
		t.Errorf(`IncidentID(42) = %q, want "INC-00042"`, got)
	}

	if got := IncidentID(7); got != "INC-00007" {
		t.Errorf(`IncidentID(7) = %q, want "INC-00007"`, got)
	}

	if got := IncidentID(123456); got != "INC-123456" {
		t.Errorf(`IncidentID(123456) = %q, want "INC-123456"`, got)
	}
}
