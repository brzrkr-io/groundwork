// Package services is the Groundwork exercise "Benchmarks: sub-benchmarks and preallocation".
package services

// Service is one entry in the deploy manifest.
type Service struct {
	Name string
	Port int
}

// Ports returns the port of every service, in the same order as svcs. The
// load balancer config is generated from this list.
//
//	Ports([]Service{{Name: "api", Port: 8080}, {Name: "web", Port: 443}})
//	// => [8080 443]
func Ports(svcs []Service) []int {
	return ports(svcs)
}

// ports points at the real implementation. Groundwork' grader swaps in
// broken versions to check that your benchmark catches them.
var ports = realPorts

// TODO(2): Make the slice with room for every port up front, so that append
// never has to grow it.
func realPorts(svcs []Service) []int {
	var out []int
	for _, s := range svcs {
		out = append(out, s.Port)
	}
	return out
}
