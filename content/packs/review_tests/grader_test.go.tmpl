// learnerTests selects the tests you write in exercise_test.go.
const learnerTests = "^TestExpired$"

// mutate installs a version of Expired that answers bug(b, age) when it
// returns true, and the real answer otherwise.
func mutate(bug func(b Backup, age time.Duration) (answer, buggy bool)) func() {
	return func() {
		expired = func(b Backup, now time.Time) bool {
			if answer, buggy := bug(b, now.Sub(b.Taken)); buggy {
				return answer
			}
			return realExpired(b, now)
		}
	}
}

// mutants are the bugs your tests must catch.
var mutants = []mutant{
