// Package receivers is the Groundwork exercise "Pointer receivers".
package receivers

// Counter counts requests that hit the load balancer.
type Counter struct {
	Count int
}

// Inc adds one to the counter.
// TODO(1): Give Inc a pointer receiver so the change sticks.
func (c Counter) Inc() {
	c.Count++
}

// Reset sets the counter back to zero.
// TODO(1): Give Reset a pointer receiver so the change sticks.
func (c Counter) Reset() {
	c.Count = 0
}

