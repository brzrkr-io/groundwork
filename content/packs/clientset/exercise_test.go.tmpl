// deployment builds a Deployment with one container per image.
func deployment(namespace, name string, images ...string) *appsv1.Deployment {
	d := &appsv1.Deployment{
		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace},
	}
	for i, image := range images {
		c := corev1.Container{Name: fmt.Sprintf("container-%d", i), Image: image}
		d.Spec.Template.Spec.Containers = append(d.Spec.Template.Spec.Containers, c)
	}
	return d
}

func TestDeploymentImage(t *testing.T) {
	ctx := context.Background()
	cs := fake.NewClientset(
		deployment("shop", "web", "registry.example.com/shop/web:2.0.1"),
		deployment("payments", "checkout", "registry.example.com/payments/checkout:1.4.2", "registry.example.com/tools/log-shipper:0.9"),
	)

	tests := []struct {
		namespace, name string
		want            string
	}{
		{"shop", "web", "registry.example.com/shop/web:2.0.1"},
		{"payments", "checkout", "registry.example.com/payments/checkout:1.4.2"},
	}
	for _, tt := range tests {
		t.Run(tt.namespace+"/"+tt.name, func(t *testing.T) {
			got, err := DeploymentImage(ctx, cs, tt.namespace, tt.name)
			if err != nil || got != tt.want {
				t.Errorf("DeploymentImage(%q, %q) = %q, %v, want %q, nil", tt.namespace, tt.name, got, err, tt.want)
			}
		})
	}

	t.Run("missing deployment", func(t *testing.T) {
		for _, name := range []string{"api", "worker"} {
			_, err := DeploymentImage(ctx, cs, "shop", name)
			if !apierrors.IsNotFound(err) {
				t.Errorf("DeploymentImage(%q, %q) error = %v, want a NotFound error", "shop", name, err)
			}
		}
	})

	t.Run("no containers", func(t *testing.T) {
		cs := fake.NewClientset(deployment("shop", "empty"), deployment("staging", "blank"))
		for _, d := range []struct{ namespace, name, want string }{
			{"shop", "empty", "deployment shop/empty has no containers"},
			{"staging", "blank", "deployment staging/blank has no containers"},
		} {
			got, err := DeploymentImage(ctx, cs, d.namespace, d.name)
			if err == nil || err.Error() != d.want {
				t.Errorf("DeploymentImage(%q, %q) = %q, %v, want error %q", d.namespace, d.name, got, err, d.want)
			}
		}
	})
}

func TestCreateConfigMap(t *testing.T) {
	ctx := context.Background()

	tests := []struct {
		namespace, name string
		data            map[string]string
	}{
		{"shop", "feature-flags", map[string]string{"checkout_v2": "true"}},
		{"monitoring", "scrape-config", map[string]string{"interval": "30s", "timeout": "10s"}},
	}
	for _, tt := range tests {
		t.Run(tt.namespace+"/"+tt.name, func(t *testing.T) {
			cs := fake.NewClientset()
			got, err := CreateConfigMap(ctx, cs, tt.namespace, tt.name, tt.data)
			if err != nil {
				t.Fatalf("CreateConfigMap(%q, %q, %v) error = %v, want nil", tt.namespace, tt.name, tt.data, err)
			}
			if got.Name != tt.name || !maps.Equal(got.Data, tt.data) {
				t.Errorf("CreateConfigMap(%q, %q, %v) returned name %q, data %v, want name %q, data %v",
					tt.namespace, tt.name, tt.data, got.Name, got.Data, tt.name, tt.data)
			}

			// Ask the fake API server whether the ConfigMap really exists now.
			stored, err := cs.CoreV1().ConfigMaps(tt.namespace).Get(ctx, tt.name, metav1.GetOptions{})
			if err != nil {
				t.Fatalf("after CreateConfigMap, Get(%q, %q) error = %v, want the ConfigMap to exist", tt.namespace, tt.name, err)
			}
			if !maps.Equal(stored.Data, tt.data) {
				t.Errorf("stored ConfigMap %s/%s data = %v, want %v", tt.namespace, tt.name, stored.Data, tt.data)
			}
		})
	}

	t.Run("already exists", func(t *testing.T) {
		cs := fake.NewClientset(
			&corev1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Name: "feature-flags", Namespace: "shop"}},
			&corev1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Name: "scrape-config", Namespace: "monitoring"}},
		)
		for _, tt := range tests {
			_, err := CreateConfigMap(ctx, cs, tt.namespace, tt.name, tt.data)
			if err == nil {
				t.Errorf("CreateConfigMap(%q, %q, %v) error = nil, want an error because it already exists", tt.namespace, tt.name, tt.data)
			}
		}
	})
}

func TestDeleteDeploymentIfExists(t *testing.T) {
	ctx := context.Background()

	t.Run("exists", func(t *testing.T) {
		cs := fake.NewClientset(deployment("shop", "web", "nginx:1.27"), deployment("staging", "worker", "busybox:1.36"))
		for _, d := range []struct{ namespace, name string }{{"shop", "web"}, {"staging", "worker"}} {
			deleted, err := DeleteDeploymentIfExists(ctx, cs, d.namespace, d.name)
			if !deleted || err != nil {
				t.Errorf("DeleteDeploymentIfExists(%q, %q) = %v, %v, want true, nil", d.namespace, d.name, deleted, err)
			}
			_, err = cs.AppsV1().Deployments(d.namespace).Get(ctx, d.name, metav1.GetOptions{})
			if !apierrors.IsNotFound(err) {
				t.Errorf("after DeleteDeploymentIfExists(%q, %q), the Deployment still exists", d.namespace, d.name)
			}
		}
	})

	t.Run("missing", func(t *testing.T) {
		cs := fake.NewClientset()
		for _, d := range []struct{ namespace, name string }{{"shop", "web"}, {"payments", "checkout"}} {
			deleted, err := DeleteDeploymentIfExists(ctx, cs, d.namespace, d.name)
			if deleted || err != nil {
				t.Errorf("DeleteDeploymentIfExists(%q, %q) = %v, %v, want false, nil", d.namespace, d.name, deleted, err)
			}
		}
	})

	t.Run("other errors", func(t *testing.T) {
		cs := fake.NewClientset(deployment("shop", "web", "nginx:1.27"))
		// PrependReactor makes the fake fail every Deployment delete, as if
		// the API server were unreachable.
		cs.PrependReactor("delete", "deployments", func(k8stesting.Action) (bool, runtime.Object, error) {
			return true, nil, errors.New("connection refused")
		})
		for _, name := range []string{"web", "api"} {
			deleted, err := DeleteDeploymentIfExists(ctx, cs, "shop", name)
			if deleted || err == nil {
				t.Errorf("DeleteDeploymentIfExists(%q, %q) = %v, %v, want false, an error", "shop", name, deleted, err)
			}
		}
	})
}
