package hosts

// This file is how Groundwork grades the test you write. You don't need to
// change it, but you are welcome to read it.
//
// TestGrader re-runs your tests against the real code, where they must pass,
// and then against each mutant below, where they must fail. A mutant is a
// copy of the code with one deliberate bug.

import (
	"os"
	"os/exec"
	"strings"
	"testing"
)

// learnerTests selects the tests you write in exercise_test.go.
const learnerTests = "^TestParseHosts$"

// mutants are the bugs your tests must catch.
var mutants = []mutant{
	{
		name: "drops_last_host",
		bug:  `ParseHosts dropped the last host in the list`,
		install: func() {
			parseHosts = func(text string) []string {
				hosts := realParseHosts(text)
				if len(hosts) == 0 {
					return hosts
				}
				return hosts[:len(hosts)-1]
			}
		},
	},
	{
		name: "keeps_comments",
		bug:  `ParseHosts returned comment lines such as "# web tier" as hosts`,
		install: func() {
			parseHosts = func(text string) []string {
				var hosts []string
				for line := range strings.SplitSeq(text, "\n") {
					line = strings.TrimSpace(line)
					if line == "" {
						continue
					}
					hosts = append(hosts, line)
				}
				return hosts
			}
		},
	},
	{
		name: "keeps_blank_lines",
		bug:  `ParseHosts returned blank lines as empty hosts`,
		install: func() {
			parseHosts = func(text string) []string {
				var hosts []string
				for line := range strings.SplitSeq(text, "\n") {
					line = strings.TrimSpace(line)
					if strings.HasPrefix(line, "#") {
						continue
					}
					hosts = append(hosts, line)
				}
				return hosts
			}
		},
	},
	{
		name: "keeps_spaces",
		bug:  `ParseHosts kept the spaces around "  web-1  "`,
		install: func() {
			parseHosts = func(text string) []string {
				var hosts []string
				for line := range strings.SplitSeq(text, "\n") {
					trimmed := strings.TrimSpace(line)
					if trimmed == "" || strings.HasPrefix(trimmed, "#") {
						continue
					}
					hosts = append(hosts, line)
				}
				return hosts
			}
		},
	},
}

// Everything below is the same in every Testing exercise.

// mutantEnv names the environment variable that tells a re-run which mutant
// to install.
const mutantEnv = "GROUNDWORK_MUTANT"

type mutant struct {
	name    string // short name, used in GROUNDWORK_MUTANT and test output
	bug     string // completes "your tests didn't notice when ..."
	install func() // swaps the bug into the package
}

// TestMain runs before any test. In a re-run started by TestGrader, it
// installs the mutant named by GROUNDWORK_MUTANT.
func TestMain(m *testing.M) {
	if name := os.Getenv(mutantEnv); name != "" {
		for _, mu := range mutants {
			if mu.name == name {
				mu.install()
			}
		}
	}
	os.Exit(m.Run())
}

func TestGrader(t *testing.T) {
	if _, rerun := os.LookupEnv(mutantEnv); rerun {
		t.Skip("TestGrader does not run inside its own re-runs")
	}
	out, err := runLearnerTests("")
	if strings.Contains(out, "no tests to run") {
		t.Fatalf("found no test matching %s in exercise_test.go", learnerTests)
	}
	if err != nil {
		t.Fatalf("your tests must pass on the real code first, but they failed:\n%s", out)
	}
	for _, mu := range mutants {
		t.Run(mu.name, func(t *testing.T) {
			if _, err := runLearnerTests(mu.name); err == nil {
				t.Errorf("your tests didn't notice when %s", mu.bug)
			}
		})
	}
}

// runLearnerTests re-runs this test binary with only your tests selected and
// the named mutant installed. An empty name means the real code.
func runLearnerTests(mutant string) (string, error) {
	cmd := exec.Command(os.Args[0], "-test.run="+learnerTests)
	cmd.Env = append(os.Environ(), mutantEnv+"="+mutant)
	out, err := cmd.CombinedOutput()
	return string(out), err
}
