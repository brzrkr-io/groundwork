package numbers

import "testing"

func TestShard(t *testing.T) {
	if got := Shard(17, 5); got != 2 {
		t.Errorf(`Shard(17, 5) = %d, want 2`, got)
	}

	if got := Shard(10, 5); got != 0 {
		t.Errorf(`Shard(10, 5) = %d, want 0`, got)
	}

	if got := Shard(3, 8); got != 3 {
		t.Errorf(`Shard(3, 8) = %d, want 3`, got)
	}
}

func TestErrorRatePercent(t *testing.T) {
	if got := ErrorRatePercent(5, 200); got != 2 {
		t.Errorf(`ErrorRatePercent(5, 200) = %d, want 2`, got)
	}

	if got := ErrorRatePercent(50, 200); got != 25 {
		t.Errorf(`ErrorRatePercent(50, 200) = %d, want 25`, got)
	}

	if got := ErrorRatePercent(1, 3); got != 33 {
		t.Errorf(`ErrorRatePercent(1, 3) = %d, want 33`, got)
	}

	if got := ErrorRatePercent(0, 100); got != 0 {
		t.Errorf(`ErrorRatePercent(0, 100) = %d, want 0`, got)
	}
}

func TestDiskFreePercent(t *testing.T) {
	if got := DiskFreePercent(200, 150); got != 25 {
		t.Errorf(`DiskFreePercent(200, 150) = %v, want 25`, got)
	}

	if got := DiskFreePercent(64, 16); got != 75 {
		t.Errorf(`DiskFreePercent(64, 16) = %v, want 75`, got)
	}

	if got := DiskFreePercent(100, 0); got != 100 {
		t.Errorf(`DiskFreePercent(100, 0) = %v, want 100`, got)
	}
}
