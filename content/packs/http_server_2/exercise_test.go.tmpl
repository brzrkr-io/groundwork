package httpserver

import (
	"fmt"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

// testStore returns a store where "api" has 12 log lines ("api line 1" is
// the oldest, "api line 12" the newest) and "worker" has 3.
func testStore() LogStore {
	var api []string
	for i := range 12 {
		api = append(api, fmt.Sprintf("api line %d", i+1))
	}
	return LogStore{
		"api":    api,
		"worker": {"worker line 1", "worker line 2", "worker line 3"},
	}
}

// wantLines returns the body for lines first..last of a service.
func wantLines(service string, first, last int) string {
	var b strings.Builder
	for i := first; i <= last; i++ {
		fmt.Fprintf(&b, "%s line %d\n", service, i)
	}
	return b.String()
}

// getLogs calls ServeLogs directly, filling in {service} the way the mux would.
func getLogs(service, query string) *httptest.ResponseRecorder {
	req := httptest.NewRequest("GET", "/logs/"+service+query, nil)
	req.SetPathValue("service", service)
	rec := httptest.NewRecorder()
	testStore().ServeLogs(rec, req)
	return rec
}

func TestRoutes(t *testing.T) {
	mux := NewMux(testStore())
	tests := []struct {
		method   string
		path     string
		wantCode int
	}{
		{"GET", "/", http.StatusOK},
		{"GET", "/logs/api", http.StatusOK},
		{"GET", "/nope", http.StatusNotFound},
		{"GET", "/logs", http.StatusNotFound},
		{"POST", "/logs/api", http.StatusMethodNotAllowed},
		{"DELETE", "/logs/worker", http.StatusMethodNotAllowed},
	}
	for _, tt := range tests {
		t.Run(tt.method+" "+tt.path, func(t *testing.T) {
			req := httptest.NewRequest(tt.method, tt.path, nil)
			rec := httptest.NewRecorder()
			mux.ServeHTTP(rec, req)
			if rec.Code != tt.wantCode {
				t.Errorf("%s %s: status = %d, want %d", tt.method, tt.path, rec.Code, tt.wantCode)
			}
		})
	}
}

func TestNewestLines(t *testing.T) {
	tests := []struct {
		service  string
		wantBody string
	}{
		{"api", wantLines("api", 3, 12)},
		{"worker", wantLines("worker", 1, 3)},
	}
	for _, tt := range tests {
		t.Run(tt.service, func(t *testing.T) {
			rec := getLogs(tt.service, "")
			if rec.Code != http.StatusOK {
				t.Errorf("GET /logs/%s: status = %d, want %d", tt.service, rec.Code, http.StatusOK)
			}
			if got := rec.Body.String(); got != tt.wantBody {
				t.Errorf("GET /logs/%s: body = %q, want %q", tt.service, got, tt.wantBody)
			}
		})
	}
}

func TestLimit(t *testing.T) {
	badLimit := "limit must be a number from 1 to 100\n"
	tests := []struct {
		query    string
		wantCode int
		wantBody string
	}{
		{"?limit=3", http.StatusOK, wantLines("api", 10, 12)},
		{"?limit=1", http.StatusOK, wantLines("api", 12, 12)},
		{"?limit=100", http.StatusOK, wantLines("api", 1, 12)},
		{"?limit=abc", http.StatusBadRequest, badLimit},
		{"?limit=0", http.StatusBadRequest, badLimit},
		{"?limit=101", http.StatusBadRequest, badLimit},
	}
	for _, tt := range tests {
		t.Run(tt.query, func(t *testing.T) {
			rec := getLogs("api", tt.query)
			if rec.Code != tt.wantCode {
				t.Errorf("GET /logs/api%s: status = %d, want %d", tt.query, rec.Code, tt.wantCode)
			}
			if got := rec.Body.String(); got != tt.wantBody {
				t.Errorf("GET /logs/api%s: body = %q, want %q", tt.query, got, tt.wantBody)
			}
		})
	}
}
