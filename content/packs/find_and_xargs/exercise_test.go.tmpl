func TestListLogs(t *testing.T) {
	want := "" +
		"sandbox/api/access.log\n" +
		"sandbox/api/error.log\n" +
		"sandbox/nginx/access.log\n" +
		"sandbox/worker/jobs/cron.log\n" +
		"sandbox/worker/old worker.log\n" +
		"sandbox/worker/worker.log\n"
	expect(t, build(t, "sandbox", sandbox), want, "1_list_logs.sh", "sandbox")

	want = "" +
		"srv/billing/billing.log\n" +
		"srv/gateway/debug trace.log\n" +
		"srv/gateway/gateway.log\n" +
		"srv/scheduler.log\n"
	expect(t, build(t, "srv", srv), want, "1_list_logs.sh", "srv")
}

