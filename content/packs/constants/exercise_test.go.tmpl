package constants

import "testing"

func TestSidecarPort(t *testing.T) {
	if got := SidecarPort(1); got != 8081 {
		t.Errorf(`SidecarPort(1) = %d, want 8081`, got)
	}

	if got := SidecarPort(2); got != 8082 {
		t.Errorf(`SidecarPort(2) = %d, want 8082`, got)
	}

	if got := SidecarPort(10); got != 8090 {
		t.Errorf(`SidecarPort(10) = %d, want 8090`, got)
	}

	if DefaultPort != 8080 {
		t.Errorf("DefaultPort = %d, want 8080", DefaultPort)
	}
}

func TestDNSName(t *testing.T) {
	if got := DNSName("cluster.local"); got != "checkout.payments.svc.cluster.local" {
		t.Errorf(`DNSName("cluster.local") = %q, want "checkout.payments.svc.cluster.local"`, got)
	}

	if got := DNSName("k8s.internal"); got != "checkout.payments.svc.k8s.internal" {
		t.Errorf(`DNSName("k8s.internal") = %q, want "checkout.payments.svc.k8s.internal"`, got)
	}
}

func TestSpareReplicas(t *testing.T) {
	if got := SpareReplicas(3); got != 7 {
		t.Errorf(`SpareReplicas(3) = %d, want 7`, got)
	}

	if got := SpareReplicas(10); got != 0 {
		t.Errorf(`SpareReplicas(10) = %d, want 0`, got)
	}

	if got := SpareReplicas(0); got != 10 {
		t.Errorf(`SpareReplicas(0) = %d, want 10`, got)
	}
}
