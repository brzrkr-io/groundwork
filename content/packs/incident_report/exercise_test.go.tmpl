func TestOpenIncidents(t *testing.T) {
	const file = "1_open_incidents.sql"
	got := runFile(t, newDB(t), file)
	checkColumns(t, file, got, "id", "service", "severity", "opened_at")
	checkRows(t, file, got, [][]string{
		{"7", "checkout", "sev1", "2026-03-06 10:05:00"},
		{"6", "api", "sev3", "2026-03-06 08:00:00"},
		{"8", "billing", "sev3", "2026-03-06 11:20:00"},
	})
}

