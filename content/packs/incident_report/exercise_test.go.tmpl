func TestCloseIncident(t *testing.T) {
	const file = "5_close_incident.sql"
	text := readSQL(t, file)
	for _, word := range []string{"BEGIN", "COMMIT"} {
		if !regexp.MustCompile(`(?i)\b` + word + `\b`).MatchString(text) {
			t.Errorf("%s has no %s: wrap both changes in BEGIN; ... COMMIT;", file, word)
		}
	}

	db := newDB(t)
	if _, err := db.Exec(text); err != nil {
		t.Fatalf("%s failed: %v", file, err)
	}
	incident := query(t, db, `SELECT id, resolved_at, minutes_to_resolve FROM incidents WHERE id = 7`)
	checkRows(t, "after "+file+", incident 7", incident, [][]string{{"7", "2026-03-06 11:02:00", "57"}})
	postmortem := query(t, db, `SELECT incident_id, author, published_at FROM postmortems WHERE incident_id = 7`)
	checkRows(t, "after "+file+", the postmortems for incident 7", postmortem, [][]string{{"7", "marco", "2026-03-09 10:00:00"}})

	// Now make the postmortem insert fail. The incident must stay open.
	db = newDB(t)
	if _, err := db.Exec(`CREATE TRIGGER broken BEFORE INSERT ON postmortems BEGIN SELECT RAISE(ABORT, 'disk I/O error'); END`); err != nil {
		t.Fatal(err)
	}
	if _, err := db.Exec(text); err == nil {
		t.Fatalf("%s succeeded although adding the postmortem failed; does it add the postmortem?", file)
	}
	db.Exec("ROLLBACK") // what an application does after an error; fails harmlessly outside a transaction
	if got := query(t, db, `SELECT resolved_at FROM incidents WHERE id = 7`); got.rows[0][0] != "NULL" {
		t.Errorf("when adding the postmortem fails, %s still resolves incident 7 at %s; in a transaction it would stay open", file, got.rows[0][0])
	}
}

// result is what a query returned: the column names, and the rows with every
// value written as text ("NULL" for a missing value).
type result struct {
	columns []string
	rows    [][]string
	// unstable is true when a second run of the query returned the same rows
	// in a different order.
	unstable bool
}

// newDB returns a fresh in-memory database loaded from testdata/schema.sql
// and testdata/data.sql.
func newDB(t *testing.T) *sql.DB {
	t.Helper()
	db, err := sql.Open("sqlite", ":memory:")
	if err != nil {
		t.Fatal(err)
	}
	// Every connection to ":memory:" gets its own empty database: use one.
	db.SetMaxOpenConns(1)
	t.Cleanup(func() { db.Close() })
	for _, fixture := range []string{"testdata/schema.sql", "testdata/data.sql"} {
		if _, err := db.Exec(readSQL(t, fixture)); err != nil {
			t.Fatalf("loading %s: %v", fixture, err)
		}
	}
	return db
}

// runFile runs the query in file and returns the result.
//
// Without ORDER BY, a database may return rows in any order. To catch a query
// that is in order only by luck, runFile runs it a second time with SQLite
// told to read tables backwards (PRAGMA reverse_unordered_selects).
func runFile(t *testing.T, db *sql.DB, file string) result {
	t.Helper()
	text := readSQL(t, file)
	rows, err := db.Query(text)
	if err != nil {
		t.Fatalf("%s failed: %v", file, err)
	}
	res := collect(t, rows)
	if _, err := db.Exec("PRAGMA reverse_unordered_selects = ON"); err != nil {
		t.Fatal(err)
	}
	res.unstable = !slices.EqualFunc(res.rows, query(t, db, text).rows, slices.Equal)
	return res
}

// query runs one of the test's own queries and returns the result.
func query(t *testing.T, db *sql.DB, text string) result {
	t.Helper()
	rows, err := db.Query(text)
	if err != nil {
		t.Fatalf("%s: %v", text, err)
	}
	return collect(t, rows)
}

// collect reads every row, writing each value as text ("NULL" for a
// missing value), and closes rows.
func collect(t *testing.T, rows *sql.Rows) result {
	t.Helper()
	defer rows.Close()
	columns, err := rows.Columns()
	if err != nil {
		t.Fatal(err)
	}
	res := result{columns: columns}
	for rows.Next() {
		values := make([]sql.NullString, len(columns))
		targets := make([]any, len(columns))
		for i := range values {
			targets[i] = &values[i]
		}
		if err := rows.Scan(targets...); err != nil {
			t.Fatalf("reading a row: %v", err)
		}
		row := make([]string, len(columns))
		for i, v := range values {
			row[i] = "NULL"
			if v.Valid {
				row[i] = v.String
			}
		}
		res.rows = append(res.rows, row)
	}
	if err := rows.Err(); err != nil {
		t.Fatalf("reading the rows: %v", err)
	}
	return res
}

// readSQL returns the contents of file without its "--" comment lines. It
// fails the test if nothing is left, because then there's nothing to run yet.
func readSQL(t *testing.T, file string) string {
	t.Helper()
	data, err := os.ReadFile(file)
	if err != nil {
		t.Fatal(err)
	}
	var b strings.Builder
	for line := range strings.Lines(string(data)) {
		if !strings.HasPrefix(strings.TrimSpace(line), "--") {
			b.WriteString(line)
		}
	}
	if strings.TrimSpace(b.String()) == "" {
		t.Fatalf("%s has no SQL yet: write it under the TODO", file)
	}
	return b.String()
}

// checkColumns compares the column names of got with want. Name a computed
// column with AS.
func checkColumns(t *testing.T, file string, got result, want ...string) {
	t.Helper()
	if !slices.Equal(got.columns, want) {
		t.Errorf("%s returned columns %s, want %s", file, strings.Join(got.columns, ", "), strings.Join(want, ", "))
	}
}

// unstableHint explains a result whose order changed between two runs.
const unstableHint = "The test ran your query twice, and the second time the rows came back in a different order.\n" +
	"Without ORDER BY (or with an ORDER BY that leaves ties), the database picks the order. Sort the rows as the task says."

// checkRows compares the rows of got with want, in order. what names the
// rows in the failure message.
func checkRows(t *testing.T, what string, got result, want [][]string) {
	t.Helper()
	if !slices.EqualFunc(got.rows, want, slices.Equal) {
		hint := ""
		if got.unstable {
			hint = "\n" + unstableHint
		}
		t.Errorf("%s: got %d rows (columns: %s):\n%s\nwant %d rows, in this order:\n%s%s",
			what, len(got.rows), strings.Join(got.columns, ", "), table(got.rows), len(want), table(want), hint)
		return
	}
	if got.unstable {
		t.Errorf("%s returned the right rows, but in this order only by luck.\n%s", what, unstableHint)
	}
}

// table writes rows one per line, with " | " between the values.
func table(rows [][]string) string {
	var b strings.Builder
	for _, row := range rows {
		b.WriteString("    ")
		b.WriteString(strings.Join(row, " | "))
		b.WriteString("\n")
	}
	if len(rows) == 0 {
		b.WriteString("    (no rows)\n")
	}
	return b.String()
}
