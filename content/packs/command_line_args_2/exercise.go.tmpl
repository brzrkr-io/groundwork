// Package waitport is the Groundwork exercise "Command-line arguments: fix the port waiter".
package waitport

import (
	"fmt"
	"io"
	"strconv"
)

// Run is the whole waitport tool: waitport HOST PORT [TIMEOUT_SECONDS].
// args is the full os.Args, so args[0] is the program name.
// It returns the exit code: 0 for success, 2 for a usage error.
func Run(args []string, stdout, stderr io.Writer) int {
	prog := args[0]

	if len(args) < 3 || len(args) > 4 {
		// TODO(2): Usage errors belong on stderr with exit code 2.
		fmt.Fprintf(stdout, "usage: %s HOST PORT [TIMEOUT_SECONDS]\n", prog)
		return 1
	}

	// TODO(1): args[0] is the program name, not HOST. Fix every index below.
	host := args[0]
	port, err := strconv.Atoi(args[1])
	if err != nil || port < 1 || port > 65535 {
		fmt.Fprintf(stderr, "%s: port must be 1-65535, got %q\n", prog, args[1])
		return 2
	}

	// TODO(3): Default to 30 seconds. Don't ignore the conversion error,
	// and reject timeouts below 1.
	timeout := 0
	if len(args) == 4 {
		timeout, _ = strconv.Atoi(args[2])
	}

	fmt.Fprintf(stdout, "waiting up to %ds for %s:%d\n", timeout, host, port)
	return 0
}
