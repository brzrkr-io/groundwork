package zones

import (
	"fmt"
	"testing"
)

func TestWeeklyTotal(t *testing.T) {
	cases := []struct {
		daily [7]int
		want  int
	}{
		{[7]int{3, 0, 1, 4, 0, 0, 2}, 10},
		{[7]int{1, 1, 1, 1, 1, 1, 1}, 7},
		{[7]int{0, 0, 0, 0, 0, 0, 50}, 50},
		{[7]int{}, 0},
	}
	for _, c := range cases {
		t.Run(fmt.Sprint(c.daily), func(t *testing.T) {
			if got := WeeklyTotal(c.daily); got != c.want {
				t.Errorf("WeeklyTotal(%v) = %d, want %d", c.daily, got, c.want)
			}
		})
	}
}

func TestZoneNames(t *testing.T) {
	cases := []struct {
		region string
		want   [3]string
	}{
		{"eu-west-1", [3]string{"eu-west-1a", "eu-west-1b", "eu-west-1c"}},
		{"us-east-2", [3]string{"us-east-2a", "us-east-2b", "us-east-2c"}},
		{"ap-south-1", [3]string{"ap-south-1a", "ap-south-1b", "ap-south-1c"}},
	}
	for _, c := range cases {
		t.Run(c.region, func(t *testing.T) {
			// Arrays can be compared with == and !=.
			if got := ZoneNames(c.region); got != c.want {
				t.Errorf("ZoneNames(%q) = %q, want %q", c.region, got, c.want)
			}
		})
	}
}

func TestWithZoneDown(t *testing.T) {
	cases := []struct {
		status [3]bool
		zone   int
		want   [3]bool
	}{
		{[3]bool{true, true, true}, 1, [3]bool{true, false, true}},
		{[3]bool{true, true, true}, 0, [3]bool{false, true, true}},
		{[3]bool{true, false, true}, 2, [3]bool{true, false, false}},
		{[3]bool{false, true, true}, 0, [3]bool{false, true, true}},
	}
	for _, c := range cases {
		t.Run(fmt.Sprintf("%v_zone_%d", c.status, c.zone), func(t *testing.T) {
			before := c.status
			if got := WithZoneDown(c.status, c.zone); got != c.want {
				t.Errorf("WithZoneDown(%v, %d) = %v, want %v", c.status, c.zone, got, c.want)
			}
			// The function got a copy, so the caller's array must not change.
			if c.status != before {
				t.Errorf("WithZoneDown changed the caller's array to %v, want it unchanged %v", c.status, before)
			}
		})
	}
}
