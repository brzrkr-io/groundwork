// Package retry is the Groundwork exercise "Fakes: a fake clock for retries".
package retry

import (
	"fmt"
	"time"
)

// Sleeper pauses for a while. Retry sleeps through a Sleeper so that tests
// can pass in a fake one that doesn't really wait.
type Sleeper interface {
	Sleep(d time.Duration)
}

// RealSleeper is the Sleeper to use in production. It really waits.
type RealSleeper struct{}

// Sleep pauses the program for d by calling time.Sleep.
func (RealSleeper) Sleep(d time.Duration) {
	time.Sleep(d)
}

// Retry calls fn up to attempts times (attempts must be at least 1) and
// returns nil as soon as fn returns nil. Between attempts it sleeps through
// s: 1s after the first failure, then 2s, then 4s, doubling each time. It
// does not sleep after the last attempt. If every attempt fails, it returns
// fn's last error wrapped as "gave up after <attempts> attempts: <last error>".
//
// This code is correct. Your job in this exercise is to write tests for it.
func Retry(s Sleeper, attempts int, fn func() error) error {
	return retry(s, attempts, fn)
}

// retry points at the real implementation. Groundwork's grader swaps in
// broken versions to check that your tests catch them.
var retry = realRetry

func realRetry(s Sleeper, attempts int, fn func() error) error {
	delay := time.Second
	var err error
	for i := 1; i <= attempts; i++ {
		err = fn()
		if err == nil {
			return nil
		}
		if i < attempts {
			s.Sleep(delay)
			delay *= 2
		}
	}
	return fmt.Errorf("gave up after %d attempts: %w", attempts, err)
}
