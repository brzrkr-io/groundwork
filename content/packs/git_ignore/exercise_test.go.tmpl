package gitignore

import (
	"bytes"
	"errors"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
)

// Each test builds a fresh sandbox with setup.sh, runs your scripts in
// task order up to the one it checks, then inspects the repo with git.
var scripts = []string{
	"1_ignore_build_output.sh",
	"2_untrack_secret.sh",
	"3_ignore_env_files.sh",
}

func TestIgnoreBuildOutput(t *testing.T) {
	repo, _ := runTasks(t, 1)
	checkIgnored(t, repo, "bin/web", true)
	checkIgnored(t, repo, "logs/deploy.log", true)
	checkIgnored(t, repo, "debug.log", true)
	checkIgnored(t, repo, "build.sh", false)
	if got := git(t, repo, "log", "-1", "--format=%s"); got != "Ignore build output and logs" {
		t.Errorf("newest commit message = %q, want \"Ignore build output and logs\"", got)
	}
	checkNewestCommitChanges(t, repo, ".gitignore")
	checkNeverCommitted(t, repo, "config/prod.env")
}

func TestUntrackSecret(t *testing.T) {
	repo, _ := runTasks(t, 2)
	if got := git(t, repo, "log", "-1", "--format=%s"); got != "Stop tracking .env" {
		t.Errorf("newest commit message = %q, want \"Stop tracking .env\"", got)
	}
	if got := git(t, repo, "ls-tree", "--name-only", "HEAD", ".env"); got != "" {
		t.Error(".env is still in the newest commit, want it untracked")
	}
	if _, err := os.Stat(filepath.Join(repo, ".env")); err != nil {
		t.Error(".env is gone from the sandbox, want it kept on disk")
	}
	checkIgnored(t, repo, ".env", true)
	checkIgnored(t, repo, "bin/web", true)
	checkIgnored(t, repo, "debug.log", true)
	checkNewestCommitChanges(t, repo, ".env\n.gitignore")
	checkNeverCommitted(t, repo, "config/prod.env")
}

func TestIgnoreEnvFiles(t *testing.T) {
	repo, _ := runTasks(t, 3)
	if got := git(t, repo, "log", "-1", "--format=%s"); got != "Ignore env files except the example" {
		t.Errorf("newest commit message = %q, want \"Ignore env files except the example\"", got)
	}
	checkIgnored(t, repo, "config/prod.env", true)
	checkIgnored(t, repo, "config/example.env", false)
	checkIgnored(t, repo, ".env", true)
	checkIgnored(t, repo, "bin/web", true)
	if got := git(t, repo, "ls-tree", "--name-only", "HEAD", "config/example.env"); got != "config/example.env" {
		t.Error("config/example.env is not in the newest commit, want it still tracked")
	}
	checkNewestCommitChanges(t, repo, ".gitignore")
	checkNeverCommitted(t, repo, "config/prod.env")
	if got := git(t, repo, "status", "--porcelain"); got != "" {
		t.Errorf("git status --porcelain:\n%s\nwant nothing: every leftover file ignored, every change committed", got)
	}
}

// checkNewestCommitChanges checks which files the newest commit changed,
// one per line, in Git's order.
func checkNewestCommitChanges(t *testing.T, repo, want string) {
	t.Helper()
	if got := git(t, repo, "show", "--name-only", "--format=", "HEAD"); got != want {
		t.Errorf("files changed by the newest commit:\n%s\nwant:\n%s", got, want)
	}
}

// checkNeverCommitted checks that no commit ever contained path.
func checkNeverCommitted(t *testing.T, repo, path string) {
	t.Helper()
	if got := git(t, repo, "rev-list", "--count", "--all", "--", path); got != "0" {
		t.Errorf("%s (a production password) is in %s commit(s), want it never committed: git add . stages every file that isn't ignored yet, so stage only the files the task names", path, got)
	}
}

// checkIgnored asks git check-ignore whether .gitignore matches path: exit
// code 0 means ignored, 1 means not ignored.
func checkIgnored(t *testing.T, repo, path string, want bool) {
	t.Helper()
	_, stderr, err := run(filepath.Dir(repo), repo, "git", "check-ignore", "-q", "--no-index", path)
	var exit *exec.ExitError
	if err != nil && (!errors.As(err, &exit) || exit.ExitCode() != 1) {
		t.Fatalf("git check-ignore %s failed (%v):\n%s", path, err, stderr)
	}
	if got := err == nil; got != want {
		t.Errorf("%s ignored = %v, want %v", path, got, want)
	}
}

// runTasks builds a fresh sandbox with setup.sh, then runs task scripts 1 to
// n inside it, in order, as you would by hand. It returns the repo's path
// and what script n printed.
func runTasks(t *testing.T, n int) (repo, printed string) {
	t.Helper()
	home := t.TempDir()
	repo = filepath.Join(home, "sandbox")
	if _, stderr, err := run(home, ".", "bash", "setup.sh", repo); err != nil {
		t.Fatalf("setup.sh failed (%v):\n%s", err, stderr)
	}
	for _, script := range scripts[:n] {
		path, err := filepath.Abs(script)
		if err != nil {
			t.Fatal(err)
		}
		stdout, stderr, err := run(home, repo, "bash", path)
		if err != nil {
			t.Fatalf("%s failed (%v). It printed:\n%s%s", script, err, stdout, stderr)
		}
		printed = stdout
	}
	return repo, printed
}

// git runs a git command in repo and returns what it printed, without the
// final newline.
func git(t *testing.T, repo string, args ...string) string {
	t.Helper()
	stdout, stderr, err := run(filepath.Dir(repo), repo, "git", args...)
	if err != nil {
		t.Fatalf("git %s failed (%v):\n%s", strings.Join(args, " "), err, stderr)
	}
	return strings.TrimSuffix(stdout, "\n")
}

// run runs a command in dir, hermetically: no personal Git config, hooks or
// GIT_* variables, a fixed author and date, no Git repos outside home, and
// no editor or pager waiting for input.
func run(home, dir, name string, args ...string) (stdout, stderr string, err error) {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	for _, kv := range os.Environ() {
		if !strings.HasPrefix(kv, "GIT_") {
			cmd.Env = append(cmd.Env, kv)
		}
	}
	cmd.Env = append(cmd.Env,
		"GIT_CEILING_DIRECTORIES="+home,
		"HOME="+home, "XDG_CONFIG_HOME="+home, "LC_ALL=C", "TZ=UTC",
		"GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1",
		"GIT_AUTHOR_NAME=Sam Rivera", "GIT_AUTHOR_EMAIL=sam@example.com",
		"GIT_COMMITTER_NAME=Sam Rivera", "GIT_COMMITTER_EMAIL=sam@example.com",
		"GIT_AUTHOR_DATE=2026-10-01 12:00:00 +0000", "GIT_COMMITTER_DATE=2026-10-01 12:00:00 +0000",
		"GIT_EDITOR=true", "GIT_PAGER=cat", "PAGER=cat",
	)
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	err = cmd.Run()
	return out.String(), errOut.String(), err
}
