package controller

import "context"

// processNextItem takes one key from the queue and reconciles it. It returns
// false once the queue has been shut down, and true otherwise.
func (c *Controller) processNextItem(ctx context.Context) bool {
	key, shutdown := c.queue.Get()
	if shutdown {
		return false
	}
	defer c.queue.Done(key)

	// TODO(6): The error is thrown away, so a failed key is never retried.
	// Call c.queue.AddRateLimited(key) when Reconcile fails and
	// c.queue.Forget(key) when it succeeds.
	_ = c.Reconcile(ctx, key)
	return true
}

