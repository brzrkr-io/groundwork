package controller

import (
	"context"
	"errors"

	apierrors "k8s.io/apimachinery/pkg/api/errors"
	"k8s.io/client-go/tools/cache"
)

// ErrNotOwned means a Service with the Deployment's name already exists, but
// this controller did not create it, so it must not be changed.
var ErrNotOwned = errors.New("service is not owned by the deployment")

// Reconcile makes the cluster match what the Deployment behind key wants:
// a Service if it is exposed, no Service (of ours) if it is not.
func (c *Controller) Reconcile(ctx context.Context, key string) error {
	namespace, name, err := cache.SplitMetaNamespaceKey(key)
	if err != nil {
		return err
	}

	d, err := c.deployments.Deployments(namespace).Get(name)
	if apierrors.IsNotFound(err) {
		// The Deployment was deleted after its key was queued. Nothing to
		// do: its Service has an owner reference pointing at it, so the
		// cluster's garbage collector deletes the Service for us.
		return nil
	}
	if err != nil {
		return err
	}

	if Exposed(d) {
		// TODO(3): Write a method ensureService(ctx, d) that creates the
		// Service if it is missing, returns an error wrapping ErrNotOwned if d
		// does not own it, updates it if it has drifted, and leaves it alone
		// if it is in sync. Return its result here. You will need to import
		// "fmt", appsv1 "k8s.io/api/apps/v1" and
		// metav1 "k8s.io/apimachinery/pkg/apis/meta/v1".
		return nil
	}
	// TODO(4): Write a method removeService(ctx, d) that deletes the Service
	// only if it exists and d owns it. Return its result here.
	return nil
}
