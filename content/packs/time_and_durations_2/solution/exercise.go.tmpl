// Package schedule holds helpers for the nightly backup job.
package schedule

import "time"

// ArchiveName returns the backup archive name for host, for example
// "db-01-20260309-1405.tar.gz". The timestamp is in UTC.
func ArchiveName(host string, at time.Time) string {
	return host + "-" + at.UTC().Format("20060102-1504") + ".tar.gz"
}

// MaxRetryDelay is the longest RetryDelay will ever wait.
const MaxRetryDelay = 5 * time.Minute

// RetryDelay returns how long to wait before the given retry attempt:
// 30 seconds per attempt, capped at MaxRetryDelay.
func RetryDelay(attempt int) time.Duration {
	delay := time.Duration(attempt) * 30 * time.Second
	if delay > MaxRetryDelay {
		return MaxRetryDelay
	}
	return delay
}

// NextRun returns the first time strictly after now that is a whole multiple
// of the interval every.
func NextRun(now time.Time, every time.Duration) time.Time {
	return now.Truncate(every).Add(every)
}
