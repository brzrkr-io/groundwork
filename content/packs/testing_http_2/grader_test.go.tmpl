package httptesting

// This file is how Groundwork grades the test you write. You don't need to
// change it, but you are welcome to read it.
//
// TestGrader re-runs your tests against the real code, where they must pass,
// and then against each mutant below, where they must fail. A mutant is a
// copy of the code with one deliberate bug.

import (
	"encoding/json"
	"net/http"
	"os"
	"os/exec"
	"strings"
	"testing"
)

// learnerTests selects the tests you write in exercise_test.go.
const learnerTests = "^(TestDeployAccepted|TestDeployRejectsEmptyService)$"

// mutants are the bugs your tests must catch.
var mutants = []mutant{
	{
		name:    "ok_instead_of_accepted",
		bug:     "POST /deploys answered 200 instead of 202",
		install: breakAPI(func(api *deployAPI) { api.acceptedCode = http.StatusOK }),
	},
	{
		name:    "text_content_type",
		bug:     "POST /deploys sent Content-Type text/plain for a JSON body",
		install: breakAPI(func(api *deployAPI) { api.contentType = "text/plain; charset=utf-8" }),
	},
	{
		name:    "pending_status",
		bug:     `an accepted deploy had "status": "pending" instead of "queued"`,
		install: breakAPI(func(api *deployAPI) { api.status = "pending" }),
	},
	{
		name:    "drops_version",
		bug:     `an accepted deploy had an empty "version"`,
		install: breakAPI(func(api *deployAPI) { api.dropVersion = true }),
	},
	{
		name:    "accepts_empty_service",
		bug:     "a deploy with an empty service was accepted (the bug from the report)",
		install: breakAPI(func(api *deployAPI) { api.acceptEmptyService = true }),
	},
	{
		name:    "vague_error",
		bug:     `an empty service got the error "bad request" instead of "service is required"`,
		install: breakAPI(func(api *deployAPI) { api.emptyServiceError = "bad request" }),
	},
}

// deployAPI is a copy of the fixed deploy API. Each mutant changes one field.
type deployAPI struct {
	acceptedCode       int
	contentType        string
	status             string
	dropVersion        bool
	acceptEmptyService bool
	emptyServiceError  string
}

// breakAPI returns an install function that applies change to a working
// deploy API and swaps the result in.
func breakAPI(change func(api *deployAPI)) func() {
	return func() {
		api := deployAPI{
			acceptedCode:      http.StatusAccepted,
			contentType:       "application/json",
			status:            "queued",
			emptyServiceError: "service is required",
		}
		change(&api)
		newHandler = api.handler
	}
}

func (api deployAPI) handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("POST /deploys", func(w http.ResponseWriter, r *http.Request) {
		send := func(code int, v any) {
			w.Header().Set("Content-Type", api.contentType)
			w.WriteHeader(code)
			json.NewEncoder(w).Encode(v)
		}
		var req DeployRequest
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
			send(http.StatusBadRequest, ErrorResponse{Error: "invalid JSON body"})
			return
		}
		if req.Service == "" && !api.acceptEmptyService {
			send(http.StatusBadRequest, ErrorResponse{Error: api.emptyServiceError})
			return
		}
		if req.Version == "" {
			send(http.StatusBadRequest, ErrorResponse{Error: "version is required"})
			return
		}
		resp := DeployResponse{Service: req.Service, Version: req.Version, Status: api.status}
		if api.dropVersion {
			resp.Version = ""
		}
		send(api.acceptedCode, resp)
	})
	return mux
}

// Everything below is the same in every Testing exercise.

// mutantEnv names the environment variable that tells a re-run which mutant
// to install.
const mutantEnv = "GROUNDWORK_MUTANT"

type mutant struct {
	name    string // short name, used in GROUNDWORK_MUTANT and test output
	bug     string // completes "your tests didn't notice when ..."
	install func() // swaps the bug into the package
}

// TestMain runs before any test. In a re-run started by TestGrader, it
// installs the mutant named by GROUNDWORK_MUTANT.
func TestMain(m *testing.M) {
	if name := os.Getenv(mutantEnv); name != "" {
		for _, mu := range mutants {
			if mu.name == name {
				mu.install()
			}
		}
	}
	os.Exit(m.Run())
}

func TestGrader(t *testing.T) {
	if _, rerun := os.LookupEnv(mutantEnv); rerun {
		t.Skip("TestGrader does not run inside its own re-runs")
	}
	out, err := runLearnerTests("")
	if strings.Contains(out, "no tests to run") {
		t.Fatalf("found no test matching %s in exercise_test.go", learnerTests)
	}
	if err != nil {
		t.Fatalf("your tests must pass on the real code first, but they failed:\n%s", out)
	}
	for _, mu := range mutants {
		t.Run(mu.name, func(t *testing.T) {
			if _, err := runLearnerTests(mu.name); err == nil {
				t.Errorf("your tests didn't notice when %s", mu.bug)
			}
		})
	}
}

// runLearnerTests re-runs this test binary with only your tests selected and
// the named mutant installed. An empty name means the real code.
func runLearnerTests(mutant string) (string, error) {
	cmd := exec.Command(os.Args[0], "-test.run="+learnerTests)
	cmd.Env = append(os.Environ(), mutantEnv+"="+mutant)
	out, err := cmd.CombinedOutput()
	return string(out), err
}
