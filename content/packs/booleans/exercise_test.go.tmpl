package booleans

import "testing"

func TestIsPrivilegedPort(t *testing.T) {
	if !IsPrivilegedPort(22) {
		t.Errorf("IsPrivilegedPort(22) = false, want true")
	}
	if !IsPrivilegedPort(80) {
		t.Errorf("IsPrivilegedPort(80) = false, want true")
	}
	if !IsPrivilegedPort(1023) {
		t.Errorf("IsPrivilegedPort(1023) = false, want true")
	}
	if IsPrivilegedPort(1024) {
		t.Errorf("IsPrivilegedPort(1024) = true, want false")
	}
	if IsPrivilegedPort(8080) {
		t.Errorf("IsPrivilegedPort(8080) = true, want false")
	}
}

func TestCanDeploy(t *testing.T) {
	if !CanDeploy(true, true, false) {
		t.Errorf("CanDeploy(true, true, false) = false, want true")
	}
	if CanDeploy(false, true, false) {
		t.Errorf("CanDeploy(false, true, false) = true, want false")
	}
	if CanDeploy(true, false, false) {
		t.Errorf("CanDeploy(true, false, false) = true, want false")
	}
	if CanDeploy(true, true, true) {
		t.Errorf("CanDeploy(true, true, true) = true, want false")
	}
	if CanDeploy(false, false, true) {
		t.Errorf("CanDeploy(false, false, true) = true, want false")
	}
}

func TestIsWorkHours(t *testing.T) {
	if !IsWorkHours(9, false) {
		t.Errorf("IsWorkHours(9, false) = false, want true")
	}
	if !IsWorkHours(12, false) {
		t.Errorf("IsWorkHours(12, false) = false, want true")
	}
	if !IsWorkHours(16, false) {
		t.Errorf("IsWorkHours(16, false) = false, want true")
	}
	if IsWorkHours(17, false) {
		t.Errorf("IsWorkHours(17, false) = true, want false")
	}
	if IsWorkHours(8, false) {
		t.Errorf("IsWorkHours(8, false) = true, want false")
	}
	if IsWorkHours(0, false) {
		t.Errorf("IsWorkHours(0, false) = true, want false")
	}
	if IsWorkHours(10, true) {
		t.Errorf("IsWorkHours(10, true) = true, want false")
	}
}
