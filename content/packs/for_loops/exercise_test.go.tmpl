package loops

import "testing"

func TestTotalBackoff(t *testing.T) {
	if got := TotalBackoff(4, 1); got != 15 {
		t.Errorf("TotalBackoff(4, 1) = %d, want 15", got)
	}
	if got := TotalBackoff(3, 5); got != 35 {
		t.Errorf("TotalBackoff(3, 5) = %d, want 35", got)
	}
	if got := TotalBackoff(1, 2); got != 2 {
		t.Errorf("TotalBackoff(1, 2) = %d, want 2", got)
	}
	if got := TotalBackoff(0, 5); got != 0 {
		t.Errorf("TotalBackoff(0, 5) = %d, want 0", got)
	}
}

func TestProgressBar(t *testing.T) {
	if got := ProgressBar(2, 5); got != "[##---]" {
		t.Errorf(`ProgressBar(2, 5) = %q, want "[##---]"`, got)
	}
	if got := ProgressBar(0, 3); got != "[---]" {
		t.Errorf(`ProgressBar(0, 3) = %q, want "[---]"`, got)
	}
	if got := ProgressBar(4, 4); got != "[####]" {
		t.Errorf(`ProgressBar(4, 4) = %q, want "[####]"`, got)
	}
	if got := ProgressBar(0, 0); got != "[]" {
		t.Errorf(`ProgressBar(0, 0) = %q, want "[]"`, got)
	}
}

func TestRetriesWithin(t *testing.T) {
	if got := RetriesWithin(10, 1); got != 3 {
		t.Errorf("RetriesWithin(10, 1) = %d, want 3", got)
	}
	if got := RetriesWithin(7, 1); got != 3 {
		t.Errorf("RetriesWithin(7, 1) = %d, want 3", got)
	}
	if got := RetriesWithin(100, 10); got != 3 {
		t.Errorf("RetriesWithin(100, 10) = %d, want 3", got)
	}
	if got := RetriesWithin(4, 5); got != 0 {
		t.Errorf("RetriesWithin(4, 5) = %d, want 0", got)
	}
	if got := RetriesWithin(5, 5); got != 1 {
		t.Errorf("RetriesWithin(5, 5) = %d, want 1", got)
	}
}
