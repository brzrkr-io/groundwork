// Package heartbeat is the Groundwork exercise "select: tickers and deadlines".
package heartbeat

import "time"

// CollectFor collects events until window has passed or events is closed,
// whichever comes first.
func CollectFor(events <-chan string, window time.Duration) []string {
	var collected []string
	for {
		select {
		case event, ok := <-events:
			if !ok {
				return collected
			}
			collected = append(collected, event)
		// TODO(1): This starts a new timer on every pass through the loop.
		// Measure window from when CollectFor was called instead.
		case <-time.After(window):
			return collected
		}
	}
}

