package sharding

import (
	"fmt"
	"math"
	"slices"
	"testing"
)

// services are the keys most tests use.
var services = []string{
	"api", "billing", "checkout", "payments", "search",
	"auth", "web", "worker", "deploy-bot", "ledger",
}

// manyServices returns n keys: "service-0", "service-1", ...
func manyServices(n int) []string {
	keys := make([]string, n)
	for i := range keys {
		keys[i] = fmt.Sprintf("service-%d", i)
	}
	return keys
}

func TestShardFor(t *testing.T) {
	tests := []struct {
		key  string
		n    int
		want int
	}{
		{"api", 4, 3},
		{"billing", 4, 0},
		{"payments", 4, 2},
		{"checkout", 4, 1},
		{"api", 8, 7},
		{"payments", 8, 6},
		{"deploy-bot", 8, 2},
		{"ledger", 3, 2},
		{"auth", 5, 4},
		{"api", 1, 0},
		{"payments", 1, 0},
	}
	for _, tt := range tests {
		t.Run(fmt.Sprintf("%s over %d", tt.key, tt.n), func(t *testing.T) {
			if got := ShardFor(tt.key, tt.n); got != tt.want {
				t.Errorf("ShardFor(%q, %d) = %d, want %d (fnv.New32a hash of the key, %% %d)",
					tt.key, tt.n, got, tt.want, tt.n)
			}
		})
	}

	t.Run("always between 0 and n-1", func(t *testing.T) {
		for _, key := range manyServices(500) {
			if got := ShardFor(key, 7); got < 0 || got > 6 {
				t.Fatalf("ShardFor(%q, 7) = %d, want a shard from 0 to 6", key, got)
			}
		}
	})
}

func TestGroup(t *testing.T) {
	tests := []struct {
		name string
		keys []string
		n    int
		want [][]string
	}{
		{
			name: "ten services over 4 shards",
			keys: services,
			n:    4,
			want: [][]string{
				{"billing", "ledger"},
				{"checkout", "search", "web"},
				{"payments", "deploy-bot"},
				{"api", "auth", "worker"},
			},
		},
		{
			name: "ten services over 3 shards",
			keys: services,
			n:    3,
			want: [][]string{
				{"payments", "auth"},
				{"billing", "checkout", "search", "web", "deploy-bot"},
				{"api", "worker", "ledger"},
			},
		},
		{
			name: "input order is kept",
			keys: []string{"worker", "auth", "api"},
			n:    4,
			want: [][]string{nil, nil, nil, {"worker", "auth", "api"}},
		},
		{
			name: "empty shards are still there",
			keys: []string{"api"},
			n:    3,
			want: [][]string{nil, nil, {"api"}},
		},
		{
			name: "no keys",
			keys: nil,
			n:    2,
			want: [][]string{nil, nil},
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := Group(tt.keys, tt.n)
			if len(got) != len(tt.want) {
				t.Fatalf("Group(%q, %d) returned %d shards, want %d", tt.keys, tt.n, len(got), len(tt.want))
			}
			for i := range tt.want {
				if !slices.Equal(got[i], tt.want[i]) {
					t.Errorf("Group(%q, %d)[%d] = %q, want %q", tt.keys, tt.n, i, got[i], tt.want[i])
				}
			}
		})
	}
}

func TestPlan(t *testing.T) {
	tests := []struct {
		name     string
		keys     []string
		from, to int
		want     []Move
	}{
		{
			name: "4 to 5 shards",
			keys: services,
			from: 4,
			to:   5,
			want: []Move{
				{"api", 3, 2},
				{"billing", 0, 2},
				{"payments", 2, 3},
				{"search", 1, 3},
				{"auth", 3, 4},
				{"web", 1, 0},
				{"worker", 3, 2},
				{"deploy-bot", 2, 1},
			},
		},
		{
			name: "4 to 8 shards",
			keys: services,
			from: 4,
			to:   8,
			want: []Move{
				{"api", 3, 7},
				{"billing", 0, 4},
				{"payments", 2, 6},
				{"auth", 3, 7},
				{"worker", 3, 7},
				{"ledger", 0, 4},
			},
		},
		{
			name: "input order is kept",
			keys: []string{"worker", "checkout", "api"},
			from: 3,
			to:   4,
			want: []Move{{"worker", 2, 3}, {"api", 2, 3}},
		},
		{
			name: "same number of shards moves nothing",
			keys: services,
			from: 4,
			to:   4,
			want: nil,
		},
		{
			name: "no keys",
			keys: nil,
			from: 4,
			to:   5,
			want: nil,
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := Plan(tt.keys, tt.from, tt.to); !slices.Equal(got, tt.want) {
				t.Errorf("Plan(%q, %d, %d) = %+v, want %+v", tt.keys, tt.from, tt.to, got, tt.want)
			}
		})
	}
}

func TestMovedFraction(t *testing.T) {
	keys := manyServices(1000)
	tests := []struct {
		name     string
		keys     []string
		from, to int
		want     float64
	}{
		{"1000 keys, 4 to 5 shards", keys, 4, 5, 0.787},
		{"1000 keys, 10 to 11 shards", keys, 10, 11, 0.904},
		{"1000 keys, 4 to 8 shards", keys, 4, 8, 0.501},
		{"1000 keys, 5 to 4 shards", keys, 5, 4, 0.787},
		{"1000 keys, no change", keys, 4, 4, 0},
		{"10 keys, 4 to 5 shards", services, 4, 5, 0.8},
		{"no keys", nil, 4, 5, 0},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := MovedFraction(tt.keys, tt.from, tt.to)
			if math.Abs(got-tt.want) > 1e-9 {
				t.Errorf("MovedFraction(%d keys, %d, %d) = %v, want %v", len(tt.keys), tt.from, tt.to, got, tt.want)
			}
		})
	}
}
