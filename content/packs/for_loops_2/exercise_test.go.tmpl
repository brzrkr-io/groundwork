package loops

import "testing"

func TestHostNames(t *testing.T) {
	if got := HostNames("web", 3); got != "web-1,web-2,web-3" {
		t.Errorf(`HostNames("web", 3) = %q, want "web-1,web-2,web-3"`, got)
	}
	if got := HostNames("db", 1); got != "db-1" {
		t.Errorf(`HostNames("db", 1) = %q, want "db-1"`, got)
	}
	if got := HostNames("cache", 2); got != "cache-1,cache-2" {
		t.Errorf(`HostNames("cache", 2) = %q, want "cache-1,cache-2"`, got)
	}
	if got := HostNames("web", 0); got != "" {
		t.Errorf(`HostNames("web", 0) = %q, want ""`, got)
	}
}

func TestPortList(t *testing.T) {
	if got := PortList(8000, 8003, 8002); got != "8000,8001,8003" {
		t.Errorf(`PortList(8000, 8003, 8002) = %q, want "8000,8001,8003"`, got)
	}
	if got := PortList(9000, 9002, 7000); got != "9000,9001,9002" {
		t.Errorf(`PortList(9000, 9002, 7000) = %q, want "9000,9001,9002"`, got)
	}
	if got := PortList(80, 82, 81); got != "80,82" {
		t.Errorf(`PortList(80, 82, 81) = %q, want "80,82"`, got)
	}
	if got := PortList(5000, 5000, 1); got != "5000" {
		t.Errorf(`PortList(5000, 5000, 1) = %q, want "5000"`, got)
	}
}

func TestBatchCount(t *testing.T) {
	if got := BatchCount(10, 3); got != 4 {
		t.Errorf("BatchCount(10, 3) = %d, want 4", got)
	}
	if got := BatchCount(9, 3); got != 3 {
		t.Errorf("BatchCount(9, 3) = %d, want 3", got)
	}
	if got := BatchCount(2, 5); got != 1 {
		t.Errorf("BatchCount(2, 5) = %d, want 1", got)
	}
	if got := BatchCount(0, 3); got != 0 {
		t.Errorf("BatchCount(0, 3) = %d, want 0", got)
	}
}
