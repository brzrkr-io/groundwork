package text

import "testing"

func TestRedact(t *testing.T) {
	if got := Redact("password=hunter2 user=bob", "hunter2"); got != "password=******* user=bob" {
		t.Errorf(`Redact("password=hunter2 user=bob", "hunter2") = %q, want "password=******* user=bob"`, got)
	}

	if got := Redact("token=abc123 retry token=abc123", "abc123"); got != "token=****** retry token=******" {
		t.Errorf(`Redact("token=abc123 retry token=abc123", "abc123") = %q, want "token=****** retry token=******"`, got)
	}
}

func TestHostFromURL(t *testing.T) {
	if got := HostFromURL("https://API.Example.com/"); got != "api.example.com" {
		t.Errorf(`HostFromURL("https://API.Example.com/") = %q, want "api.example.com"`, got)
	}

	if got := HostFromURL("https://grafana.internal"); got != "grafana.internal" {
		t.Errorf(`HostFromURL("https://grafana.internal") = %q, want "grafana.internal"`, got)
	}

	if got := HostFromURL("vault.internal/"); got != "vault.internal" {
		t.Errorf(`HostFromURL("vault.internal/") = %q, want "vault.internal"`, got)
	}
}

func TestEnvVarName(t *testing.T) {
	if got := EnvVarName("checkout-api", "db url"); got != "CHECKOUT_API_DB_URL" {
		t.Errorf(`EnvVarName("checkout-api", "db url") = %q, want "CHECKOUT_API_DB_URL"`, got)
	}

	if got := EnvVarName("auth", "log-level"); got != "AUTH_LOG_LEVEL" {
		t.Errorf(`EnvVarName("auth", "log-level") = %q, want "AUTH_LOG_LEVEL"`, got)
	}

	if got := EnvVarName("payment-gateway", "max open conns"); got != "PAYMENT_GATEWAY_MAX_OPEN_CONNS" {
		t.Errorf(`EnvVarName("payment-gateway", "max open conns") = %q, want "PAYMENT_GATEWAY_MAX_OPEN_CONNS"`, got)
	}
}
