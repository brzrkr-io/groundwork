// Package deployconf is the Groundwork exercise "Maps: fix the config bugs".
package deployconf

import "maps"

// Replicas returns how many copies of service to run: the value in replicas,
// or 2 when the service isn't listed.
func Replicas(replicas map[string]int, service string) int {
	n, ok := replicas[service]
	if !ok {
		return 2
	}
	return n
}

// Unset deletes keys from env and returns how many of them were there.
func Unset(env map[string]string, keys ...string) int {
	removed := 0
	for _, k := range keys {
		if _, ok := env[k]; ok {
			delete(env, k)
			removed++
		}
	}
	return removed
}

// Merge returns a new map with every entry of defaults, replaced or extended
// by overrides. It doesn't change either argument.
func Merge(defaults, overrides map[string]string) map[string]string {
	merged := make(map[string]string)
	maps.Copy(merged, defaults)
	maps.Copy(merged, overrides)
	return merged
}
