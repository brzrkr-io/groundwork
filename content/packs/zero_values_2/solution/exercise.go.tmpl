// Package zerovalues is the Groundwork exercise "Zero values: fix the log rotation defaults".
package zerovalues

import "fmt"

// LogPath returns path, or "/var/log/app.log" when path is empty.
func LogPath(path string) string {
	if path == "" {
		return "/var/log/app.log"
	}
	return path
}

// SampleRate returns rate, or 0.1 when rate is unset (0).
func SampleRate(rate float64) float64 {
	if rate == 0 {
		return 0.1
	}
	return rate
}

// RotationSummary fills in defaults and describes the rotation policy.
func RotationSummary(path string, maxSizeMiB, keepFiles int) string {
	path = LogPath(path)
	if maxSizeMiB == 0 {
		maxSizeMiB = 100
	}
	if keepFiles == 0 {
		keepFiles = 5
	}
	return fmt.Sprintf("rotate %s at %dMiB, keep %d", path, maxSizeMiB, keepFiles)
}
