// Package rollout is the Groundwork exercise "Slices: rolling-deploy batches".
package rollout

// BatchCount returns how many batches of size hosts it takes to cover hosts.
func BatchCount(hosts []string, size int) int {
	return (len(hosts) + size - 1) / size
}

// Batch returns batch number n (counting from 0) when hosts is split into
// batches of size hosts. The last batch may be shorter.
func Batch(hosts []string, size, n int) []string {
	start := min(n*size, len(hosts))
	end := min(start+size, len(hosts))
	return hosts[start:end]
}

// Plan splits hosts into batches of size hosts, in order.
func Plan(hosts []string, size int) [][]string {
	plan := make([][]string, BatchCount(hosts, size))
	for n := range len(plan) {
		plan[n] = Batch(hosts, size, n)
	}
	return plan
}
