package metrics

import (
	"net/http/httptest"
	"strings"
	"sync"
	"testing"
)

func TestCounterAdd(t *testing.T) {
	tests := []struct {
		name string
		adds []float64
		want float64
	}{
		{"positive values", []float64{1, 2.5}, 3.5},
		{"negative is ignored", []float64{2.5, -1, 1}, 3.5},
		{"only negative", []float64{-5}, 0},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			var c Counter
			for _, v := range tt.adds {
				c.Add(v)
			}
			if got := c.Value(); got != tt.want {
				t.Errorf("after Add of %v, Value() = %v, want %v", tt.adds, got, tt.want)
			}
		})
	}

	t.Run("concurrent Inc", func(t *testing.T) {
		var c Counter
		var wg sync.WaitGroup
		for range 50 {
			wg.Go(func() {
				for range 100 {
					c.Inc()
				}
			})
		}
		wg.Wait()
		if got := c.Value(); got != 5000 {
			t.Errorf("after 50 goroutines called Inc 100 times, Value() = %v, want 5000", got)
		}
	})
}

func TestCounterVecWrite(t *testing.T) {
	tests := []struct {
		name string
		vec  *CounterVec
		incs []string
		want string
	}{
		{
			name: "requests by status",
			vec:  NewCounterVec("http_requests_total", "Requests served.", "status"),
			incs: []string{"500", "200", "404", "200", "404", "200"},
			want: `# HELP http_requests_total Requests served.
# TYPE http_requests_total counter
http_requests_total{status="200"} 3
http_requests_total{status="404"} 2
http_requests_total{status="500"} 1
`,
		},
		{
			name: "deploys by region",
			vec:  NewCounterVec("deploys_total", "Deploys started.", "region"),
			incs: []string{"us-east-1", "eu-west-1"},
			want: `# HELP deploys_total Deploys started.
# TYPE deploys_total counter
deploys_total{region="eu-west-1"} 1
deploys_total{region="us-east-1"} 1
`,
		},
		{
			name: "no values yet",
			vec:  NewCounterVec("alerts_fired_total", "Alerts fired.", "severity"),
			incs: nil,
			want: `# HELP alerts_fired_total Alerts fired.
# TYPE alerts_fired_total counter
`,
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			for _, value := range tt.incs {
				tt.vec.Inc(value)
			}
			var b strings.Builder
			tt.vec.Write(&b)
			if got := b.String(); got != tt.want {
				t.Errorf("Write() after Inc of %q wrote:\n%s\nwant:\n%s", tt.incs, got, tt.want)
			}
		})
	}
}

func TestHandler(t *testing.T) {
	requests := NewCounterVec("http_requests_total", "Requests served.", "status")
	requests.Inc("200")
	requests.Inc("200")
	deploys := NewCounterVec("deploys_total", "Deploys started.", "region")
	deploys.Inc("eu-west-1")

	tests := []struct {
		name     string
		families []*CounterVec
		want     string
	}{
		{
			name:     "requests then deploys",
			families: []*CounterVec{requests, deploys},
			want: `# HELP http_requests_total Requests served.
# TYPE http_requests_total counter
http_requests_total{status="200"} 2
# HELP deploys_total Deploys started.
# TYPE deploys_total counter
deploys_total{region="eu-west-1"} 1
`,
		},
		{
			name:     "deploys only",
			families: []*CounterVec{deploys},
			want: `# HELP deploys_total Deploys started.
# TYPE deploys_total counter
deploys_total{region="eu-west-1"} 1
`,
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			req := httptest.NewRequest("GET", "/metrics", nil)
			resp := httptest.NewRecorder()
			Handler(tt.families...).ServeHTTP(resp, req)

			if resp.Code != 200 {
				t.Errorf("GET /metrics status = %d, want 200", resp.Code)
			}
			wantType := "text/plain; version=0.0.4; charset=utf-8"
			if got := resp.Header().Get("Content-Type"); got != wantType {
				t.Errorf("GET /metrics Content-Type = %q, want %q", got, wantType)
			}
			if got := resp.Body.String(); got != tt.want {
				t.Errorf("GET /metrics body:\n%s\nwant:\n%s", got, tt.want)
			}
		})
	}
}
