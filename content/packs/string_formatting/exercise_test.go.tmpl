package formatting

import "testing"

func TestStatusLine(t *testing.T) {
	if got := StatusLine("api", 3); got != "api: 3 replicas ready" {
		t.Errorf(`StatusLine("api", 3) = %q, want "api: 3 replicas ready"`, got)
	}

	if got := StatusLine("billing", 12); got != "billing: 12 replicas ready" {
		t.Errorf(`StatusLine("billing", 12) = %q, want "billing: 12 replicas ready"`, got)
	}
}

func TestRolloutProgress(t *testing.T) {
	if got := RolloutProgress("api", 42.5); got != `rollout "api" 42.5% complete` {
		t.Errorf(`RolloutProgress("api", 42.5) = %q, want "rollout \"api\" 42.5%% complete"`, got)
	}

	if got := RolloutProgress("billing", 100); got != `rollout "billing" 100.0% complete` {
		t.Errorf(`RolloutProgress("billing", 100) = %q, want "rollout \"billing\" 100.0%% complete"`, got)
	}

	if got := RolloutProgress("auth", 33.333); got != `rollout "auth" 33.3% complete` {
		t.Errorf(`RolloutProgress("auth", 33.333) = %q, want "rollout \"auth\" 33.3%% complete"`, got)
	}
}

func TestTableRow(t *testing.T) {
	if got := TableRow("api", 3, "Running"); got != "api        |     3 | Running" {
		t.Errorf(`TableRow("api", 3, "Running") = %q, want "api        |     3 | Running"`, got)
	}

	if got := TableRow("checkout", 12, "Pending"); got != "checkout   |    12 | Pending" {
		t.Errorf(`TableRow("checkout", 12, "Pending") = %q, want "checkout   |    12 | Pending"`, got)
	}

	if got := TableRow("notification-svc", 120, "Running"); got != "notification-svc |   120 | Running" {
		t.Errorf(`TableRow("notification-svc", 120, "Running") = %q, want "notification-svc |   120 | Running"`, got)
	}
}
