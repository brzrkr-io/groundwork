// Package interfaces3 is the Groundwork exercise "Interfaces: swap in a fake for tests".
package interfaces3

import (
	"fmt"
	"os"
)

// Store looks up configuration values by key. ok is false when the key is
// missing.
type Store interface {
	Get(key string) (value string, ok bool)
}

// EnvStore reads configuration from environment variables. The real service
// uses it; the tests use MemoryStore instead.
type EnvStore struct{}

// Get returns the environment variable named key.
func (e EnvStore) Get(key string) (string, bool) {
	return os.LookupEnv(key)
}

// MemoryStore keeps configuration in a map.
type MemoryStore struct {
	Values map[string]string
}

// Get returns the value stored under key in m.Values.
func (m MemoryStore) Get(key string) (string, bool) {
	v, ok := m.Values[key]
	return v, ok
}

// Resolve looks up every key in s and returns the values in a map. If a key
// is missing, it returns nil and an error naming that key.
func Resolve(s Store, keys []string) (map[string]string, error) {
	config := make(map[string]string)
	for _, key := range keys {
		v, ok := s.Get(key)
		if !ok {
			return nil, fmt.Errorf("missing config key %q", key)
		}
		config[key] = v
	}
	return config, nil
}

// Layered looks a key up in each of its layers in turn and returns the first
// value it finds. Overrides go first, defaults last.
type Layered struct {
	Layers []Store
}

// Get returns the value from the first layer that has key.
func (l Layered) Get(key string) (string, bool) {
	for _, layer := range l.Layers {
		if v, ok := layer.Get(key); ok {
			return v, true
		}
	}
	return "", false
}
