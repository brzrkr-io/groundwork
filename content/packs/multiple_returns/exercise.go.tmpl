// Package returns is the Groundwork exercise "Multiple return values".
package returns

import "strings"

// SplitUptime splits a number of minutes into whole hours and leftover minutes.
func SplitUptime(totalMinutes int) (int, int) {
	// TODO(1): Return the hours and the leftover minutes.
	return 0, totalMinutes
}

// SplitHostPort splits "host:port" at the first colon. The bool reports
// whether a colon was found.
func SplitHostPort(addr string) (string, string, bool) {
	// TODO(2): Use strings.Cut, and return "", "", false when there is no colon.
	return strings.ToLower(addr), "", true
}

// ParseAddress splits "host:port" and converts the port to a number between
// 1 and 65535.
func ParseAddress(addr string) (string, int, error) {
	// TODO(3): Return an error for a missing colon, a non-numeric port, or a
	// port out of range. Add the imports you need.
	return addr, 0, nil
}
