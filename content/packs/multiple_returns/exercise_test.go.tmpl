package returns

import "testing"

func TestSplitUptime(t *testing.T) {
	hours, minutes := SplitUptime(135)
	if hours != 2 || minutes != 15 {
		t.Errorf("SplitUptime(135) = %d, %d, want 2, 15", hours, minutes)
	}
	hours, minutes = SplitUptime(59)
	if hours != 0 || minutes != 59 {
		t.Errorf("SplitUptime(59) = %d, %d, want 0, 59", hours, minutes)
	}
	hours, minutes = SplitUptime(120)
	if hours != 2 || minutes != 0 {
		t.Errorf("SplitUptime(120) = %d, %d, want 2, 0", hours, minutes)
	}
	hours, minutes = SplitUptime(1441)
	if hours != 24 || minutes != 1 {
		t.Errorf("SplitUptime(1441) = %d, %d, want 24, 1", hours, minutes)
	}
}

func TestSplitHostPort(t *testing.T) {
	host, port, ok := SplitHostPort("db.internal:5432")
	if host != "db.internal" || port != "5432" || !ok {
		t.Errorf(`SplitHostPort("db.internal:5432") = %q, %q, %v, want "db.internal", "5432", true`, host, port, ok)
	}
	host, port, ok = SplitHostPort("Web-1:80")
	if host != "Web-1" || port != "80" || !ok {
		t.Errorf(`SplitHostPort("Web-1:80") = %q, %q, %v, want "Web-1", "80", true`, host, port, ok)
	}
	host, port, ok = SplitHostPort("localhost")
	if host != "" || port != "" || ok {
		t.Errorf(`SplitHostPort("localhost") = %q, %q, %v, want "", "", false`, host, port, ok)
	}
	host, port, ok = SplitHostPort("")
	if host != "" || port != "" || ok {
		t.Errorf(`SplitHostPort("") = %q, %q, %v, want "", "", false`, host, port, ok)
	}
}

func TestParseAddress(t *testing.T) {
	host, port, err := ParseAddress("api.internal:8080")
	if host != "api.internal" || port != 8080 || err != nil {
		t.Errorf(`ParseAddress("api.internal:8080") = %q, %d, %v, want "api.internal", 8080, nil`, host, port, err)
	}
	host, port, err = ParseAddress("bastion:22")
	if host != "bastion" || port != 22 || err != nil {
		t.Errorf(`ParseAddress("bastion:22") = %q, %d, %v, want "bastion", 22, nil`, host, port, err)
	}
	host, port, err = ParseAddress("cache:65535")
	if host != "cache" || port != 65535 || err != nil {
		t.Errorf(`ParseAddress("cache:65535") = %q, %d, %v, want "cache", 65535, nil`, host, port, err)
	}
	host, port, err = ParseAddress("api.internal")
	if host != "" || port != 0 || err == nil {
		t.Errorf(`ParseAddress("api.internal") = %q, %d, %v, want "", 0 and an error`, host, port, err)
	}
	host, port, err = ParseAddress("api.internal:http")
	if host != "" || port != 0 || err == nil {
		t.Errorf(`ParseAddress("api.internal:http") = %q, %d, %v, want "", 0 and an error`, host, port, err)
	}
	host, port, err = ParseAddress("api.internal:0")
	if host != "" || port != 0 || err == nil {
		t.Errorf(`ParseAddress("api.internal:0") = %q, %d, %v, want "", 0 and an error`, host, port, err)
	}
	host, port, err = ParseAddress("api.internal:65536")
	if host != "" || port != 0 || err == nil {
		t.Errorf(`ParseAddress("api.internal:65536") = %q, %d, %v, want "", 0 and an error`, host, port, err)
	}
}
