package variables

import "testing"

func TestPodName(t *testing.T) {
	if got := PodName("checkout", "7d9f8b6c5", "x2k4p"); got != "checkout-7d9f8b6c5-x2k4p" {
		t.Errorf(`PodName("checkout", "7d9f8b6c5", "x2k4p") = %q, want "checkout-7d9f8b6c5-x2k4p"`, got)
	}

	if got := PodName("api", "5f6d7c8b9", "q8w7e"); got != "api-5f6d7c8b9-q8w7e" {
		t.Errorf(`PodName("api", "5f6d7c8b9", "q8w7e") = %q, want "api-5f6d7c8b9-q8w7e"`, got)
	}
}

func TestSSHTarget(t *testing.T) {
	if got := SSHTarget("deploy", "web-01", "prod.example.com"); got != "deploy@web-01.prod.example.com" {
		t.Errorf(`SSHTarget("deploy", "web-01", "prod.example.com") = %q, want "deploy@web-01.prod.example.com"`, got)
	}

	if got := SSHTarget("admin", "db-02", "staging.example.com"); got != "admin@db-02.staging.example.com" {
		t.Errorf(`SSHTarget("admin", "db-02", "staging.example.com") = %q, want "admin@db-02.staging.example.com"`, got)
	}
}

func TestSetImageCommand(t *testing.T) {
	if got := SetImageCommand("payments", "checkout", "registry.internal/checkout:v2.1.0"); got != "kubectl -n payments set image deployment/checkout checkout=registry.internal/checkout:v2.1.0" {
		t.Errorf(`SetImageCommand("payments", "checkout", "registry.internal/checkout:v2.1.0") = %q, want "kubectl -n payments set image deployment/checkout checkout=registry.internal/checkout:v2.1.0"`, got)
	}

	if got := SetImageCommand("web", "api", "ghcr.io/acme/api:v1.4.2"); got != "kubectl -n web set image deployment/api api=ghcr.io/acme/api:v1.4.2" {
		t.Errorf(`SetImageCommand("web", "api", "ghcr.io/acme/api:v1.4.2") = %q, want "kubectl -n web set image deployment/api api=ghcr.io/acme/api:v1.4.2"`, got)
	}
}
