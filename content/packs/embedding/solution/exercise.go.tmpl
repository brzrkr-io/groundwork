// Package embedding is the Groundwork exercise "Struct embedding".
package embedding

import "fmt"

// Metadata is the part every Kubernetes object shares.
type Metadata struct {
	Name      string
	Namespace string
	Labels    map[string]string
}

// Pod runs one container image. It embeds Metadata.
type Pod struct {
	Metadata
	Image string
}

// Service exposes pods on a port. It embeds Metadata.
type Service struct {
	Metadata
	Port int
}

// NewPod returns a Pod with the given name, namespace and image, labelled
// app=<name>.
func NewPod(name, namespace, image string) Pod {
	return Pod{
		Metadata: Metadata{
			Name:      name,
			Namespace: namespace,
			Labels:    map[string]string{"app": name},
		},
		Image: image,
	}
}

// Describe returns "namespace/name", for example "default/api".
func (m Metadata) Describe() string {
	return m.Namespace + "/" + m.Name
}

// Describe returns "pod namespace/name (image)", for example
// "pod default/api (nginx:1.27)".
func (p Pod) Describe() string {
	return fmt.Sprintf("pod %s (%s)", p.Metadata.Describe(), p.Image)
}
