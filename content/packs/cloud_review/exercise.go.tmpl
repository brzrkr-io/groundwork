// Account is a snapshot of the settings a reviewer looks at, as an export
// script would save them to a JSON file.
type Account struct {
	ID             string          `json:"id"`
	SecurityGroups []SecurityGroup `json:"securityGroups"`
	Policies       []NamedPolicy   `json:"policies"`
	Buckets        []Bucket        `json:"buckets"`
	AccessKeys     []AccessKey     `json:"accessKeys"`
}

// SecurityGroup is a security group and its inbound rules.
type SecurityGroup struct {
	ID      string `json:"id"`
	Name    string `json:"name"`
	Inbound []Rule `json:"inbound"`
}

// Rule is one inbound security group rule. Protocol "-1" means all
// protocols and all ports.
type Rule struct {
	Protocol string `json:"protocol"`
	FromPort int    `json:"fromPort"`
	ToPort   int    `json:"toPort"`
	CIDR     string `json:"cidr"`
}

// NamedPolicy is an IAM policy and the name it was saved under.
type NamedPolicy struct {
	Name     string `json:"name"`
	Document Policy `json:"document"`
}

// Bucket is an S3 bucket with its bucket policy and whether Block Public
// Access is on.
type Bucket struct {
	Name              string `json:"name"`
	BlockPublicAccess bool   `json:"blockPublicAccess"`
	Policy            Policy `json:"policy"`
}

// AccessKey is an IAM user's access key. LastUsed is the zero time when the
// key has never been used.
type AccessKey struct {
	User     string    `json:"user"`
	ID       string    `json:"id"`
	Status   string    `json:"status"`
	Created  time.Time `json:"created"`
	LastUsed time.Time `json:"lastUsed"`
}

// Policy is an IAM policy document or bucket policy.
type Policy struct {
	Version   string
	Statement []Statement
}

// Statement is one statement of a policy. Principal is only set in bucket
// policies.
type Statement struct {
	Sid       string
	Effect    string
	Principal Principal
	Action    StringList
	Resource  StringList
	Condition map[string]map[string]StringList
}

// StringList is a JSON value that is either one string or a list of strings.
type StringList []string

// UnmarshalJSON accepts "s3:GetObject" as well as ["s3:GetObject", "s3:PutObject"].
func (l *StringList) UnmarshalJSON(data []byte) error {
	var one string
	if err := json.Unmarshal(data, &one); err == nil {
		*l = StringList{one}
		return nil
	}
	var many []string
	if err := json.Unmarshal(data, &many); err != nil {
		return err
	}
	*l = many
	return nil
}

// Principal says who a bucket policy statement applies to. "*" in AWS means
// anyone.
type Principal struct {
	AWS StringList
}

// UnmarshalJSON accepts "*" as well as {"AWS": "arn:..."} or {"AWS": [...]}.
func (p *Principal) UnmarshalJSON(data []byte) error {
	var one string
	if err := json.Unmarshal(data, &one); err == nil {
		p.AWS = StringList{one}
		return nil
	}
	var obj struct{ AWS StringList }
	if err := json.Unmarshal(data, &obj); err != nil {
		return err
	}
	p.AWS = obj.AWS
	return nil
}

// Finding is one problem the review found.
type Finding struct {
	Severity string // "high", "medium" or "low"
	Resource string
	Problem  string
}

// Load reads an account snapshot from a JSON file.
func Load(path string) (Account, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return Account{}, err
	}
	var a Account
	if err := json.Unmarshal(data, &a); err != nil {
		return Account{}, fmt.Errorf("%s: %w", path, err)
	}
	return a, nil
}

// Review loads the snapshot at path and returns the report of every finding.
func Review(path string, now time.Time) (string, error) {
	a, err := Load(path)
	if err != nil {
		return "", err
	}
	var all []Finding
	all = append(all, OpenAdminPorts(a.SecurityGroups)...)
	all = append(all, BroadPolicies(a.Policies)...)
	all = append(all, PublicBuckets(a.Buckets)...)
	all = append(all, StaleKeys(a.AccessKeys, now)...)
	return Report(all), nil
}

