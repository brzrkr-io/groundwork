{
  "Version": "2012-10-17",
  "Id": "TODO(2): aws s3 ls and aws s3 cp on acme-reports both fail with access denied; fix the statements, then delete this Id line",
  "Statement": [
    {
      "Sid": "ListReports",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::acme-reports/*"
    },
    {
      "Sid": "ReadReports",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::acme-reports"
    }
  ]
}
