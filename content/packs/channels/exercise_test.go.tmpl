package channels

import (
	"slices"
	"testing"
	"time"
)

// receiveAll receives from ch until it is closed and returns what it got.
// If nothing arrives for 2 seconds, it fails the test instead of hanging.
// (select and the ", ok" receive are covered in the next exercises.)
func receiveAll(t *testing.T, ch chan string) []string {
	t.Helper()
	var got []string
	for {
		select {
		case v, ok := <-ch:
			if !ok {
				return got // closed and empty
			}
			got = append(got, v)
		case <-time.After(2 * time.Second):
			t.Fatalf("waited 2s for a value after receiving %q: did you forget to close the channel?", got)
		}
	}
}

func TestCollectLines(t *testing.T) {
	tests := []struct {
		name  string
		lines []string
	}{
		{"two lines", []string{"GET /", "GET /health"}},
		{"three lines", []string{"POST /deploy", "GET /status", "DELETE /cache"}},
		{"no lines", nil},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			lines := make(chan string)
			go func() {
				for _, line := range tt.lines {
					lines <- line
				}
				close(lines)
			}()

			got := CollectLines(lines)
			if !slices.Equal(got, tt.lines) {
				t.Errorf("CollectLines(%q sent on a channel) = %q, want %q", tt.lines, got, tt.lines)
			}
		})
	}
}

func TestQueueAlerts(t *testing.T) {
	tests := []struct {
		name   string
		alerts []string
	}{
		{"two alerts", []string{"disk 91%", "cpu 99%"}},
		{"three alerts", []string{"api down", "cert expires in 3d", "queue backlog"}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			ch := QueueAlerts(tt.alerts)
			if ch == nil {
				t.Fatal("QueueAlerts returned a nil channel; create one with make(chan string, size)")
			}
			if cap(ch) != len(tt.alerts) {
				t.Errorf("cap(QueueAlerts(%q)) = %d, want %d", tt.alerts, cap(ch), len(tt.alerts))
			}
			if len(ch) != len(tt.alerts) {
				t.Fatalf("len(QueueAlerts(%q)) = %d, want %d: every alert should already be in the buffer", tt.alerts, len(ch), len(tt.alerts))
			}

			var got []string
			for range len(tt.alerts) {
				got = append(got, <-ch)
			}
			if !slices.Equal(got, tt.alerts) {
				t.Errorf("QueueAlerts(%q) held %q, want %q", tt.alerts, got, tt.alerts)
			}

			// The buffer is empty now. A closed channel answers straight away
			// with ok == false; an open one has nothing to give (default).
			select {
			case v, ok := <-ch:
				if ok {
					t.Errorf("QueueAlerts(%q) held an extra value %q", tt.alerts, v)
				}
			default:
				t.Errorf("QueueAlerts(%q) returned a channel that is not closed", tt.alerts)
			}
		})
	}
}

func TestStreamLines(t *testing.T) {
	tests := []struct {
		name  string
		lines []string
	}{
		{"two lines", []string{"boot", "ready"}},
		{"four lines", []string{"pulling image", "starting", "healthy", "serving"}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			ch := StreamLines(tt.lines)
			if ch == nil {
				t.Fatal("StreamLines returned a nil channel; create one with make(chan string)")
			}
			if cap(ch) != 0 {
				t.Errorf("cap(StreamLines(%q)) = %d, want 0 (an unbuffered channel)", tt.lines, cap(ch))
			}

			got := receiveAll(t, ch)
			if !slices.Equal(got, tt.lines) {
				t.Errorf("StreamLines(%q) sent %q, want %q", tt.lines, got, tt.lines)
			}
		})
	}
}
