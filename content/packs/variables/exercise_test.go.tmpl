package variables

import "testing"

func TestServiceLabel(t *testing.T) {
	if got := ServiceLabel("api", "production"); got != "production/api" {
		t.Errorf(`ServiceLabel("api", "production") = %q, want "production/api"`, got)
	}

	if got := ServiceLabel("worker", "staging"); got != "staging/worker" {
		t.Errorf(`ServiceLabel("worker", "staging") = %q, want "staging/worker"`, got)
	}
}

func TestImageRef(t *testing.T) {
	if got := ImageRef("ghcr.io/acme", "api", "v1.4.2"); got != "ghcr.io/acme/api:v1.4.2" {
		t.Errorf(`ImageRef("ghcr.io/acme", "api", "v1.4.2") = %q, want "ghcr.io/acme/api:v1.4.2"`, got)
	}

	if got := ImageRef("registry.internal", "worker", "latest"); got != "registry.internal/worker:latest" {
		t.Errorf(`ImageRef("registry.internal", "worker", "latest") = %q, want "registry.internal/worker:latest"`, got)
	}
}

func TestDeployPath(t *testing.T) {
	if got := DeployPath("production", "api"); got != "/v1/environments/production/services/api" {
		t.Errorf(`DeployPath("production", "api") = %q, want "/v1/environments/production/services/api"`, got)
	}

	if got := DeployPath("staging", "billing"); got != "/v1/environments/staging/services/billing" {
		t.Errorf(`DeployPath("staging", "billing") = %q, want "/v1/environments/staging/services/billing"`, got)
	}
}
