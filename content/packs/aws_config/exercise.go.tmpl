// StaticConfig returns an AWS config for region that uses the given access
// key ID and secret access key.
func StaticConfig(ctx context.Context, region, keyID, secret string) (aws.Config, error) {
	// TODO(1): Call config.LoadDefaultConfig with config.WithRegion and
	// config.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(...)).
	// Add the import "github.com/aws/aws-sdk-go-v2/credentials".
	return aws.Config{}, nil
}

// Settings says where to load AWS settings from.
type Settings struct {
	Profile         string // profile name, e.g. "staging"
	Region          string // region override; "" means use the profile's region
	ConfigFile      string // path to the shared config file
	CredentialsFile string // path to the shared credentials file
}

// Load returns the AWS config for s.Profile, read from s.ConfigFile and
// s.CredentialsFile. A non-empty s.Region overrides the profile's region.
func Load(ctx context.Context, s Settings) (aws.Config, error) {
	opts := []func(*config.LoadOptions) error{
		config.WithSharedConfigProfile(s.Profile),
	}
	// TODO(2): Add WithSharedConfigFiles and WithSharedCredentialsFiles to
	// opts, and append WithRegion only when s.Region is not "".
	return config.LoadDefaultConfig(ctx, opts...)
}

