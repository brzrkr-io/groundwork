package deploy

import "testing"

func TestRelease(t *testing.T) {
	if got := Release(" API ", "v1.4.2"); got != "api v1.4.2" {
		t.Errorf(`Release(" API ", "v1.4.2") = %q, want "api v1.4.2"`, got)
	}

	if got := Release("Billing", "v2.0.0"); got != "billing v2.0.0" {
		t.Errorf(`Release("Billing", "v2.0.0") = %q, want "billing v2.0.0"`, got)
	}

	if got := Release("worker", "v0.9.1"); got != "worker v0.9.1" {
		t.Errorf(`Release("worker", "v0.9.1") = %q, want "worker v0.9.1"`, got)
	}
}

func TestReplicasNeeded(t *testing.T) {
	if got := ReplicasNeeded(1000, 300); got != 4 {
		t.Errorf(`ReplicasNeeded(1000, 300) = %d, want 4`, got)
	}

	if got := ReplicasNeeded(900, 300); got != 3 {
		t.Errorf(`ReplicasNeeded(900, 300) = %d, want 3`, got)
	}

	if got := ReplicasNeeded(50, 300); got != 1 {
		t.Errorf(`ReplicasNeeded(50, 300) = %d, want 1`, got)
	}
}

func TestSummary(t *testing.T) {
	if got := Summary("api", "v1.4.2", "production", 3, 256); got != "api v1.4.2 -> production: 3 replicas x 256 MiB = 768 MiB" {
		t.Errorf(`Summary("api", "v1.4.2", "production", 3, 256) = %q, want "api v1.4.2 -> production: 3 replicas x 256 MiB = 768 MiB"`, got)
	}

	if got := Summary(" Worker ", "v0.9.1", "staging", 2, 512); got != "worker v0.9.1 -> staging: 2 replicas x 512 MiB = 1024 MiB" {
		t.Errorf(`Summary(" Worker ", "v0.9.1", "staging", 2, 512) = %q, want "worker v0.9.1 -> staging: 2 replicas x 512 MiB = 1024 MiB"`, got)
	}
}

func TestMonthlyCost(t *testing.T) {
	if got := MonthlyCost(3, 512, 4); got != "$6.00/month" {
		t.Errorf(`MonthlyCost(3, 512, 4) = %q, want "$6.00/month"`, got)
	}

	if got := MonthlyCost(4, 256, 3.5); got != "$3.50/month" {
		t.Errorf(`MonthlyCost(4, 256, 3.5) = %q, want "$3.50/month"`, got)
	}

	if got := MonthlyCost(10, 768, 2.2); got != "$16.50/month" {
		t.Errorf(`MonthlyCost(10, 768, 2.2) = %q, want "$16.50/month"`, got)
	}
}
