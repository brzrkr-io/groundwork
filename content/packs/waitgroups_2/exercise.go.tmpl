// Package fleet is the Groundwork exercise "WaitGroups: patching the fleet".
package fleet

import "sync"

// PatchAll patches every host at the same time and returns one error per
// host, in the same order as hosts. Hosts that patched fine get nil.
func PatchAll(hosts []string, patch func(host string) error) []error {
	errs := make([]error, len(hosts))
	var wg sync.WaitGroup
	wg.Add(len(hosts))
	for i, host := range hosts {
		go func() {
			// TODO(1): When patch fails, this goroutine returns without
			// calling wg.Done(), so wg.Wait() never returns. Fix it.
			if err := patch(host); err != nil {
				errs[i] = err
				return
			}
			wg.Done()
		}()
	}
	wg.Wait()
	return errs
}

// ChecksumAll computes the checksum of every file at the same time and
// returns them keyed by file name.
func ChecksumAll(files []string, sum func(file string) string) map[string]string {
	sums := make(map[string]string, len(files))
	for _, file := range files {
		// TODO(2): Compute every checksum at the same time. Fill a slice by
		// index in the goroutines, then build the map after waiting.
		sums[file] = sum(file)
	}
	return sums
}

