package server

import (
	"context"
	"fmt"
	"net"
	"net/http"
	"time"
)

// newHTTPServer returns an http.Server for s.Handler with production
// timeouts, so slow or stuck clients cannot hold connections forever.
func (s *Server) newHTTPServer() *http.Server {
	return &http.Server{
		Handler:           s.Handler(),
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      30 * time.Second,
		IdleTimeout:       60 * time.Second,
	}
}

// Run serves the API on ln until ctx is cancelled, then shuts down
// gracefully, giving in-flight requests up to grace to finish.
//
// It marks the server ready while serving and not ready once shutdown
// begins. It returns nil after a clean shutdown, the Serve error if serving
// fails, or the Shutdown error if the grace period runs out (after
// force-closing the remaining connections).
func (s *Server) Run(ctx context.Context, ln net.Listener, grace time.Duration) error {
	srv := s.newHTTPServer()

	// Buffered, so the goroutine can always send and exit, even after Run
	// has stopped listening on the channel.
	serveErr := make(chan error, 1)
	s.ready.Store(true)
	go func() { serveErr <- srv.Serve(ln) }()

	select {
	case err := <-serveErr:
		s.ready.Store(false)
		return err
	case <-ctx.Done():
	}

	s.ready.Store(false)
	s.logger.Info("shutting down", "grace", grace.String())

	// ctx is already cancelled, so the grace period needs a fresh context.
	shutdownCtx, cancel := context.WithTimeout(context.Background(), grace)
	defer cancel()
	if err := srv.Shutdown(shutdownCtx); err != nil {
		srv.Close()
		return fmt.Errorf("graceful shutdown: %w", err)
	}
	return nil
}
