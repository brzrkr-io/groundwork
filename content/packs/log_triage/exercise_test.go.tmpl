func TestCheckInput(t *testing.T) {
	expect(t, "testdata/incident.log: 30 lines\n", "1_check_input.sh", "testdata/incident.log")
	expect(t, "testdata/quiet.log: 6 lines\n", "1_check_input.sh", "testdata/quiet.log")
	expectExit(t, 1, "cannot read testdata/missing.log\n", "1_check_input.sh", "testdata/missing.log")
	expectExit(t, 1, "cannot read testdata\n", "1_check_input.sh", "testdata")
	expectExit(t, 2, "usage: 1_check_input.sh LOG\n", "1_check_input.sh")
	expectExit(t, 2, "usage: 1_check_input.sh LOG\n", "1_check_input.sh", "")
}

func TestLevels(t *testing.T) {
	expect(t, "ERROR: 7\nWARN: 5\nINFO: 18\n", "2_levels.sh", "testdata/incident.log")
	expect(t, "ERROR: 0\nWARN: 1\nINFO: 5\n", "2_levels.sh", "testdata/quiet.log")
	expect(t, "ERROR: 4\nWARN: 1\nINFO: 3\n", "2_levels.sh", "testdata/rollout.log")
}

func TestFailingServices(t *testing.T) {
	expect(t, "payments: 4\ncheckout: 2\nauth: 1\n", "3_failing_services.sh", "testdata/incident.log")
	expect(t, "worker: 3\napi: 1\n", "3_failing_services.sh", "testdata/rollout.log")
	expect(t, "", "3_failing_services.sh", "testdata/quiet.log")
}

func TestTriage(t *testing.T) {
	expect(t, `testdata/incident.log: 30 lines

== levels ==
ERROR: 7
WARN: 5
INFO: 18

== failing services ==
payments: 4
checkout: 2
auth: 1

== slowest requests ==
