// expect runs the script with bash in the exercise folder, just as you do
// in your terminal, and checks that it succeeds and prints want.
func expect(t *testing.T, want, script string, args ...string) {
	t.Helper()
	got, stderr, code := run(t, script, args...)
	command := commandLine(script, args...)
	if code != 0 {
		exitFailure(t, command, code, got, stderr)
		return
	}
	switch {
	case got == want:
		return
	case got == "":
		t.Errorf("%s printed nothing, want:\n%s", command, want)
	case strings.Count(want, "\n") > 1:
		t.Errorf("%s printed:\n%s\nwant:\n%s", command, got, want)
	default:
		t.Errorf("%s printed %q, want %q", command, got, want)
	}
	if stderr != "" {
		t.Errorf("%s also printed to stderr:\n%s", command, stderr)
	}
}

// exitFailure explains a script that stopped with a non-zero status: what it
// printed before it stopped, and what bash said on stderr.
func exitFailure(t *testing.T, command string, code int, stdout, stderr string) {
	t.Helper()
	msg := fmt.Sprintf("%s exited with status %d, want 0.", command, code)
	if stdout != "" {
		msg += "\nIt printed:\n" + strings.TrimRight(stdout, "\n")
	}
	if stderr != "" {
		msg += "\nbash said:\n" + stderr
	} else {
		msg += "\nbash said nothing: a command failed without a message, and set -e stopped the script there."
	}
	t.Error(msg)
}

// run runs "bash script args..." and returns what it printed to stdout and
// stderr, and its exit status.
func run(t *testing.T, script string, args ...string) (stdout, stderr string, code int) {
	t.Helper()
	cmd := exec.Command("bash", append([]string{script}, args...)...)
	cmd.Env = append(cmd.Environ(), "LC_ALL=C", "TZ=UTC")
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	if err := cmd.Run(); cmd.ProcessState == nil {
		t.Fatalf("could not start bash: %v", err)
	}
	return out.String(), errOut.String(), cmd.ProcessState.ExitCode()
}

// commandLine shows how to run the script by hand: bash, the script and its
// arguments, with quotes around any argument that is empty or has a space.
func commandLine(script string, args ...string) string {
	line := "bash " + script
	for _, arg := range args {
		if arg == "" || strings.Contains(arg, " ") {
			arg = `"` + arg + `"`
		}
		line += " " + arg
	}
	return line
}
