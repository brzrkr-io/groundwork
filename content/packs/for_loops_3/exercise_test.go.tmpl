package loops

import "testing"

func TestRolloutPlan(t *testing.T) {
	if got := RolloutPlan(7, 3); got != "1-3,4-6,7-7" {
		t.Errorf(`RolloutPlan(7, 3) = %q, want "1-3,4-6,7-7"`, got)
	}
	if got := RolloutPlan(4, 2); got != "1-2,3-4" {
		t.Errorf(`RolloutPlan(4, 2) = %q, want "1-2,3-4"`, got)
	}
	if got := RolloutPlan(2, 5); got != "1-2" {
		t.Errorf(`RolloutPlan(2, 5) = %q, want "1-2"`, got)
	}
	if got := RolloutPlan(10, 4); got != "1-4,5-8,9-10" {
		t.Errorf(`RolloutPlan(10, 4) = %q, want "1-4,5-8,9-10"`, got)
	}
	if got := RolloutPlan(0, 3); got != "" {
		t.Errorf(`RolloutPlan(0, 3) = %q, want ""`, got)
	}
}

func TestRetrySchedule(t *testing.T) {
	if got := RetrySchedule(5, 1, 8); got != "1s 2s 4s 8s 8s" {
		t.Errorf(`RetrySchedule(5, 1, 8) = %q, want "1s 2s 4s 8s 8s"`, got)
	}
	if got := RetrySchedule(4, 5, 12); got != "5s 10s 12s 12s" {
		t.Errorf(`RetrySchedule(4, 5, 12) = %q, want "5s 10s 12s 12s"`, got)
	}
	if got := RetrySchedule(2, 3, 100); got != "3s 6s" {
		t.Errorf(`RetrySchedule(2, 3, 100) = %q, want "3s 6s"`, got)
	}
	if got := RetrySchedule(0, 1, 8); got != "" {
		t.Errorf(`RetrySchedule(0, 1, 8) = %q, want ""`, got)
	}
}
