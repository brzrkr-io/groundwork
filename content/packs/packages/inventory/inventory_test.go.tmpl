package inventory

import "testing"

func TestAddress(t *testing.T) {
	tests := []struct {
		host string
		port int
		want string
	}{
		{"web-1", 8080, "web-1:8080"},
		{"db-2.internal", 5432, "db-2.internal:5432"},
	}
	for _, tt := range tests {
		t.Run(tt.want, func(t *testing.T) {
			if got := Address(tt.host, tt.port); got != tt.want {
				t.Errorf("Address(%q, %d) = %q, want %q", tt.host, tt.port, got, tt.want)
			}
		})
	}
}

func TestNormalizeHost(t *testing.T) {
	tests := []struct {
		name string
		want string
	}{
		{"web-1", "web-1"},
		{"  DB-2.Internal ", "db-2.internal"},
		{"CACHE-3", "cache-3"},
	}
	for _, tt := range tests {
		t.Run(tt.want, func(t *testing.T) {
			if got := NormalizeHost(tt.name); got != tt.want {
				t.Errorf("NormalizeHost(%q) = %q, want %q", tt.name, got, tt.want)
			}
		})
	}
}
