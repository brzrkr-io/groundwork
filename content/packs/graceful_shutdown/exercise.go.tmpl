// Package shutdown is the Groundwork exercise "Graceful shutdown: drain in-flight requests".
package shutdown

import (
	"context"
	"net"
	"net/http"
	"time"
)

// NewServer returns an HTTP server for h with production timeouts.
func NewServer(h http.Handler) *http.Server {
	// TODO(1): Set ReadHeaderTimeout, ReadTimeout, WriteTimeout and IdleTimeout.
	return &http.Server{
		Handler: h,
	}
}

// Run serves srv on ln until ctx is cancelled, then shuts srv down with Stop,
// giving in-flight requests up to grace to finish. It returns nil after a
// clean shutdown, Stop's error if the shutdown was forced, or Serve's error
// if serving failed before ctx was cancelled.
func Run(ctx context.Context, srv *http.Server, ln net.Listener, grace time.Duration) error {
	// TODO(2): Serve in a goroutine, then wait for ctx.Done() or a Serve error.
	return srv.Serve(ln)
}

// Stop shuts srv down gracefully: it stops accepting new connections and
// waits up to grace for in-flight requests. If they don't finish in time, it
// closes srv forcefully and returns an error.
func Stop(srv *http.Server, grace time.Duration) error {
	ctx, cancel := context.WithTimeout(context.Background(), grace)
	defer cancel()
	// TODO(3): If Shutdown fails, call srv.Close() and return the error wrapped as "forced shutdown: ...".
	return srv.Shutdown(ctx)
}
