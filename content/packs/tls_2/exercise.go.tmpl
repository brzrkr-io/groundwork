// Package tlscheck is the Groundwork exercise "TLS: stop skipping verification".
package tlscheck

import (
	"crypto/tls"
	"crypto/x509"
	"errors"
	"fmt"
	"net/http"
	"time"
)

// NewClient returns an HTTP client that trusts only the CA certificates in
// caPEM. It returns an error if caPEM holds no certificates.
func NewClient(caPEM []byte) (*http.Client, error) {
	// TODO(1): Stop skipping verification. Trust only the certificates in caPEM, and return an error if there are none.
	tlsConfig := &tls.Config{
		InsecureSkipVerify: true,
		MinVersion:         tls.VersionTLS12,
	}
	return &http.Client{
		Timeout:   5 * time.Second,
		Transport: &http.Transport{TLSClientConfig: tlsConfig},
	}, nil
}

// ExpiryStatus describes how soon cert expires: "EXPIRED on <date>",
// "WARN: expires in <n> days" when fewer than warnDays remain, or
// "OK: expires in <n> days".
func ExpiryStatus(cert *x509.Certificate, now time.Time, warnDays int) string {
	days := int(cert.NotAfter.Sub(now) / (24 * time.Hour))
	// TODO(2): Return the EXPIRED and WARN lines when they apply.
	return fmt.Sprintf("OK: expires in %d days", days)
}

// Diagnose turns a request error into a short label: "ok",
// "unknown authority", "hostname mismatch", "expired" or "other".
func Diagnose(err error) string {
	if err == nil {
		return "ok"
	}
	if _, ok := errors.AsType[x509.UnknownAuthorityError](err); ok {
		return "unknown authority"
	}
	// TODO(3): Return "hostname mismatch" and "expired" for the matching x509 errors.
	return "other"
}
