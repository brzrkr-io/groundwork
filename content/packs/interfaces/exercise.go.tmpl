// Package interfaces is the Groundwork exercise "Interfaces".
package interfaces

import "fmt"

// Alert describes a problem with one service.
type Alert struct {
	Service string
	Message string
}

// Notifier is anything that can send an alert somewhere. Notify returns the
// line it sent.
type Notifier interface {
	Notify(a Alert) string
}

// Slack sends alerts to a Slack channel.
type Slack struct {
	Channel string // the channel name without "#", like "ops"
}

// Notify formats a for Slack, like "slack #ops: [api] disk full".
func (s Slack) Notify(a Alert) string {
	// TODO(1): Add " [<Service>] <Message>" after the colon.
	return fmt.Sprintf("slack #%s:", s.Channel)
}

// Email sends alerts to an email address.
type Email struct {
	To string
}

// Notify formats a for email, like "email oncall@example.com: [api] disk full".
func (e Email) Notify(a Alert) string {
	// TODO(1): Return "email <To>: [<Service>] <Message>".
	return ""
}

