package text

import "testing"

func TestNormalizeHost(t *testing.T) {
	if got := NormalizeHost("  API-01.Prod.Example.COM\n"); got != "api-01.prod.example.com" {
		t.Errorf(`NormalizeHost("  API-01.Prod.Example.COM\n") = %q, want "api-01.prod.example.com"`, got)
	}

	if got := NormalizeHost("\tDB.internal "); got != "db.internal" {
		t.Errorf(`NormalizeHost("\tDB.internal ") = %q, want "db.internal"`, got)
	}

	if got := NormalizeHost("web-02.example.com"); got != "web-02.example.com" {
		t.Errorf(`NormalizeHost("web-02.example.com") = %q, want "web-02.example.com"`, got)
	}
}

func TestIsInternalImage(t *testing.T) {
	if got := IsInternalImage("registry.internal/api:v1.4.2"); got != true {
		t.Errorf(`IsInternalImage("registry.internal/api:v1.4.2") = %t, want true`, got)
	}

	if got := IsInternalImage("docker.io/library/nginx:1.27"); got != false {
		t.Errorf(`IsInternalImage("docker.io/library/nginx:1.27") = %t, want false`, got)
	}

	if got := IsInternalImage("registry.internal.evil.com/api:v1"); got != false {
		t.Errorf(`IsInternalImage("registry.internal.evil.com/api:v1") = %t, want false`, got)
	}
}

func TestHeading(t *testing.T) {
	if got := Heading("deploy api"); got != "DEPLOY API\n==========" {
		t.Errorf(`Heading("deploy api") = %q, want "DEPLOY API\n=========="`, got)
	}

	if got := Heading("rollback"); got != "ROLLBACK\n========" {
		t.Errorf(`Heading("rollback") = %q, want "ROLLBACK\n========"`, got)
	}
}
