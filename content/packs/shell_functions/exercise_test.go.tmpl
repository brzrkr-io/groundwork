func TestLog(t *testing.T) {
	expectStreams(t,
		"[INFO] deploy started: api\n[INFO] pulling image\n[INFO] deploy finished: api\n",
		"[ERROR] image pull slow, retrying\n",
		"1_log.sh", "api")
	expectStreams(t,
		"[INFO] deploy started: billing\n[INFO] pulling image\n[INFO] deploy finished: billing\n",
		"[ERROR] image pull slow, retrying\n",
		"1_log.sh", "billing")
}

func TestPorts(t *testing.T) {
	expect(t, "8080 ok\n0 invalid\n", "2_ports.sh", "8080", "0")
	expect(t, "1 ok\n443 ok\n65535 ok\n65536 invalid\n", "2_ports.sh", "1", "443", "65535", "65536")
}

func TestRelease(t *testing.T) {
	expect(t, ""+
		"deploy api -> registry.example.com/api:1.4.2\n"+
		"deploy worker -> registry.example.com/worker:1.4.2\n"+
		"deploy billing -> registry.example.com/billing:3.0.0\n",
		"3_release.sh", "testdata/release.txt")
	expect(t, "deploy payments -> registry.example.com/payments:2.0.2\n", "3_release.sh", "testdata/hotfix.txt")
}

func TestRequire(t *testing.T) {
	expect(t, "all tools found\n", "4_require.sh", "grep", "sed")
	expectExit(t, 1, "missing tool: kubectl-groundwork\n", "4_require.sh", "grep", "kubectl-groundwork", "sed")
}

// expectStreams runs the script and checks that it succeeds and prints
// wantStdout to stdout and wantStderr to stderr.
func expectStreams(t *testing.T, wantStdout, wantStderr, script string, args ...string) {
	t.Helper()
	stdout, stderr, code := run(t, script, args...)
	command := commandLine(script, args...)
	if code != 0 {
		exitFailure(t, command, code, stdout, stderr)
		return
	}
	if stdout != wantStdout {
		t.Errorf("%s printed to stdout:\n%s\nwant:\n%s", command, stdout, wantStdout)
	}
	if stderr != wantStderr {
		t.Errorf("%s printed %q to stderr, want %q", command, stderr, wantStderr)
	}
}

// expectExit runs the script and checks that it exits with status
// wantCode, prints wantStderr to stderr, and prints nothing to stdout.
func expectExit(t *testing.T, wantCode int, wantStderr, script string, args ...string) {
	t.Helper()
	stdout, stderr, code := run(t, script, args...)
	command := commandLine(script, args...)
	if code != wantCode {
		t.Errorf("%s exited with status %d, want %d. It printed %q to stdout and %q to stderr",
			command, code, wantCode, stdout, stderr)
		return
	}
	if stderr != wantStderr {
		t.Errorf("%s printed %q to stderr, want %q", command, stderr, wantStderr)
	}
	if stdout != "" {
		t.Errorf("%s printed %q to stdout, want nothing there", command, stdout)
	}
}

// expect runs the script with bash in the exercise folder, just as you do
// in your terminal, and checks that it succeeds and prints want.
func expect(t *testing.T, want, script string, args ...string) {
	t.Helper()
	got, stderr, code := run(t, script, args...)
	command := commandLine(script, args...)
	if code != 0 {
		exitFailure(t, command, code, got, stderr)
		return
	}
	switch {
	case got == want:
		return
	case got == "":
		t.Errorf("%s printed nothing, want:\n%s", command, want)
	case strings.Count(want, "\n") > 1:
		t.Errorf("%s printed:\n%s\nwant:\n%s", command, got, want)
	default:
		t.Errorf("%s printed %q, want %q", command, got, want)
	}
	if stderr != "" {
		t.Errorf("%s also printed to stderr:\n%s", command, stderr)
	}
}

// exitFailure explains a script that stopped with a non-zero status: what it
// printed before it stopped, and what bash said on stderr.
func exitFailure(t *testing.T, command string, code int, stdout, stderr string) {
	t.Helper()
	msg := fmt.Sprintf("%s exited with status %d, want 0.", command, code)
	if stdout != "" {
		msg += "\nIt printed:\n" + strings.TrimRight(stdout, "\n")
	}
	if stderr != "" {
		msg += "\nbash said:\n" + stderr
	} else {
		msg += "\nbash said nothing: a command failed without a message " +
			"(a false [[ ]] test, or a function whose last test was false), and set -e stopped the script there. " +
			"Run " + strings.Replace(command, "bash ", "bash -x ", 1) + " to see which command it was."
	}
	t.Error(msg)
}

// run runs "bash script args..." and returns what it printed to stdout and
// stderr, and its exit status.
func run(t *testing.T, script string, args ...string) (stdout, stderr string, code int) {
	t.Helper()
	cmd := exec.Command("bash", append([]string{script}, args...)...)
	cmd.Env = append(cmd.Environ(), "LC_ALL=C", "TZ=UTC")
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	if err := cmd.Run(); cmd.ProcessState == nil {
		t.Fatalf("could not start bash: %v", err)
	}
	return out.String(), errOut.String(), cmd.ProcessState.ExitCode()
}

// commandLine shows how to run the script by hand: bash, the script and its
// arguments, with quotes around any argument that is empty or has a space.
func commandLine(script string, args ...string) string {
	line := "bash " + script
	for _, arg := range args {
		if arg == "" || strings.Contains(arg, " ") {
			arg = `"` + arg + `"`
		}
		line += " " + arg
	}
	return line
}
