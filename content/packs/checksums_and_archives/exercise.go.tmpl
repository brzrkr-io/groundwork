// Extract unpacks the .tar.gz stream r into the directory dst.
func Extract(r io.Reader, dst string) error {
	gz, err := gzip.NewReader(r)
	if err != nil {
		return err
	}
	defer gz.Close()

	tr := tar.NewReader(gz)
	for {
		hdr, err := tr.Next()
		if err == io.EOF {
			return nil // no more entries: the archive is done
		}
		if err != nil {
			return err
		}
		if err := extractEntry(tr, hdr, dst); err != nil {
			return err
		}
	}
}

// extractEntry writes one archive entry under dst. For a regular file, tr
// is positioned at the file's contents, so reading from tr reads the file.
func extractEntry(tr *tar.Reader, hdr *tar.Header, dst string) error {
	// TODO(3): Bug: this writes every entry as a file, wherever its name
	// points. Reject unsafe names, create directories, create a regular
	// file's parent directory before writing it, and skip every other type.
	target := filepath.Join(dst, hdr.Name)
	return writeFile(target, tr, hdr.FileInfo().Mode().Perm())
}

// writeFile creates the file at path with permission bits perm and copies
// everything from r into it.
func writeFile(path string, r io.Reader, perm fs.FileMode) error {
	f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, perm)
	if err != nil {
		return err
	}
	if _, err := io.Copy(f, r); err != nil {
		f.Close()
		return err
	}
	return f.Close()
}

// Create writes the directory tree rooted at dir to w as a .tar.gz archive.
// Entry names are relative to dir and use forward slashes, as tar requires.
// Read it as a worked example: it is the mirror image of Extract.
func Create(dir string, w io.Writer) error {
	// Layer the writers: tar entries -> gzip compression -> w.
	gz := gzip.NewWriter(w)
	tw := tar.NewWriter(gz)

	err := filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		rel, err := filepath.Rel(dir, path)
		if err != nil {
			return err
		}
		if rel == "." {
			return nil // the root itself gets no entry
		}
		info, err := d.Info()
		if err != nil {
			return err
		}
		if !info.IsDir() && !info.Mode().IsRegular() {
			return nil // skip symlinks, sockets and other special files
		}

		// FileInfoHeader fills in the type, size, mode and modification time.
		hdr, err := tar.FileInfoHeader(info, "")
		if err != nil {
			return err
		}
		// It only knows the base name, so set the full relative name.
		hdr.Name = filepath.ToSlash(rel)
		if info.IsDir() {
			hdr.Name += "/" // tar marks directories with a trailing slash
		}
		if err := tw.WriteHeader(hdr); err != nil {
			return err
		}
		if info.IsDir() {
			return nil // directories have a header but no contents
		}

		// After WriteHeader, writes to tw become the file's contents.
		f, err := os.Open(path)
		if err != nil {
			return err
		}
		defer f.Close()
		_, err = io.Copy(tw, f)
		return err
	})
	if err != nil {
		return err
	}

	// Close the inner writer first: tar writes its end-of-archive marker
	// into gzip, then gzip flushes and writes its own trailer to w.
	if err := tw.Close(); err != nil {
		return err
	}
	return gz.Close()
}
