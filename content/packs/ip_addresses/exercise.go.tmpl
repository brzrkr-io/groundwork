// Package ipaddr is the Groundwork exercise "IP addresses: classify, allowlist, overlap".
package ipaddr

import "net/netip"

// Classify returns "FAMILY KIND" for the address s, for example
// "ipv4 private" or "ipv6 loopback".
func Classify(s string) (string, error) {
	addr, err := netip.ParseAddr(s)
	if err != nil {
		return "", err
	}

	family := "ipv4"
	if addr.Is6() {
		family = "ipv6"
	}

	// TODO(1): Set kind to "loopback", "private" or "public".
	kind := "public"

	return family + " " + kind, nil
}

