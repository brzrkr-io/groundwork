// Package maintenance is the Groundwork exercise "Goroutines: fix the maintenance script".
package maintenance

import "sync"

// DrainNodes drains every node at the same time and returns once all of the
// drains have finished.
func DrainNodes(nodes []string, drain func(node string)) {
	var wg sync.WaitGroup
	for _, node := range nodes {
		wg.Go(func() {
			drain(node)
		})
		// TODO(1): This waits for each drain before starting the next one.
		// Move it so that all the drains run at the same time.
		wg.Wait()
	}
}

// PingAll pings every host at the same time and returns the answers in the
// same order as hosts.
func PingAll(hosts []string, ping func(host string) bool) []bool {
	results := make([]bool, len(hosts))
	for i, host := range hosts {
		// TODO(2): Run each ping in its own goroutine, and wait for all of
		// them to finish before returning.
		results[i] = ping(host)
	}
	return results
}
