package server

import (
	"encoding/json"
	"errors"
	"net/http"

	"gopherlings.local/inventory_service/internal/hosts"
)

// writeJSON sends v as a JSON body with the given status code.
func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	json.NewEncoder(w).Encode(v)
}

// writeError sends {"error": msg} with the given status code.
func writeError(w http.ResponseWriter, status int, msg string) {
	writeJSON(w, status, map[string]string{"error": msg})
}

// writeStoreError turns an error from the store into a response:
//
//	hosts.ErrNotFound  404  {"error":"host not found"}
//	hosts.ErrInvalid   400  {"error":"invalid host: <reason>"}
//	anything else      500  {"error":"internal error"}
func writeStoreError(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, hosts.ErrNotFound):
		writeError(w, http.StatusNotFound, err.Error())
	case errors.Is(err, hosts.ErrInvalid):
		writeError(w, http.StatusBadRequest, err.Error())
	default:
		writeError(w, http.StatusInternalServerError, "internal error")
	}
}

// handleList serves GET /hosts: 200 with a JSON array of hosts.
func (s *Server) handleList(w http.ResponseWriter, r *http.Request) {
	writeJSON(w, http.StatusOK, s.store.List())
}

// handleGet serves GET /hosts/{id}: 200 with the host, or 404.
func (s *Server) handleGet(w http.ResponseWriter, r *http.Request) {
	h, err := s.store.Get(r.PathValue("id"))
	if err != nil {
		writeStoreError(w, err)
		return
	}
	writeJSON(w, http.StatusOK, h)
}

