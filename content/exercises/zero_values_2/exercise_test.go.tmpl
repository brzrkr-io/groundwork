package zerovalues

import "testing"

func TestLogPath(t *testing.T) {
	// Each line is one case: the input, then the answer we want.
	tests := []struct {
		path string
		want string
	}{
		{"", "/var/log/app.log"},
		{"/var/log/api.log", "/var/log/api.log"},
		{"/tmp/debug.log", "/tmp/debug.log"},
	}
	for _, tt := range tests {
		t.Run(tt.want, func(t *testing.T) {
			if got := LogPath(tt.path); got != tt.want {
				t.Errorf("LogPath(%q) = %q, want %q", tt.path, got, tt.want)
			}
		})
	}
}

func TestSampleRate(t *testing.T) {
	// Each line is one case: the input, then the answer we want.
	tests := []struct {
		rate float64
		want float64
	}{
		{0, 0.1},
		{0.5, 0.5},
		{1, 1},
	}
	for _, tt := range tests {
		t.Run("", func(t *testing.T) {
			if got := SampleRate(tt.rate); got != tt.want {
				t.Errorf("SampleRate(%v) = %v, want %v", tt.rate, got, tt.want)
			}
		})
	}
}

func TestRotationSummary(t *testing.T) {
	// Each line is one case: the inputs, then the answer we want.
	tests := []struct {
		path       string
		maxSizeMiB int
		keepFiles  int
		want       string
	}{
		{"", 0, 0, "rotate /var/log/app.log at 100MiB, keep 5"},
		{"/var/log/api.log", 50, 10, "rotate /var/log/api.log at 50MiB, keep 10"},
		{"", 20, 0, "rotate /var/log/app.log at 20MiB, keep 5"},
		{"/var/log/db.log", 0, 3, "rotate /var/log/db.log at 100MiB, keep 3"},
	}
	for _, tt := range tests {
		t.Run(tt.want, func(t *testing.T) {
			if got := RotationSummary(tt.path, tt.maxSizeMiB, tt.keepFiles); got != tt.want {
				t.Errorf("RotationSummary(%q, %d, %d) = %q, want %q", tt.path, tt.maxSizeMiB, tt.keepFiles, got, tt.want)
			}
		})
	}
}
