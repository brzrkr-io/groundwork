// Package jsonapi is the Gopherlings exercise "JSON APIs: build a service catalog".
package jsonapi

import "net/http"

// API serves the service catalog over HTTP.
type API struct {
	store *Store
}

// NewAPI returns an API backed by store.
func NewAPI(store *Store) *API {
	return &API{store: store}
}

// Routes returns a handler with every endpoint registered.
func (a *API) Routes() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /services/{name}", a.handleGet)
	mux.HandleFunc("POST /services", a.handleCreate)
	return mux
}

