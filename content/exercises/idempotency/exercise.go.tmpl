// Response is a captured HTTP response: everything needed to send it again.
type Response struct {
	Status int
	Header http.Header
	Body   []byte
}

// Store remembers responses by idempotency key. It is safe for concurrent use.
type Store struct {
	mu         sync.Mutex
	responses  map[string]Response // finished requests
	inProgress map[string]bool     // keys whose first request is still running
}

// NewStore returns an empty Store.
func NewStore() *Store {
	return &Store{
		responses:  map[string]Response{},
		inProgress: map[string]bool{},
	}
}

