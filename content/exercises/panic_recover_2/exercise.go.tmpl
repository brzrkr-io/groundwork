// Package recovery2 is the Gopherlings exercise "panic and recover: fix the chat bot's safety net".
package recovery2

import "fmt"

// Alert is one firing alert from the monitoring system.
type Alert struct {
	Name     string
	Severity string
}

// Guard runs the handler for one chat command. If the handler panics, Guard
// returns an error instead, so the bot stays online.
func Guard(command string, handler func() error) error {
	var err error
	// TODO(1): This recover never stops a panic. Move it into a deferred function.
	// TODO(2): The error set after a panic gets lost. Make err a named result.
	if r := recover(); r != nil {
		err = fmt.Errorf("command %q panicked: %v", command, r)
	}
	err = handler()
	return err
}

// CountBySeverity counts the alerts for each severity, such as "critical"
// or "warning".
func CountBySeverity(alerts []Alert) map[string]int {
	// TODO(3): Remove this recover and fix the bug it hides.
	defer func() {
		recover()
	}()

	var counts map[string]int
	for _, a := range alerts {
		counts[a.Severity]++
	}
	return counts
}
