func TestBackoffDelay(t *testing.T) {
	tests := []struct {
		attempt int
		want    time.Duration
	}{
		{0, 500 * time.Millisecond},
		{1, time.Second},
		{3, 4 * time.Second},
		{5, 16 * time.Second},
		{6, 30 * time.Second},
		{20, 30 * time.Second},
	}
	for _, tc := range tests {
		if got := BackoffDelay(tc.attempt); got != tc.want {
			t.Errorf("BackoffDelay(%d) = %v, want %v", tc.attempt, got, tc.want)
		}
	}
	checkRenamed(t, parseExercise(t), "delay", "delayMillis")
}

func TestServingCount(t *testing.T) {
	nodes := []Node{
		{"web-1", true},
		{"web-2", false},
		{"web-3", true},
		{"web-4", true},
	}
	if got := ServingCount(nodes); got != 3 {
		t.Errorf("ServingCount(web-1 healthy, web-2 unhealthy, web-3 healthy, web-4 healthy) = %d, want 3", got)
	}
	allDown := []Node{{"web-1", false}, {"web-2", false}}
	if got := ServingCount(allDown); got != 0 {
		t.Errorf("ServingCount(web-1 unhealthy, web-2 unhealthy) = %d, want 0", got)
	}
	if got, want := DrainList(nodes), []string{"web-2"}; !slices.Equal(got, want) {
		t.Errorf("DrainList(web-1 healthy, web-2 unhealthy, web-3 healthy, web-4 healthy) = %q, want %q", got, want)
	}
	checkRenamed(t, parseExercise(t), "filterHealthy", "unhealthyNodes")
}

func TestPageTargets(t *testing.T) {
	owners := map[string]string{"api": "payments", "db": "data"}
	before := maps.Clone(owners)

	got := PageTargets(owners, []string{"api", "cache", "db", "queue"})
	want := []string{"payments", "platform", "data", "platform"}
	if !slices.Equal(got, want) {
		t.Errorf("PageTargets(owners, api cache db queue) = %q, want %q", got, want)
	}
	if !maps.Equal(owners, before) {
		t.Errorf("after PageTargets, owners = %v, want it unchanged: %v; looking up an owner must not add one", owners, before)
	}
}
