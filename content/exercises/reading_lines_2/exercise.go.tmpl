// Package logscan is the Gopherlings exercise "Reading input line by line: scanning logs".
package logscan

import (
	"bufio"
	"io"
	"strings"
)

// FindPanics returns the 1-based line numbers of the lines in r that contain
// "panic:".
func FindPanics(r io.Reader) ([]int, error) {
	// TODO(1): Fix the off-by-one line numbers and return read errors.
	sc := bufio.NewScanner(r)
	var found []int
	lineNo := 0
	for sc.Scan() {
		if strings.Contains(sc.Text(), "panic:") {
			found = append(found, lineNo)
		}
		lineNo++
	}
	return found, nil
}

