// Package errvalues2 is the Gopherlings exercise "Errors are values: fix the replica scaler".
package errvalues2

import (
	"errors"
	"fmt"
	"strconv"
)

// ParseReplicas converts text like "4" into a replica count of 0 or more.
func ParseReplicas(s string) (int, error) {
	// TODO(1): Don't ignore the error from strconv.Atoi.
	n, _ := strconv.Atoi(s)
	if n < 0 {
		// TODO(2): Return 0 and a well-styled error message.
		return n, errors.New("Replicas must not be negative!")
	}
	return n, nil
}

// Scale describes scaling a service from current replicas to the count in input.
func Scale(current int, input string) (string, error) {
	n, err := ParseReplicas(input)
	if err != nil {
		// TODO(3): Return early instead of carrying on.
		err = fmt.Errorf("scale: %v", err)
	}
	if n == current {
		return fmt.Sprintf("already at %d replicas", n), err
	}
	return fmt.Sprintf("scaled from %d to %d replicas", current, n), err
}
