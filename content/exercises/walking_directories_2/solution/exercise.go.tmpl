// Package diskwalk is the Gopherlings exercise "Walking directories: fix the backup cleaner".
package diskwalk

import (
	"io/fs"
	"path/filepath"
	"slices"
	"strings"
	"time"
)

// StaleFiles returns the files under root that are more than maxAge old at
// time now, as sorted slash-separated paths relative to root. Directories
// named "pinned" are skipped.
func StaleFiles(root string, now time.Time, maxAge time.Duration) ([]string, error) {
	var stale []string
	err := filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if d.IsDir() {
			if d.Name() == "pinned" {
				return fs.SkipDir
			}
			return nil
		}
		info, err := d.Info()
		if err != nil {
			return err
		}
		if now.Sub(info.ModTime()) <= maxAge {
			return nil
		}
		rel, err := filepath.Rel(root, p)
		if err != nil {
			return err
		}
		stale = append(stale, filepath.ToSlash(rel))
		return nil
	})
	if err != nil {
		return nil, err
	}
	slices.Sort(stale)
	return stale, nil
}

// DirSizes returns the total size in bytes of the files inside each
// top-level directory under root. Files directly in root count under ".".
func DirSizes(root string) (map[string]int64, error) {
	sizes := make(map[string]int64)
	err := filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if d.IsDir() {
			return nil
		}
		info, err := d.Info()
		if err != nil {
			return err
		}
		rel, err := filepath.Rel(root, p)
		if err != nil {
			return err
		}
		top, _, found := strings.Cut(filepath.ToSlash(rel), "/")
		if !found {
			top = "." // the file sits directly in root
		}
		sizes[top] += info.Size()
		return nil
	})
	if err != nil {
		return nil, err
	}
	return sizes, nil
}
