// Package switches is the Groundwork exercise "Switch: container supervisor".
package switches

// PortService names the service usually found on a port.
func PortService(port int) string {
	switch port {
	case 22:
		return "ssh"
	case 80, 8080:
		return "http"
	case 443, 8443:
		return "https"
	case 5432:
		return "postgres"
	case 6379:
		return "redis"
	default:
		if port < 1024 {
			return "system"
		}
		return "unknown"
	}
}

// ContainerAction decides what the supervisor does with a container.
func ContainerAction(state string, exitCode, restarts int) string {
	switch state {
	case "running":
		return "none"
	case "exited":
		switch {
		case exitCode == 0:
			return "none"
		case restarts >= 5:
			return "give up"
		default:
			return "restart"
		}
	case "oomkilled":
		return "add memory"
	default:
		return "inspect"
	}
}
