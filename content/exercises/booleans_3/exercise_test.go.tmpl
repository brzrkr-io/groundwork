package booleans

import "testing"

func TestShouldScaleUp(t *testing.T) {
	if !ShouldScaleUp(90, 3, 10, false) {
		t.Errorf("ShouldScaleUp(90, 3, 10, false) = false, want true")
	}
	if !ShouldScaleUp(76, 9, 10, false) {
		t.Errorf("ShouldScaleUp(76, 9, 10, false) = false, want true")
	}
	if ShouldScaleUp(75, 3, 10, false) {
		t.Errorf("ShouldScaleUp(75, 3, 10, false) = true, want false")
	}
	if ShouldScaleUp(40, 3, 10, false) {
		t.Errorf("ShouldScaleUp(40, 3, 10, false) = true, want false")
	}
	if ShouldScaleUp(90, 10, 10, false) {
		t.Errorf("ShouldScaleUp(90, 10, 10, false) = true, want false")
	}
	if ShouldScaleUp(90, 3, 10, true) {
		t.Errorf("ShouldScaleUp(90, 3, 10, true) = true, want false")
	}
}

func TestShouldScaleDown(t *testing.T) {
	if !ShouldScaleDown(10, 5, 2, false) {
		t.Errorf("ShouldScaleDown(10, 5, 2, false) = false, want true")
	}
	if !ShouldScaleDown(24, 3, 2, false) {
		t.Errorf("ShouldScaleDown(24, 3, 2, false) = false, want true")
	}
	if ShouldScaleDown(25, 5, 2, false) {
		t.Errorf("ShouldScaleDown(25, 5, 2, false) = true, want false")
	}
	if ShouldScaleDown(80, 5, 2, false) {
		t.Errorf("ShouldScaleDown(80, 5, 2, false) = true, want false")
	}
	if ShouldScaleDown(10, 2, 2, false) {
		t.Errorf("ShouldScaleDown(10, 2, 2, false) = true, want false")
	}
	if ShouldScaleDown(10, 5, 2, true) {
		t.Errorf("ShouldScaleDown(10, 5, 2, true) = true, want false")
	}
}

func TestIsStable(t *testing.T) {
	if !IsStable(50, 3, 2, 10, false) {
		t.Errorf("IsStable(50, 3, 2, 10, false) = false, want true")
	}
	if IsStable(90, 3, 2, 10, false) {
		t.Errorf("IsStable(90, 3, 2, 10, false) = true, want false")
	}
	if IsStable(10, 5, 2, 10, false) {
		t.Errorf("IsStable(10, 5, 2, 10, false) = true, want false")
	}
	if !IsStable(90, 10, 2, 10, false) {
		t.Errorf("IsStable(90, 10, 2, 10, false) = false, want true")
	}
	if !IsStable(10, 2, 2, 10, false) {
		t.Errorf("IsStable(10, 2, 2, 10, false) = false, want true")
	}
	if !IsStable(90, 3, 2, 10, true) {
		t.Errorf("IsStable(90, 3, 2, 10, true) = false, want true")
	}
}
