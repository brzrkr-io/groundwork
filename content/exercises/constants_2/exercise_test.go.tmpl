package constants

import "testing"

func TestHealthPort(t *testing.T) {
	if got := HealthPort(); got != 8081 {
		t.Errorf("HealthPort() = %d, want 8081", got)
	}
}

func TestHealthURL(t *testing.T) {
	if got := HealthURL("api.internal"); got != "http://api.internal/healthz" {
		t.Errorf(`HealthURL("api.internal") = %q, want "http://api.internal/healthz"`, got)
	}

	if got := HealthURL("10.0.3.17"); got != "http://10.0.3.17/healthz" {
		t.Errorf(`HealthURL("10.0.3.17") = %q, want "http://10.0.3.17/healthz"`, got)
	}
}

func TestDownAfterSeconds(t *testing.T) {
	if DownAfterSeconds != 30 {
		t.Errorf("DownAfterSeconds = %d, want 30", DownAfterSeconds)
	}
}
