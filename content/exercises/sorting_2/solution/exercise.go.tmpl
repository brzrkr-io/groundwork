// Package nodes is the Gopherlings exercise "Sorting: fix the node report".
package nodes

import (
	"cmp"
	"maps"
	"slices"
)

// SortedNodes returns a copy of nodes in alphabetical order. The caller's
// slice keeps its original order.
func SortedNodes(nodes []string) []string {
	out := slices.Clone(nodes)
	slices.Sort(out)
	return out
}

// FullestFirst returns the node names in usage, highest disk usage first.
// Nodes with the same usage are in alphabetical order.
func FullestFirst(usage map[string]int) []string {
	names := slices.Sorted(maps.Keys(usage))
	slices.SortFunc(names, func(a, b string) int {
		if c := cmp.Compare(usage[b], usage[a]); c != 0 {
			return c
		}
		return cmp.Compare(a, b)
	})
	return names
}

// LeastBusy returns a copy of nodes ordered by pod count, fewest pods first.
// Nodes with the same pod count are in alphabetical order.
func LeastBusy(nodes []string, pods map[string]int) []string {
	out := slices.Clone(nodes)
	slices.SortFunc(out, func(a, b string) int {
		if c := cmp.Compare(pods[a], pods[b]); c != 0 {
			return c
		}
		return cmp.Compare(a, b)
	})
	return out
}
