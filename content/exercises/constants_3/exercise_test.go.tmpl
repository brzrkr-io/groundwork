package constants

import "testing"

func TestRunInstancesCommand(t *testing.T) {
	if got := RunInstancesCommand("ami-0abc1234"); got != "aws ec2 run-instances --region eu-west-1 --instance-type t3.small --image-id ami-0abc1234" {
		t.Errorf(`RunInstancesCommand("ami-0abc1234") = %q, want "aws ec2 run-instances --region eu-west-1 --instance-type t3.small --image-id ami-0abc1234"`, got)
	}

	if got := RunInstancesCommand("ami-09f8e7d6"); got != "aws ec2 run-instances --region eu-west-1 --instance-type t3.small --image-id ami-09f8e7d6" {
		t.Errorf(`RunInstancesCommand("ami-09f8e7d6") = %q, want "aws ec2 run-instances --region eu-west-1 --instance-type t3.small --image-id ami-09f8e7d6"`, got)
	}
}

func TestTerminateCommand(t *testing.T) {
	if got := TerminateCommand("i-0abc1234"); got != "aws ec2 terminate-instances --region eu-west-1 --instance-ids i-0abc1234" {
		t.Errorf(`TerminateCommand("i-0abc1234") = %q, want "aws ec2 terminate-instances --region eu-west-1 --instance-ids i-0abc1234"`, got)
	}

	if got := TerminateCommand("i-0fedcba9"); got != "aws ec2 terminate-instances --region eu-west-1 --instance-ids i-0fedcba9" {
		t.Errorf(`TerminateCommand("i-0fedcba9") = %q, want "aws ec2 terminate-instances --region eu-west-1 --instance-ids i-0fedcba9"`, got)
	}
}

func TestConsoleURL(t *testing.T) {
	if got := ConsoleURL("i-0abc1234"); got != "https://eu-west-1.console.aws.amazon.com/ec2/home?region=eu-west-1#InstanceDetails:instanceId=i-0abc1234" {
		t.Errorf(`ConsoleURL("i-0abc1234") = %q, want "https://eu-west-1.console.aws.amazon.com/ec2/home?region=eu-west-1#InstanceDetails:instanceId=i-0abc1234"`, got)
	}

	if got := ConsoleURL("i-0fedcba9"); got != "https://eu-west-1.console.aws.amazon.com/ec2/home?region=eu-west-1#InstanceDetails:instanceId=i-0fedcba9" {
		t.Errorf(`ConsoleURL("i-0fedcba9") = %q, want "https://eu-west-1.console.aws.amazon.com/ec2/home?region=eu-west-1#InstanceDetails:instanceId=i-0fedcba9"`, got)
	}
}
