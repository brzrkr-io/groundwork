package constants

import "testing"

func TestRunInstancesCommand(t *testing.T) {
	tests := []struct {
		name    string
		imageID string
		want    string
	}{
		{name: "first image", imageID: "ami-0abc1234", want: "aws ec2 run-instances --region eu-west-1 --instance-type t3.small --image-id ami-0abc1234"},
		{name: "second image", imageID: "ami-09f8e7d6", want: "aws ec2 run-instances --region eu-west-1 --instance-type t3.small --image-id ami-09f8e7d6"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := RunInstancesCommand(tt.imageID)
			if got != tt.want {
				t.Errorf("RunInstancesCommand(%q) = %q, want %q", tt.imageID, got, tt.want)
			}
		})
	}
}

