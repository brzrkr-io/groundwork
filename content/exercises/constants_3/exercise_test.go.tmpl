func TestConsoleURL(t *testing.T) {
	tests := []struct {
		name       string
		instanceID string
		want       string
	}{
		{name: "first instance", instanceID: "i-0abc1234", want: "https://eu-west-1.console.aws.amazon.com/ec2/home?region=eu-west-1#InstanceDetails:instanceId=i-0abc1234"},
		{name: "second instance", instanceID: "i-0fedcba9", want: "https://eu-west-1.console.aws.amazon.com/ec2/home?region=eu-west-1#InstanceDetails:instanceId=i-0fedcba9"},
