// Package constants is the Gopherlings exercise "Constants: write your own config block".
package constants

// AWS settings shared by every command.
const (
	// Region is the AWS region every instance runs in.
	Region = "eu-west-1"
	// InstanceType is the size of every instance.
	InstanceType = "t3.small"
)

// RunInstancesCommand returns the AWS CLI command that launches one instance
// from the given machine image.
func RunInstancesCommand(imageID string) string {
	return "aws ec2 run-instances --region " + Region + " --instance-type " + InstanceType + " --image-id " + imageID
}

// TerminateCommand returns the AWS CLI command that terminates an instance.
func TerminateCommand(instanceID string) string {
	return "aws ec2 terminate-instances --region " + Region + " --instance-ids " + instanceID
}

// ConsoleURL returns the AWS console page for an instance.
func ConsoleURL(instanceID string) string {
	return "https://" + Region + ".console.aws.amazon.com/ec2/home?region=" + Region +
		"#InstanceDetails:instanceId=" + instanceID
}
