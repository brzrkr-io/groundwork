func TestSetImageTag(t *testing.T) {
	deploy := readFile(t, "testdata/deploy.yaml")
	old := "image: registry.example.com/api:1.4.1"

	want := strings.Replace(deploy, old, "image: registry.example.com/api:1.5.0", 1)
	expect(t, want, "1_set_image_tag.sh", "1.5.0")

	want = strings.Replace(deploy, old, "image: registry.example.com/api:2.0.0-rc.1", 1)
	expect(t, want, "1_set_image_tag.sh", "2.0.0-rc.1")
}

func TestRedactSecrets(t *testing.T) {
	want := strings.NewReplacer(
		"DB_PASSWORD=s3cr3t-Pa55", "DB_PASSWORD=REDACTED",
		"STRIPE_API_TOKEN=tok_live_51HxQ", "STRIPE_API_TOKEN=REDACTED",
		"SLACK_TOKEN=xoxb-1234-abcd", "SLACK_TOKEN=REDACTED",
	).Replace(readFile(t, "testdata/app.env"))
	expect(t, want, "2_redact_secrets.sh", "testdata/app.env")

	want = strings.NewReplacer(
		"QUEUE_PASSWORD=rabbit-Ears-77", "QUEUE_PASSWORD=REDACTED",
		"METRICS_TOKEN=bXQtOWY4ZTdk==", "METRICS_TOKEN=REDACTED",
	).Replace(readFile(t, "testdata/worker.env"))
	expect(t, want, "2_redact_secrets.sh", "testdata/worker.env")
}

