func TestSetLogLevel(t *testing.T) {
	expectEdit(t, "testdata/app.env", "debug")
	expectEdit(t, "testdata/worker.env", "warn")
}

// expectEdit does what the README shows: cp fixture copy.env, then
// bash 4_set_log_level.sh copy.env level. It checks that only the LOG_LEVEL
// line of copy.env changed.
func expectEdit(t *testing.T, fixture, level string) {
	t.Helper()
	dir := workdir(t)
	original := readFile(t, fixture)
	if err := os.WriteFile(filepath.Join(dir, "copy.env"), []byte(original), 0o644); err != nil {
		t.Fatal(err)
	}
	stdout, stderr, code := run(t, dir, "4_set_log_level.sh", "copy.env", level)
	command := commandLine("4_set_log_level.sh", "copy.env", level)
	if code != 0 {
		exitFailure(t, command, code, stdout, stderr)
		return
	}
	want := strings.Replace(original, "\nLOG_LEVEL=info\n", "\nLOG_LEVEL="+level+"\n", 1)
	if got := readFile(t, filepath.Join(dir, "copy.env")); got != want {
		t.Errorf("%s (copy.env is a copy of %s) left copy.env holding:\n%s\nwant:\n%s", command, fixture, got, want)
	}
}

// readFile returns the contents of a file, or stops the test if it can't.
func readFile(t *testing.T, path string) string {
	t.Helper()
	data, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	return string(data)
}

// expect runs the script with bash, just as you do in your terminal, and
// checks that it succeeds, prints want, and leaves testdata/ as it was.
func expect(t *testing.T, want, script string, args ...string) {
	t.Helper()
	dir := workdir(t)
	got, stderr, code := run(t, dir, script, args...)
	command := commandLine(script, args...)
	for _, name := range fixtures {
		if readFile(t, filepath.Join(dir, name)) != readFile(t, name) {
			t.Errorf("%s changed %s, want it unchanged. This script only prints; leave out -i.", command, name)
		}
	}
	if code != 0 {
		exitFailure(t, command, code, got, stderr)
		return
	}
	switch {
	case got == want:
		return
	case got == "":
		t.Errorf("%s printed nothing, want:\n%s", command, want)
	case strings.Count(want, "\n") > 1:
		t.Errorf("%s printed:\n%s\nwant:\n%s", command, got, want)
	default:
		t.Errorf("%s printed %q, want %q", command, got, want)
	}
	if stderr != "" {
		t.Errorf("%s also printed to stderr:\n%s", command, stderr)
	}
}

// fixtures are the files in testdata/, each with lines it had when the
// exercise was set up.
var fixtures = []string{"testdata/deploy.yaml", "testdata/app.env", "testdata/worker.env"}

var originalLines = map[string][]string{
	"testdata/deploy.yaml": {
		"          image: registry.example.com/api:1.4.1",
		"          image: registry.example.com/log-shipper:1.4.1",
	},
	"testdata/app.env": {
		"# api service settings",
		"LOG_LEVEL=info",
		"DB_PASSWORD=s3cr3t-Pa55",
		"STRIPE_API_TOKEN=tok_live_51HxQ",
		"SLACK_TOKEN=xoxb-1234-abcd",
	},
	"testdata/worker.env": {
		"# worker service settings",
		"LOG_LEVEL=info",
		"QUEUE_PASSWORD=rabbit-Ears-77",
		"METRICS_TOKEN=bXQtOWY4ZTdk==",
	},
}

// workdir returns a temporary folder holding a copy of testdata/ and of the
// scripts. The tests run your scripts there, so not even a stray sed -i can
// change your testdata/. It first checks that testdata/ still holds its
// original lines: if a command run by hand changed them, no script can pass.
func workdir(t *testing.T) string {
	t.Helper()
	for _, name := range fixtures {
		text := readFile(t, name)
		for _, line := range originalLines[name] {
			if !strings.Contains(text, line+"\n") {
				t.Fatalf("%s no longer has the line %q, so a command (sed -i?) changed it. Put that line back as it was, then save.", name, line)
			}
		}
	}
	dir := t.TempDir()
	if err := os.CopyFS(filepath.Join(dir, "testdata"), os.DirFS("testdata")); err != nil {
		t.Fatal(err)
	}
	scripts, err := filepath.Glob("*.sh")
	if err != nil {
		t.Fatal(err)
	}
	for _, script := range scripts {
		if err := os.WriteFile(filepath.Join(dir, script), []byte(readFile(t, script)), 0o644); err != nil {
			t.Fatal(err)
		}
	}
	return dir
}

// exitFailure explains a script that stopped with a non-zero status: what it
// printed before it stopped, and what bash said on stderr.
func exitFailure(t *testing.T, command string, code int, stdout, stderr string) {
	t.Helper()
	msg := fmt.Sprintf("%s exited with status %d, want 0.", command, code)
	if stdout != "" {
		msg += "\nIt printed:\n" + strings.TrimRight(stdout, "\n")
	}
	if stderr != "" {
		msg += "\nbash said:\n" + stderr
	} else {
		msg += "\nbash said nothing: a command failed without a message " +
			"(grep does that when nothing matches), and set -e stopped the script there."
	}
	t.Error(msg)
}

// run runs "bash script args..." in dir and returns what it printed to
// stdout and stderr, and its exit status.
func run(t *testing.T, dir, script string, args ...string) (stdout, stderr string, code int) {
	t.Helper()
	cmd := exec.Command("bash", append([]string{script}, args...)...)
	cmd.Dir = dir
	cmd.Env = append(cmd.Environ(), "LC_ALL=C", "TZ=UTC")
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	if err := cmd.Run(); cmd.ProcessState == nil {
		t.Fatalf("could not start bash: %v", err)
	}
	return out.String(), errOut.String(), cmd.ProcessState.ExitCode()
}

// commandLine shows how to run the script by hand: bash, the script and its
// arguments, with quotes around any argument that has a space.
func commandLine(script string, args ...string) string {
	line := "bash " + script
	for _, arg := range args {
		if strings.Contains(arg, " ") {
			arg = `"` + arg + `"`
		}
		line += " " + arg
	}
	return line
}
