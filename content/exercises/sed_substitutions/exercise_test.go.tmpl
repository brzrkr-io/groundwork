func TestSetLogLevel(t *testing.T) {
	expectEdit(t, "testdata/app.env", "debug")
	expectEdit(t, "testdata/worker.env", "warn")
}

// expectEdit copies fixture into a temporary folder, runs
// 4_set_log_level.sh on the copy, and checks that only the LOG_LEVEL line
// changed.
func expectEdit(t *testing.T, fixture, level string) {
	t.Helper()
	original := readFile(t, fixture)
	file := filepath.Join(t.TempDir(), filepath.Base(fixture))
	if err := os.WriteFile(file, []byte(original), 0o644); err != nil {
		t.Fatal(err)
	}
	_, stderr, code := run(t, "4_set_log_level.sh", file, level)
	command := commandLine("4_set_log_level.sh", file, level)
	if code != 0 {
		t.Errorf("%s exited with status %d, want 0. bash said:\n%s", command, code, stderr)
		return
	}
	want := strings.Replace(original, "\nLOG_LEVEL=info\n", "\nLOG_LEVEL="+level+"\n", 1)
	if got := readFile(t, file); got != want {
		t.Errorf("%s (a copy of %s) left the file holding:\n%s\nwant:\n%s", command, fixture, got, want)
	}
}

// readFile returns the contents of a file, or stops the test if it can't.
func readFile(t *testing.T, path string) string {
	t.Helper()
	data, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	return string(data)
}

// expect runs the script with bash in the exercise folder, just as you do
// in your terminal, and checks that it succeeds and prints want.
func expect(t *testing.T, want, script string, args ...string) {
	t.Helper()
	got, stderr, code := run(t, script, args...)
	command := commandLine(script, args...)
	if code != 0 {
		t.Errorf("%s exited with status %d, want 0. bash said:\n%s", command, code, stderr)
		return
	}
	switch {
	case got == want:
		return
	case got == "":
		t.Errorf("%s printed nothing, want:\n%s", command, want)
	case strings.Count(want, "\n") > 1:
		t.Errorf("%s printed:\n%s\nwant:\n%s", command, got, want)
	default:
		t.Errorf("%s printed %q, want %q", command, got, want)
	}
	if stderr != "" {
		t.Errorf("%s also printed to stderr:\n%s", command, stderr)
	}
}

// run runs "bash script args..." and returns what it printed to stdout and
// stderr, and its exit status.
func run(t *testing.T, script string, args ...string) (stdout, stderr string, code int) {
	t.Helper()
	cmd := exec.Command("bash", append([]string{script}, args...)...)
	cmd.Env = append(cmd.Environ(), "LC_ALL=C", "TZ=UTC")
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	if err := cmd.Run(); cmd.ProcessState == nil {
		t.Fatalf("could not start bash: %v", err)
	}
	return out.String(), errOut.String(), cmd.ProcessState.ExitCode()
}

// commandLine shows how to run the script by hand: bash, the script and its
// arguments, with quotes around any argument that has a space.
func commandLine(script string, args ...string) string {
	line := "bash " + script
	for _, arg := range args {
		if strings.Contains(arg, " ") {
			arg = `"` + arg + `"`
		}
		line += " " + arg
	}
	return line
}
