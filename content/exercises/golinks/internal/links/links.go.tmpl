// Package links defines a go link, the rules every new link must follow,
// and the Store interface the rest of the service saves links through.
package links

import (
	"context"
	"errors"
)

// Link is one short name and the URL it redirects to.
type Link struct {
	Name string `json:"name"`
	URL  string `json:"url"`
}

// The errors a Store and Validate return. Wrap them with %w and callers can
// still tell them apart with errors.Is.
var (
	ErrInvalid  = errors.New("invalid link")
	ErrNotFound = errors.New("link not found")
	ErrExists   = errors.New("link already exists")
)

// Reserved lists the names the service itself uses as paths, so no link may
// take them: GET /healthz must reach the health check, not a link.
var Reserved = []string{"api", "healthz", "readyz", "metrics"}

// Validate returns an error wrapping ErrInvalid for the first rule l breaks,
// or nil if l is a valid new link. The rules, in order:
//
//	Name is not empty                          name is required
//	Name is 1-64 of a-z, 0-9 and -             name must be at most 64 characters of a-z, 0-9 and -
//	Name is not in Reserved                    name is reserved
//	URL is an absolute http or https URL       url must be an absolute http or https URL
func Validate(l Link) error {
	// TODO(1): Check the four rules in order and return the first broken
	// one as "invalid link: <message>", wrapping ErrInvalid.
	return nil
}

// Store saves links. The server only talks to this interface, so tests can
// swap in a fake and production uses SQLite (see internal/store).
type Store interface {
	// Create saves l, or returns ErrExists if a link with its name exists.
	Create(ctx context.Context, l Link) error
	// Get returns the link called name, or ErrNotFound.
	Get(ctx context.Context, name string) (Link, error)
	// List returns every link, sorted by name.
	List(ctx context.Context) ([]Link, error)
	// Delete removes the link called name, or returns ErrNotFound.
	Delete(ctx context.Context, name string) error
	// Ping reports whether the store can serve requests right now.
	Ping(ctx context.Context) error
}
