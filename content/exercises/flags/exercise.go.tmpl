// Package flags is the Gopherlings exercise "Flags: parsing options with a FlagSet".
package flags

import (
	"flag"
	"fmt"
	"io"
	"strings"
	"time"
)

// Options holds everything the deploy tool needs to know.
type Options struct {
	Service  string
	Replicas int
	DryRun   bool
	Timeout  time.Duration
	Hosts    []string
}

// ParseArgs parses the deploy flags from args (os.Args[1:]).
// flag's own messages go to stderr.
func ParseArgs(args []string, stderr io.Writer) (Options, error) {
	fs := flag.NewFlagSet("deploy", flag.ContinueOnError)
	fs.SetOutput(stderr)

	service := fs.String("service", "", "service to deploy (required)")
	// TODO(1): Define -replicas (default 1), -dry-run (default false) and
	// -timeout (default 30s).

	if err := fs.Parse(args); err != nil {
		return Options{}, err
	}

	// TODO(2): If the service is empty, print "deploy: -service is required"
	// to stderr, call fs.Usage() and return an error.

	opts := Options{
		Service: *service,
		// TODO(1): Fill in Replicas, DryRun, Timeout and Hosts (fs.Args()).
	}
	return opts, nil
}

// Run is the whole deploy tool. args is os.Args[1:].
// It returns the exit code.
func Run(args []string, stdout, stderr io.Writer) int {
	opts, err := ParseArgs(args, stderr)
	if err != nil {
		// TODO(3): Return 0 for flag.ErrHelp and 2 for any other error.
		return 1
	}

	fmt.Fprintf(stdout, "deploy %s: replicas=%d timeout=%s dry-run=%t hosts=%s\n",
		opts.Service, opts.Replicas, opts.Timeout, opts.DryRun, strings.Join(opts.Hosts, ","))
	return 0
}
