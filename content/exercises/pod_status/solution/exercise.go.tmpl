// Package podstatus is the Groundwork exercise "Pod status: reading kubectl get".
package podstatus

import (
	"fmt"
	"strconv"
	"strings"
)

// Pod is one row of `kubectl get pods`.
type Pod struct {
	Name     string
	Ready    int // containers that are ready
	Total    int // containers in the Pod
	Status   string
	Restarts int
}

// ParseReady splits a READY value such as "1/2" into the number of ready
// containers and the total. It returns an error that quotes s if s is not
// two whole numbers separated by "/".
func ParseReady(s string) (ready, total int, err error) {
	before, after, found := strings.Cut(s, "/")
	if !found {
		return 0, 0, fmt.Errorf("READY %q has no /", s)
	}
	ready, err = strconv.Atoi(before)
	if err != nil {
		return 0, 0, fmt.Errorf("READY %q: %w", s, err)
	}
	total, err = strconv.Atoi(after)
	if err != nil {
		return 0, 0, fmt.Errorf("READY %q: %w", s, err)
	}
	return ready, total, nil
}

// ParseLine turns one row of `kubectl get pods` into a Pod. It returns an
// error if the row has fewer than five columns or a number doesn't parse.
func ParseLine(line string) (Pod, error) {
	// RESTARTS can be "4 (71s ago)", which Fields splits into three
	// columns, so only the first four columns are read by position.
	fields := strings.Fields(line)
	if len(fields) < 5 {
		return Pod{}, fmt.Errorf("row %q has %d columns, want at least 5", line, len(fields))
	}
	ready, total, err := ParseReady(fields[1])
	if err != nil {
		return Pod{}, err
	}
	restarts, err := strconv.Atoi(fields[3])
	if err != nil {
		return Pod{}, fmt.Errorf("RESTARTS in row %q: %w", line, err)
	}
	return Pod{Name: fields[0], Ready: ready, Total: total, Status: fields[2], Restarts: restarts}, nil
}

// NeedsAttention reads the whole output of `kubectl get pods`, header line
// first, and returns the names of the Pods that need a look, in the order
// they are listed. A Pod is fine if it is Completed, or if it is Running
// with every container ready and fewer than 3 restarts. Blank lines are
// skipped. It returns an error if a row doesn't parse.
func NeedsAttention(output string) ([]string, error) {
	lines := strings.Split(output, "\n")
	var names []string
	for _, line := range lines[1:] {
		if strings.TrimSpace(line) == "" {
			continue
		}
		p, err := ParseLine(line)
		if err != nil {
			return nil, err
		}
		if !fine(p) {
			names = append(names, p.Name)
		}
	}
	return names, nil
}

// fine reports whether p needs no attention.
func fine(p Pod) bool {
	if p.Status == "Completed" {
		return true
	}
	return p.Status == "Running" && p.Ready == p.Total && p.Restarts < 3
}
