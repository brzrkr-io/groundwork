package portcheck

import (
	"context"
	"errors"
	"fmt"
	"net"
	"os"
	"syscall"
	"testing"
	"time"
)

func TestClassify(t *testing.T) {
	// These are the kinds of errors a real dial returns.
	refused := &net.OpError{Op: "dial", Net: "tcp", Err: &os.SyscallError{Syscall: "connect", Err: syscall.ECONNREFUSED}}
	timedOut := &net.OpError{Op: "dial", Net: "tcp", Err: os.ErrDeadlineExceeded}
	noHost := &net.DNSError{Err: "no such host", Name: "db.internal", IsNotFound: true}

	tests := []struct {
		name string
		err  error
		want Status
	}{
		{"no error", nil, Open},
		{"connection refused", refused, Closed},
		{"wrapped connection refused", fmt.Errorf("check db: %w", refused), Closed},
		{"i/o timeout", timedOut, Timeout},
		{"wrapped timeout", fmt.Errorf("check web: %w", timedOut), Timeout},
		{"unknown host", noHost, Failed},
		{"other error", errors.New("network is unreachable"), Failed},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := Classify(tt.err); got != tt.want {
				t.Errorf("Classify(%v) = %q, want %q", tt.err, got, tt.want)
			}
		})
	}
}

// fakeConn is a pretend connection that only remembers whether it was closed.
type fakeConn struct {
	net.Conn
	closed bool
}

func (c *fakeConn) Close() error {
	c.closed = true
	return nil
}

func TestCheck(t *testing.T) {
	t.Run("open port", func(t *testing.T) {
		ln, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		defer ln.Close()
		addr := ln.Addr().String()

		c := NewChecker(time.Second)
		if c.Dial == nil {
			t.Fatal("NewChecker(time.Second).Dial is nil, want the DialContext method of a net.Dialer")
		}
		want := Result{Addr: addr, Status: Open}
		if got := c.Check(addr); got != want {
			t.Errorf("Check(%q) = %+v, want %+v", addr, got, want)
		}
	})

	t.Run("closed port", func(t *testing.T) {
		// Grab a free port, then stop listening so nothing answers on it.
		ln, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		addr := ln.Addr().String()
		ln.Close()

		c := NewChecker(time.Second)
		if c.Dial == nil {
			t.Fatal("NewChecker(time.Second).Dial is nil, want the DialContext method of a net.Dialer")
		}
		want := Result{Addr: addr, Status: Closed}
		if got := c.Check(addr); got != want {
			t.Errorf("Check(%q) = %+v, want %+v", addr, got, want)
		}
	})

	t.Run("filtered port", func(t *testing.T) {
		// A fake dialer stands in for a firewall that drops our packets.
		c := &Checker{Dial: func(ctx context.Context, network, address string) (net.Conn, error) {
			return nil, &net.OpError{Op: "dial", Net: network, Err: os.ErrDeadlineExceeded}
		}}
		addr := "10.0.0.9:443"
		want := Result{Addr: addr, Status: Timeout}
		if got := c.Check(addr); got != want {
			t.Errorf("Check(%q) = %+v, want %+v", addr, got, want)
		}
	})

	t.Run("dials tcp and closes the connection", func(t *testing.T) {
		conn := &fakeConn{}
		var gotNetwork, gotAddress string
		c := &Checker{Dial: func(ctx context.Context, network, address string) (net.Conn, error) {
			gotNetwork, gotAddress = network, address
			return conn, nil
		}}
		addr := "db.internal:5432"
		want := Result{Addr: addr, Status: Open}
		if got := c.Check(addr); got != want {
			t.Errorf("Check(%q) = %+v, want %+v", addr, got, want)
		}
		if gotNetwork != "tcp" || gotAddress != addr {
			t.Errorf("Check(%q) dialed (%q, %q), want (%q, %q)", addr, gotNetwork, gotAddress, "tcp", addr)
		}
		if !conn.closed {
			t.Errorf("Check(%q) left the connection open, want it closed", addr)
		}
	})
}

func TestReport(t *testing.T) {
	tests := []struct {
		name    string
		results []Result
		want    string
	}{
		{
			name: "mixed",
			results: []Result{
				{"127.0.0.1:5432", Open},
				{"db.internal:6379", Closed},
				{"10.0.0.9:443", Timeout},
			},
			want: "ADDRESS               STATUS\n" +
				"127.0.0.1:5432        open\n" +
				"db.internal:6379      closed\n" +
				"10.0.0.9:443          timeout\n" +
				"1 of 3 ports open\n",
		},
		{
			name: "all open",
			results: []Result{
				{"10.0.0.5:80", Open},
				{"10.0.0.5:443", Open},
			},
			want: "ADDRESS               STATUS\n" +
				"10.0.0.5:80           open\n" +
				"10.0.0.5:443          open\n" +
				"2 of 2 ports open\n",
		},
		{
			name: "lookup failure",
			results: []Result{
				{"cache.internal:11211", Failed},
			},
			want: "ADDRESS               STATUS\n" +
				"cache.internal:11211  error\n" +
				"0 of 1 ports open\n",
		},
		{
			name:    "nothing checked",
			results: nil,
			want: "ADDRESS               STATUS\n" +
				"0 of 0 ports open\n",
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := Report(tt.results); got != tt.want {
				t.Errorf("Report(%v)\n got: %q\nwant: %q", tt.results, got, tt.want)
			}
		})
	}
}
