// Package oncall is the Gopherlings exercise "Bytes, runes and UTF-8: fix the byte bugs".
package oncall

import "strings"

// Initial returns the upper-case first character of name, or "?" if name is
// empty.
func Initial(name string) string {
	if name == "" {
		return "?"
	}
	// TODO(1): This takes the first byte, not the first character. Fix it.
	return strings.ToUpper(string(name[0]))
}

// MaskSecret replaces every character of secret except the last 4 with "*".
// Secrets of 4 characters or fewer are masked completely.
func MaskSecret(secret string) string {
	// TODO(2): This counts and cuts bytes, not characters. Fix it.
	if len(secret) <= 4 {
		return strings.Repeat("*", len(secret))
	}
	return strings.Repeat("*", len(secret)-4) + secret[len(secret)-4:]
}
