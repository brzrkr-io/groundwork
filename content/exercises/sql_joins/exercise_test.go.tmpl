func TestServiceTeams(t *testing.T) {
	got := runQuery(t, "1_service_teams.sql")
	checkColumns(t, "1_service_teams.sql", got, "service", "team")
	want := [][]string{
		{"api", "platform"},
		{"billing", "payments"},
		{"checkout", "payments"},
		{"notifications", "platform"},
		{"search", "search"},
	}
	checkRows(t, "1_service_teams.sql", got, want)
}

