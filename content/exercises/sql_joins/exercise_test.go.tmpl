// result is what a query returned: the column names, and the rows with every
// value written as text ("NULL" for a missing value).
type result struct {
	columns []string
	rows    [][]string
	// unstable is true when a second run of the query returned the same rows
	// in a different order.
	unstable bool
}

// runQuery builds a fresh in-memory database from testdata/schema.sql and
// testdata/data.sql, then runs the query in file against it.
//
// Without ORDER BY, a database may return rows in any order. To catch a query
// that is in order only by luck, runQuery runs it a second time with SQLite
// told to read tables backwards (PRAGMA reverse_unordered_selects).
func runQuery(t *testing.T, file string) result {
	t.Helper()
	db, err := sql.Open("sqlite", ":memory:")
	if err != nil {
		t.Fatal(err)
	}
	// Every connection to ":memory:" gets its own empty database: use one.
	db.SetMaxOpenConns(1)
	t.Cleanup(func() { db.Close() })
	for _, fixture := range []string{"testdata/schema.sql", "testdata/data.sql"} {
		if _, err := db.Exec(readSQL(t, fixture)); err != nil {
			t.Fatalf("loading %s: %v", fixture, err)
		}
	}

	query := readSQL(t, file)
	res := collect(t, db, file, query)
	if _, err := db.Exec("PRAGMA reverse_unordered_selects = ON"); err != nil {
		t.Fatal(err)
	}
	res.unstable = !slices.EqualFunc(res.rows, collect(t, db, file, query).rows, slices.Equal)
	return res
}

// collect runs query and returns its columns and rows.
func collect(t *testing.T, db *sql.DB, file, query string) result {
	t.Helper()
	rows, err := db.Query(query)
	if err != nil {
		t.Fatalf("%s failed: %v", file, err)
	}
	defer rows.Close()
	columns, err := rows.Columns()
	if err != nil {
		t.Fatal(err)
	}
	res := result{columns: columns}
	for rows.Next() {
		values := make([]sql.NullString, len(columns))
		targets := make([]any, len(columns))
		for i := range values {
			targets[i] = &values[i]
		}
		if err := rows.Scan(targets...); err != nil {
			t.Fatalf("%s: reading a row: %v", file, err)
		}
		row := make([]string, len(columns))
		for i, v := range values {
			row[i] = "NULL"
			if v.Valid {
				row[i] = v.String
			}
		}
		res.rows = append(res.rows, row)
	}
	if err := rows.Err(); err != nil {
		t.Fatalf("%s failed: %v", file, err)
	}
	return res
}

// readSQL returns the contents of file. It fails the test if the file holds
// nothing but comments, because then there's no query to run yet.
func readSQL(t *testing.T, file string) string {
	t.Helper()
	data, err := os.ReadFile(file)
	if err != nil {
		t.Fatal(err)
	}
	for line := range strings.Lines(string(data)) {
		line = strings.TrimSpace(line)
		if line != "" && !strings.HasPrefix(line, "--") {
			return string(data)
		}
	}
	t.Fatalf("%s has no SQL yet: write your query under the TODO", file)
	return ""
}

// unstableHint explains a result whose order changed between two runs.
const unstableHint = "The test ran your query twice, and the second time the rows came back in a different order.\n" +
	"Without ORDER BY (or with an ORDER BY that leaves ties), the database picks the order. Sort the rows as the task says."

// checkRows compares the rows of got with want, in order: these queries use
// ORDER BY, so the order is part of the answer.
func checkRows(t *testing.T, file string, got result, want [][]string) {
	t.Helper()
	if !slices.EqualFunc(got.rows, want, slices.Equal) {
		hint := ""
		if got.unstable {
			hint = "\n" + unstableHint
		}
		t.Errorf("%s returned %d rows (columns: %s):\n%s\nwant %d rows, in this order:\n%s%s",
			file, len(got.rows), strings.Join(got.columns, ", "), table(got.rows), len(want), table(want), hint)
		return
	}
	if got.unstable {
		t.Errorf("%s returned the right rows, but in this order only by luck.\n%s", file, unstableHint)
	}
}

// checkColumns compares the column names of got with want. Name a computed
// column with AS.
func checkColumns(t *testing.T, file string, got result, want ...string) {
	t.Helper()
	if !slices.Equal(got.columns, want) {
		t.Errorf("%s returned columns %s, want %s", file, strings.Join(got.columns, ", "), strings.Join(want, ", "))
	}
}

// table writes rows one per line, with " | " between the values.
func table(rows [][]string) string {
	var b strings.Builder
	for _, row := range rows {
		b.WriteString("    ")
		b.WriteString(strings.Join(row, " | "))
		b.WriteString("\n")
	}
	if len(rows) == 0 {
		b.WriteString("    (no rows)\n")
	}
	return b.String()
}
