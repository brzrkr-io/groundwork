package report

import (
	"flag"
	"os"
	"path/filepath"
	"testing"
)

// update is set by running: go test -run TestRenderInventory -update
var update = flag.Bool("update", false, "rewrite golden files")

func TestRenderInventory(t *testing.T) {
	hosts := []Host{
		{Name: "web-1", IP: "10.0.1.15", Region: "eu-west-1"},
		{Name: "web-2", IP: "10.0.1.16", Region: "eu-west-1"},
		{Name: "db-primary", IP: "10.0.2.5", Region: "us-east-1"},
	}
	got := RenderInventory(hosts)

	golden := filepath.Join("testdata", "inventory.golden")
	if *update {
		if err := os.WriteFile(golden, []byte(got), 0o644); err != nil {
			t.Fatalf("updating %s: %v", golden, err)
		}
	}

	// TODO(1): Read the golden file with os.ReadFile and compare it with got.
	// If they differ, fail with a message that shows both.
}
