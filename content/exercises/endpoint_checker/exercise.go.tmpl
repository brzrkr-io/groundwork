// Endpoint is one URL to check and the status code it should return.
type Endpoint struct {
	Name   string
	URL    string
	Expect int
}

// Result is the outcome of checking one Endpoint.
type Result struct {
	Name     string
	Expect   int
	Status   int           // status code of the last attempt; 0 if the request failed
	Latency  time.Duration // time taken by all attempts together
	Attempts int           // 1, or 2 when the check was retried
	Err      error         // the request error, if the request failed
	OK       bool          // true when Err is nil and Status equals Expect
}

// Checker checks endpoints with an HTTP client. Now is the clock used to
