// usage is the help text for shipctl. It ends with a newline.
const usage = `usage: shipctl <command> [flags] SERVICE

commands:
  status    show what a service is running
  deploy    deploy a new version of a service
  rollback  roll a service back to an earlier release
`

// Run is the whole shipctl program. args is os.Args[1:], so args[0] is the
// command name. Run returns the exit code: 0 for success, 1 for a runtime
// failure and 2 for a usage error.
func Run(args []string, stdout, stderr io.Writer) int {
	// TODO(1): Turn this into a switch on args[0]: help, -h and --help print
	// usage to stdout; status, deploy and rollback call their handler with
	// args[1:]; anything else (or no args at all) is a usage error.
	if len(args) > 0 && args[0] == "status" {
		return runStatus(args[1:], stdout, stderr)
	}
	fmt.Fprintln(stderr, "shipctl: not implemented yet")
	return 1
}

// runStatus handles "shipctl status [-env ENV] SERVICE".
// It is finished: use it as the example for the other two handlers.
func runStatus(args []string, stdout, stderr io.Writer) int {
	fs := flag.NewFlagSet("status", flag.ContinueOnError)
	fs.SetOutput(stderr)
	env := fs.String("env", "staging", "environment to check")
	if err := fs.Parse(args); err != nil {
		if errors.Is(err, flag.ErrHelp) {
			return 0 // "shipctl status -h" asked for help
		}
		return 2 // the flag package has already printed the problem
	}
	if fs.NArg() != 1 {
		fmt.Fprintln(stderr, "shipctl: status needs exactly one SERVICE")
		return 2
	}
	fmt.Fprintf(stdout, "checking status of %s in %s\n", fs.Arg(0), *env)
	return 0
}

