package gitstaging

import (
	"bytes"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
)

// Each test builds a fresh sandbox with setup.sh, runs your scripts in
// task order up to the one it checks, then inspects the repo with git.
var scripts = []string{
	"1_unstage_notes.sh",
	"2_commit_fix.sh",
	"3_discard_debug.sh",
}

func TestUnstageNotes(t *testing.T) {
	repo, _ := runTasks(t, 1)
	if got := git(t, repo, "diff", "--staged", "--name-only"); got != "config/app.yaml" {
		t.Errorf("staged files = %q, want only \"config/app.yaml\"", got)
	}
	if _, err := os.Stat(filepath.Join(repo, "notes", "todo.txt")); err != nil {
		t.Error("notes/todo.txt is gone from the working tree, want it kept (only unstaged)")
	}
	if got := git(t, repo, "rev-list", "--count", "HEAD"); got != "1" {
		t.Errorf("main has %s commits, want still 1", got)
	}
}

func TestCommitFix(t *testing.T) {
	repo, _ := runTasks(t, 2)
	if got := git(t, repo, "log", "--format=%s"); got != "Raise api timeout to 30s\nAdd api config and deploy script" {
		t.Fatalf("git log --format=%%s:\n%s\nwant:\nRaise api timeout to 30s\nAdd api config and deploy script", got)
	}
	if got := git(t, repo, "show", "--name-only", "--format=", "HEAD"); got != "config/app.yaml" {
		t.Errorf("files changed by the newest commit:\n%s\nwant only config/app.yaml", got)
	}
	if got := git(t, repo, "status", "--porcelain"); got != " M deploy.sh\n?? notes/" {
		t.Errorf("git status --porcelain:\n%s\nwant:\n M deploy.sh\n?? notes/", got)
	}
}

func TestDiscardDebug(t *testing.T) {
	repo, _ := runTasks(t, 3)
	if got := git(t, repo, "status", "--porcelain"); got != "?? notes/" {
		t.Errorf("git status --porcelain:\n%s\nwant:\n?? notes/", got)
	}
	data, err := os.ReadFile(filepath.Join(repo, "deploy.sh"))
	if err != nil {
		t.Fatal(err)
	}
	if strings.Contains(string(data), "DEBUG") {
		t.Errorf("deploy.sh still has the debug line:\n%s", data)
	}
	if _, err := os.Stat(filepath.Join(repo, "notes", "todo.txt")); err != nil {
		t.Error("notes/todo.txt is gone, want it kept")
	}
}

// runTasks builds a fresh sandbox with setup.sh, then runs task scripts 1 to
// n inside it, in order, as you would by hand. It returns the repo's path
// and what script n printed.
func runTasks(t *testing.T, n int) (repo, printed string) {
	t.Helper()
	home := t.TempDir()
	repo = filepath.Join(home, "sandbox")
	if _, stderr, err := run(home, ".", "bash", "setup.sh", repo); err != nil {
		t.Fatalf("setup.sh failed (%v):\n%s", err, stderr)
	}
	for _, script := range scripts[:n] {
		path, err := filepath.Abs(script)
		if err != nil {
			t.Fatal(err)
		}
		stdout, stderr, err := run(home, repo, "bash", path)
		if err != nil {
			t.Fatalf("%s failed (%v). It printed:\n%s%s", script, err, stdout, stderr)
		}
		printed = stdout
	}
	return repo, printed
}

// git runs a git command in repo and returns what it printed, without the
// final newline.
func git(t *testing.T, repo string, args ...string) string {
	t.Helper()
	stdout, stderr, err := run(filepath.Dir(repo), repo, "git", args...)
	if err != nil {
		t.Fatalf("git %s failed (%v):\n%s", strings.Join(args, " "), err, stderr)
	}
	return strings.TrimSuffix(stdout, "\n")
}

// run runs a command in dir, hermetically: no personal Git config, a fixed
// author and date, and no editor or pager waiting for input.
func run(home, dir, name string, args ...string) (stdout, stderr string, err error) {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.Env = append(os.Environ(),
		"HOME="+home, "XDG_CONFIG_HOME="+home, "LC_ALL=C", "TZ=UTC",
		"GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1",
		"GIT_AUTHOR_NAME=Sam Rivera", "GIT_AUTHOR_EMAIL=sam@example.com",
		"GIT_COMMITTER_NAME=Sam Rivera", "GIT_COMMITTER_EMAIL=sam@example.com",
		"GIT_AUTHOR_DATE=2026-10-01 12:00:00 +0000", "GIT_COMMITTER_DATE=2026-10-01 12:00:00 +0000",
		"GIT_EDITOR=true", "GIT_PAGER=cat", "PAGER=cat",
	)
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	err = cmd.Run()
	return out.String(), errOut.String(), err
}
