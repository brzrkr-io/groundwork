// Package customtypes is the Gopherlings exercise "Custom types and enums".
package customtypes

import "strings"

// Environment names a deployment environment, such as "staging".
type Environment string

// The environments your company deploys to.
const (
	Dev        Environment = "dev"
	Staging    Environment = "staging"
	Production Environment = "production"
)

// Severity ranks how serious an alert is. Higher values are more serious.
type Severity int

// The alert severities, from least to most serious.
const (
	Debug    Severity = iota // 0
	Info                     // 1
	Warning                  // 2
	Error                    // 3
	Critical                 // 4
)

// IsValid reports whether e is one of Dev, Staging or Production.
func (e Environment) IsValid() bool {
	return e == Dev || e == Staging || e == Production
}

// ShouldPage reports whether an alert with severity s in environment env
// should page the on-call engineer.
func (s Severity) ShouldPage(env Environment) bool {
	switch s {
	case Critical:
		return true
	case Error:
		return env == Production
	default:
		return false
	}
}

// ParseSeverity converts a severity name such as "warning" into a Severity.
// It reports false if the name is unknown.
func ParseSeverity(s string) (Severity, bool) {
	switch strings.ToLower(s) {
	case "debug":
		return Debug, true
	case "info":
		return Info, true
	case "warning":
		return Warning, true
	case "error":
		return Error, true
	case "critical":
		return Critical, true
	default:
		return Debug, false
	}
}
