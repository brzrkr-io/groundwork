package conversion

import "testing"

func TestHealthyPercent(t *testing.T) {
	if got := HealthyPercent(3, 4); got != 75 {
		t.Errorf(`HealthyPercent(3, 4) = %v, want 75`, got)
	}

	if got := HealthyPercent(1, 8); got != 12.5 {
		t.Errorf(`HealthyPercent(1, 8) = %v, want 12.5`, got)
	}

	if got := HealthyPercent(4, 4); got != 100 {
		t.Errorf(`HealthyPercent(4, 4) = %v, want 100`, got)
	}

	if got := HealthyPercent(0, 5); got != 0 {
		t.Errorf(`HealthyPercent(0, 5) = %v, want 0`, got)
	}
}

func TestListenAddr(t *testing.T) {
	if got := ListenAddr("0.0.0.0", 8080); got != "0.0.0.0:8080" {
		t.Errorf(`ListenAddr("0.0.0.0", 8080) = %q, want "0.0.0.0:8080"`, got)
	}

	if got := ListenAddr("localhost", 9090); got != "localhost:9090" {
		t.Errorf(`ListenAddr("localhost", 9090) = %q, want "localhost:9090"`, got)
	}
}

func TestHealthLabel(t *testing.T) {
	if got := HealthLabel(3, 4); got != "3/4 pods healthy (75.0%)" {
		t.Errorf(`HealthLabel(3, 4) = %q, want "3/4 pods healthy (75.0%%)"`, got)
	}

	if got := HealthLabel(2, 3); got != "2/3 pods healthy (66.7%)" {
		t.Errorf(`HealthLabel(2, 3) = %q, want "2/3 pods healthy (66.7%%)"`, got)
	}

	if got := HealthLabel(0, 5); got != "0/5 pods healthy (0.0%)" {
		t.Errorf(`HealthLabel(0, 5) = %q, want "0/5 pods healthy (0.0%%)"`, got)
	}
}
