package conversion

import "testing"

func TestHealthyPercent(t *testing.T) {
	tests := []struct {
		name    string
		healthy int
		total   int
		want    float64
	}{
		{name: "three of four", healthy: 3, total: 4, want: 75},
		{name: "one of eight", healthy: 1, total: 8, want: 12.5},
		{name: "all healthy", healthy: 4, total: 4, want: 100},
		{name: "none healthy", healthy: 0, total: 5, want: 0},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := HealthyPercent(tt.healthy, tt.total)
			if got != tt.want {
				t.Errorf("HealthyPercent(%d, %d) = %v, want %v", tt.healthy, tt.total, got, tt.want)
			}
		})
	}
}

func TestListenAddr(t *testing.T) {
	tests := []struct {
		name string
		host string
		port int
		want string
	}{
		{name: "all interfaces", host: "0.0.0.0", port: 8080, want: "0.0.0.0:8080"},
		{name: "localhost", host: "localhost", port: 9090, want: "localhost:9090"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := ListenAddr(tt.host, tt.port)
			if got != tt.want {
				t.Errorf("ListenAddr(%q, %d) = %q, want %q", tt.host, tt.port, got, tt.want)
			}
		})
	}
}

func TestHealthLabel(t *testing.T) {
	tests := []struct {
		name    string
		healthy int
		total   int
		want    string
	}{
		{name: "three of four", healthy: 3, total: 4, want: "3/4 pods healthy (75.0%)"},
		{name: "two of three", healthy: 2, total: 3, want: "2/3 pods healthy (66.7%)"},
		{name: "none healthy", healthy: 0, total: 5, want: "0/5 pods healthy (0.0%)"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := HealthLabel(tt.healthy, tt.total)
			if got != tt.want {
				t.Errorf("HealthLabel(%d, %d) = %q, want %q", tt.healthy, tt.total, got, tt.want)
			}
		})
	}
}
