// Package fleetops is the Groundwork exercise "Collecting errors from goroutines".
package fleetops

// RunAll runs every task at the same time and returns all of their errors
// joined together, in task order. It returns nil if every task succeeded.
func RunAll(tasks []func() error) error {
	// TODO(1): Run the tasks at the same time, store each error in its own
	// slot, and return errors.Join of them all. Add "errors" and "sync" to
	// the imports.
	for _, task := range tasks {
		if err := task(); err != nil {
			return err
		}
	}
	return nil
}

