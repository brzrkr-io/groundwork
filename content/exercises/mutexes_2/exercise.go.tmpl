// Package deploystats is the Groundwork exercise "Mutexes: atomics and slow locks".
package deploystats

import "sync"

// DeployStats counts deploys. It is safe to use from many goroutines at once.
type DeployStats struct {
	// TODO(1): Plain int64 fields are a data race when many goroutines update
	// them. Make both fields atomic.Int64 and update the methods below.
	total  int64
	failed int64
}

// Record counts one deploy, and one failure when ok is false.
func (s *DeployStats) Record(ok bool) {
	s.total++
	if !ok {
		s.failed++
	}
}

// Total returns how many deploys were recorded.
func (s *DeployStats) Total() int64 {
	return s.total
}

// Failed returns how many recorded deploys failed.
func (s *DeployStats) Failed() int64 {
	return s.failed
}

// AMICache remembers the machine image ID for each region.
type AMICache struct {
	mu  sync.Mutex // protects ids
	ids map[string]string
}

// NewAMICache returns an empty cache.
func NewAMICache() *AMICache {
	return &AMICache{ids: make(map[string]string)}
}

// Get returns the image ID for region, calling lookup to fill the cache on a
// miss. The lock is never held while lookup runs.
func (c *AMICache) Get(region string, lookup func(region string) string) string {
	c.mu.Lock()
	defer c.mu.Unlock()
	if id, ok := c.ids[region]; ok {
		return id
	}
	// TODO(2): lookup is slow, and the lock is still held here, so every
	// other caller waits. Release the lock before calling lookup, and take
	// it again only to store the result.
	id := lookup(region)
	c.ids[region] = id
	return id
}
