package gitreleaseday

import (
	"bytes"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
)

// Each test builds a fresh sandbox with setup.sh, runs your scripts in
// task order up to the one it checks, then inspects the repo with git.
var scripts = []string{
	"1_revert_debug_logging.sh",
	"2_merge_rate_limit.sh",
	"3_tag_release.sh",
	"4_release_notes.sh",
}

func TestRevertDebugLogging(t *testing.T) {
	repo, _ := runTasks(t, 1)
	if got := git(t, repo, "log", "-1", "--format=%s", "main"); got != "Revert \"Enable debug logging in prod\"" {
		t.Errorf("main's newest commit = %q, want \"Revert \\\"Enable debug logging in prod\\\"\"", got)
	}
	want := "name: web\nlog_level: info\nreplicas: 3\nport: 8080\nrequest_timeout: 15s"
	if got := git(t, repo, "show", "main:config/app.yaml"); got != want {
		t.Errorf("committed config/app.yaml:\n%s\nwant:\n%s", got, want)
	}
}

func TestMergeRateLimit(t *testing.T) {
	repo, _ := runTasks(t, 2)
	if got := git(t, repo, "log", "-1", "--format=%s", "main"); got != "Merge branch 'feature/rate-limit'" {
		t.Errorf("main's newest commit = %q, want \"Merge branch 'feature/rate-limit'\"", got)
	}
	if got := len(strings.Fields(git(t, repo, "log", "-1", "--format=%P", "main"))); got != 2 {
		t.Errorf("main's newest commit has %d parents, want 2 (a merge commit)", got)
	}
	if got := git(t, repo, "branch", "--format=%(refname:short)"); got != "main" {
		t.Errorf("branches:\n%s\nwant only main", got)
	}
}

func TestTagRelease(t *testing.T) {
	repo, _ := runTasks(t, 3)
	if git(t, repo, "tag", "--list", "v1.4.0") == "" {
		t.Fatalf("there is no tag v1.4.0; git tag lists:\n%s", git(t, repo, "tag"))
	}
	if got, want := git(t, repo, "rev-parse", "v1.4.0^{commit}"), git(t, repo, "rev-parse", "main"); got != want {
		t.Errorf("v1.4.0 points at %s, want main's newest commit %s", got, want)
	}
	if got := git(t, repo, "log", "-1", "--format=%s", "main"); got != "Release v1.4.0" {
		t.Errorf("main's newest commit = %q, want \"Release v1.4.0\"", got)
	}
	if got := git(t, repo, "show", "main:VERSION"); got != "1.4.0" {
		t.Errorf("committed VERSION = %q, want \"1.4.0\"", got)
	}
	if got := git(t, repo, "status", "--porcelain"); got != "" {
		t.Errorf("git status --porcelain:\n%s\nwant nothing left to commit", got)
	}
}

func TestReleaseNotes(t *testing.T) {
	_, printed := runTasks(t, 4)
	want := `- Release v1.4.0
- Revert "Enable debug logging in prod"
- Add request timeout setting
- Enable debug logging in prod
- Document rate limits
- Add rate limiter config`
	if printed != want {
		t.Errorf("4_release_notes.sh printed:\n%s\nwant:\n%s", printed, want)
	}
}

// runTasks builds a fresh sandbox with setup.sh, then runs task scripts 1 to
// n inside it, in order, as you would by hand. It returns the repo's path
// and what script n printed, without the final newline.
func runTasks(t *testing.T, n int) (repo, printed string) {
	t.Helper()
	home := t.TempDir()
	repo = filepath.Join(home, "sandbox")
	if _, stderr, err := run(home, ".", "bash", "setup.sh", repo); err != nil {
		t.Fatalf("setup.sh failed (%v):\n%s", err, stderr)
	}
	for _, script := range scripts[:n] {
		path, err := filepath.Abs(script)
		if err != nil {
			t.Fatal(err)
		}
		stdout, stderr, err := run(home, repo, "bash", path)
		if err != nil {
			t.Fatalf("%s failed (%v). It printed:\n%s%s", script, err, stdout, stderr)
		}
		printed = strings.TrimSuffix(stdout, "\n")
	}
	return repo, printed
}

// git runs a git command in repo and returns what it printed, without the
// final newline.
func git(t *testing.T, repo string, args ...string) string {
	t.Helper()
	stdout, stderr, err := run(filepath.Dir(repo), repo, "git", args...)
	if err != nil {
		t.Fatalf("git %s failed (%v):\n%s", strings.Join(args, " "), err, stderr)
	}
	return strings.TrimSuffix(stdout, "\n")
}

// run runs a command in dir, hermetically: no personal Git config, hooks or
// GIT_* variables, a fixed author and date, no Git repos outside home, and
// no editor or pager waiting for input.
func run(home, dir, name string, args ...string) (stdout, stderr string, err error) {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	for _, kv := range os.Environ() {
		if !strings.HasPrefix(kv, "GIT_") {
			cmd.Env = append(cmd.Env, kv)
		}
	}
	cmd.Env = append(cmd.Env,
		"GIT_CEILING_DIRECTORIES="+home,
		"HOME="+home, "XDG_CONFIG_HOME="+home, "LC_ALL=C", "TZ=UTC",
		"GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1",
		"GIT_AUTHOR_NAME=Sam Rivera", "GIT_AUTHOR_EMAIL=sam@example.com",
		"GIT_COMMITTER_NAME=Sam Rivera", "GIT_COMMITTER_EMAIL=sam@example.com",
		"GIT_AUTHOR_DATE=2026-10-01 12:00:00 +0000", "GIT_COMMITTER_DATE=2026-10-01 12:00:00 +0000",
		"GIT_EDITOR=true", "GIT_PAGER=cat", "PAGER=cat",
	)
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	err = cmd.Run()
	return out.String(), errOut.String(), err
}
