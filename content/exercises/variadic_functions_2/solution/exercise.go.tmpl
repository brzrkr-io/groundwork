// Package alerts is the Gopherlings exercise "Variadic functions: fix the pager bot".
package alerts

import "strings"

// Alert builds a pager message: the severity, then the hosts separated by
// ", ". With no hosts it says "no hosts".
func Alert(severity string, hosts ...string) string {
	if len(hosts) == 0 {
		return severity + ": no hosts"
	}
	var b strings.Builder
	b.WriteString(severity)
	b.WriteString(": ")
	b.WriteString(hosts[0])
	for _, h := range hosts[1:] {
		b.WriteString(", ")
		b.WriteString(h)
	}
	return b.String()
}

// PageOnCall builds a critical alert for every host in down.
func PageOnCall(down []string) string {
	return Alert("critical", down...)
}

// WarnCanary builds a warning alert listing canary first, then others.
func WarnCanary(canary string, others []string) string {
	hosts := append([]string{canary}, others...)
	return Alert("warning", hosts...)
}
