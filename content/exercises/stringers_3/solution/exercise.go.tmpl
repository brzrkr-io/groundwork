// Package stringers3 is the Gopherlings exercise "Stringers: a kubectl-style deployment report".
package stringers3

import (
	"fmt"
	"strings"
)

// Status says how a deployment's rollout is going.
type Status int

// The rollout statuses.
const (
	Progressing Status = iota
	Available
	Degraded
)

// String returns the status's name, such as "Available".
func (s Status) String() string {
	switch s {
	case Progressing:
		return "Progressing"
	case Available:
		return "Available"
	case Degraded:
		return "Degraded"
	default:
		return fmt.Sprintf("Status(%d)", int(s))
	}
}

// Replicas counts how many copies of a deployment are ready.
type Replicas struct {
	Ready   int
	Desired int
}

// String returns the counts as "ready/desired", such as "3/5".
func (r Replicas) String() string {
	return fmt.Sprintf("%d/%d", r.Ready, r.Desired)
}

// Deployment is one service rolled out in one namespace.
type Deployment struct {
	Name      string
	Namespace string
	Replicas  Replicas
	Status    Status
}

// String returns the deployment as one line, such as "prod/api 1/3 Degraded".
func (d Deployment) String() string {
	// %v on the fields uses Replicas.String and Status.String.
	return fmt.Sprintf("%s/%s %v %v", d.Namespace, d.Name, d.Replicas, d.Status)
}

// Report returns a summary line and then one line per deployment.
func Report(deps []Deployment) string {
	degraded := 0
	for _, d := range deps {
		if d.Status == Degraded {
			degraded++
		}
	}

	var b strings.Builder
	fmt.Fprintf(&b, "deployments: %d, degraded: %d\n", len(deps), degraded)
	for _, d := range deps {
		fmt.Fprintln(&b, d)
	}
	return b.String()
}
