// Package labels is the Groundwork exercise "The strings package".
package labels

import "strings"

// HostFromURL returns the host part of url: without "https://" or "http://"
// in front, and without anything from the first "/" onwards.
func HostFromURL(url string) string {
	url = strings.TrimPrefix(url, "https://")
	url = strings.TrimPrefix(url, "http://")
	host, _, _ := strings.Cut(url, "/")
	return host
}

// ParseLabels turns "app=web,env=prod" into a map of label keys to values.
// Pairs without "=" are skipped.
func ParseLabels(s string) map[string]string {
	labels := make(map[string]string)
	for pair := range strings.SplitSeq(s, ",") {
		key, value, found := strings.Cut(pair, "=")
		if !found {
			continue
		}
		labels[strings.TrimSpace(key)] = strings.TrimSpace(value)
	}
	return labels
}

// BuildCommand returns binary followed by args, separated by spaces. Any
// argument that contains a space is wrapped in double quotes.
func BuildCommand(binary string, args []string) string {
	var b strings.Builder
	b.WriteString(binary)
	for _, arg := range args {
		b.WriteString(" ")
		if strings.Contains(arg, " ") {
			arg = "\"" + arg + "\""
		}
		b.WriteString(arg)
	}
	return b.String()
}
