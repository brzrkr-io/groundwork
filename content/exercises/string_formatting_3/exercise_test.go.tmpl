package formatting

import "testing"

func TestUptimeLine(t *testing.T) {
	if got := UptimeLine("checkout", 99.95, 99.9); got != "checkout: 99.95% uptime (target 99.90%)" {
		t.Errorf(`UptimeLine("checkout", 99.95, 99.9) = %q, want "checkout: 99.95%% uptime (target 99.90%%)"`, got)
	}

	if got := UptimeLine("auth", 100, 99.5); got != "auth: 100.00% uptime (target 99.50%)" {
		t.Errorf(`UptimeLine("auth", 100, 99.5) = %q, want "auth: 100.00%% uptime (target 99.50%%)"`, got)
	}
}

func TestDiskAlert(t *testing.T) {
	if got := DiskAlert("web-01", "/var", 91.27, 90); got != `ALERT host="web-01" mount="/var" used=91.3% threshold=90%` {
		t.Errorf(`DiskAlert("web-01", "/var", 91.27, 90) = %q, want "ALERT host=\"web-01\" mount=\"/var\" used=91.3%% threshold=90%%"`, got)
	}

	if got := DiskAlert("db-02", "/data", 97, 95); got != `ALERT host="db-02" mount="/data" used=97.0% threshold=95%` {
		t.Errorf(`DiskAlert("db-02", "/data", 97, 95) = %q, want "ALERT host=\"db-02\" mount=\"/data\" used=97.0%% threshold=95%%"`, got)
	}
}

func TestPodRow(t *testing.T) {
	if got := PodRow("api-7d9f8b-x2k4p", 12.5, 256); got != "api-7d9f8b-x2k4p  12.5%   256 MiB" {
		t.Errorf(`PodRow("api-7d9f8b-x2k4p", 12.5, 256) = %q, want "api-7d9f8b-x2k4p  12.5%%   256 MiB"`, got)
	}

	if got := PodRow("worker-5c6d-abcd", 100, 2048); got != "worker-5c6d-abcd 100.0%  2048 MiB" {
		t.Errorf(`PodRow("worker-5c6d-abcd", 100, 2048) = %q, want "worker-5c6d-abcd 100.0%%  2048 MiB"`, got)
	}

	if got := PodRow("db-0", 3.04, 16384); got != "db-0               3.0% 16384 MiB" {
		t.Errorf(`PodRow("db-0", 3.04, 16384) = %q, want "db-0               3.0%% 16384 MiB"`, got)
	}
}
