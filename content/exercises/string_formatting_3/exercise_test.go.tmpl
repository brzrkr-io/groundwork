package formatting

import "testing"

func TestUptimeLine(t *testing.T) {
	tests := []struct {
		name    string
		service string
		uptime  float64
		target  float64
		want    string
	}{
		{name: "checkout", service: "checkout", uptime: 99.95, target: 99.9, want: "checkout: 99.95% uptime (target 99.90%)"},
		{name: "auth", service: "auth", uptime: 100, target: 99.5, want: "auth: 100.00% uptime (target 99.50%)"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := UptimeLine(tt.service, tt.uptime, tt.target)
			if got != tt.want {
				t.Errorf("UptimeLine(%q, %v, %v) = %q, want %q", tt.service, tt.uptime, tt.target, got, tt.want)
			}
		})
	}
}

func TestDiskAlert(t *testing.T) {
	tests := []struct {
		name      string
		host      string
		mount     string
		used      float64
		threshold int
		want      string
	}{
		{name: "var on web-01", host: "web-01", mount: "/var", used: 91.27, threshold: 90, want: `ALERT host="web-01" mount="/var" used=91.3% threshold=90%`},
		{name: "data on db-02", host: "db-02", mount: "/data", used: 97, threshold: 95, want: `ALERT host="db-02" mount="/data" used=97.0% threshold=95%`},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := DiskAlert(tt.host, tt.mount, tt.used, tt.threshold)
			if got != tt.want {
				t.Errorf("DiskAlert(%q, %q, %v, %d) = %q, want %q", tt.host, tt.mount, tt.used, tt.threshold, got, tt.want)
			}
		})
	}
}

func TestPodRow(t *testing.T) {
	tests := []struct {
		name   string
		pod    string
		cpu    float64
		memMiB int
		want   string
	}{
		{name: "api pod", pod: "api-7d9f8b-x2k4p", cpu: 12.5, memMiB: 256, want: "api-7d9f8b-x2k4p  12.5%   256 MiB"},
		{name: "busy worker", pod: "worker-5c6d-abcd", cpu: 100, memMiB: 2048, want: "worker-5c6d-abcd 100.0%  2048 MiB"},
		{name: "short name", pod: "db-0", cpu: 3.04, memMiB: 16384, want: "db-0               3.0% 16384 MiB"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := PodRow(tt.pod, tt.cpu, tt.memMiB)
			if got != tt.want {
				t.Errorf("PodRow(%q, %v, %d) = %q, want %q", tt.pod, tt.cpu, tt.memMiB, got, tt.want)
			}
		})
	}
}
