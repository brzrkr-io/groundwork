// Package clients reads and writes Kubernetes objects through client-go.
package clients

import (
	"context"
	"fmt"

	corev1 "k8s.io/api/core/v1"
	apierrors "k8s.io/apimachinery/pkg/api/errors"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/client-go/kubernetes"
)

// DeploymentImage returns the image of the first container in the
// Deployment namespace/name.
func DeploymentImage(ctx context.Context, cs kubernetes.Interface, namespace, name string) (string, error) {
	d, err := cs.AppsV1().Deployments(namespace).Get(ctx, name, metav1.GetOptions{})
	if err != nil {
		return "", err
	}
	containers := d.Spec.Template.Spec.Containers
	if len(containers) == 0 {
		return "", fmt.Errorf("deployment %s/%s has no containers", namespace, name)
	}
	return containers[0].Image, nil
}

// CreateConfigMap creates a ConfigMap called name in namespace holding data,
// and returns the ConfigMap the API server sent back.
func CreateConfigMap(ctx context.Context, cs kubernetes.Interface, namespace, name string, data map[string]string) (*corev1.ConfigMap, error) {
	cm := &corev1.ConfigMap{
		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace},
		Data:       data,
	}
	return cs.CoreV1().ConfigMaps(namespace).Create(ctx, cm, metav1.CreateOptions{})
}

// DeleteDeploymentIfExists deletes the Deployment namespace/name. It reports
// whether something was deleted. A Deployment that does not exist is not an
// error.
func DeleteDeploymentIfExists(ctx context.Context, cs kubernetes.Interface, namespace, name string) (bool, error) {
	err := cs.AppsV1().Deployments(namespace).Delete(ctx, name, metav1.DeleteOptions{})
	if apierrors.IsNotFound(err) {
		return false, nil // already gone: nothing to do
	}
	if err != nil {
		return false, err
	}
	return true, nil
}
