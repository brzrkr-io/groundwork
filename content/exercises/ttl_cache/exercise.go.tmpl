// Package cache is the Groundwork exercise "TTL caching: expire on read".
package cache

import (
	"sync"
	"time"
)

// entry is one stored value and the moment it stops being fresh.
type entry[V any] struct {
	value     V
	expiresAt time.Time
}

// Cache stores values for a fixed time to live (TTL). It is safe for
// concurrent use.
type Cache[K comparable, V any] struct {
	mu    sync.Mutex
	ttl   time.Duration
	now   func() time.Time // the clock; tests pass a fake one
	items map[K]entry[V]
}

// New returns an empty Cache whose entries live for ttl.
func New[K comparable, V any](ttl time.Duration, now func() time.Time) *Cache[K, V] {
	return &Cache[K, V]{ttl: ttl, now: now, items: make(map[K]entry[V])}
}

// Set stores v under k. It expires ttl from now, replacing any older entry.
func (c *Cache[K, V]) Set(k K, v V) {
	c.mu.Lock()
	defer c.mu.Unlock()
	// TODO(1): Store v with an expiry time of now + ttl.
}

