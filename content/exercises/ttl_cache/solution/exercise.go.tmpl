// Package cache is the Groundwork exercise "TTL caching: expire on read".
package cache

import (
	"sync"
	"time"
)

// entry is one stored value and the moment it stops being fresh.
type entry[V any] struct {
	value     V
	expiresAt time.Time
}

// Cache stores values for a fixed time to live (TTL). It is safe for
// concurrent use.
type Cache[K comparable, V any] struct {
	mu    sync.Mutex
	ttl   time.Duration
	now   func() time.Time // the clock; tests pass a fake one
	items map[K]entry[V]
}

// New returns an empty Cache whose entries live for ttl.
func New[K comparable, V any](ttl time.Duration, now func() time.Time) *Cache[K, V] {
	return &Cache[K, V]{ttl: ttl, now: now, items: make(map[K]entry[V])}
}

// Set stores v under k. It expires ttl from now, replacing any older entry.
func (c *Cache[K, V]) Set(k K, v V) {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.items[k] = entry[V]{value: v, expiresAt: c.now().Add(c.ttl)}
}

// Get returns the value stored under k and true. If k is missing or expired
// it returns the zero value and false, and deletes an expired entry.
func (c *Cache[K, V]) Get(k K) (V, bool) {
	c.mu.Lock()
	defer c.mu.Unlock()
	e, ok := c.items[k]
	if !ok || !c.now().Before(e.expiresAt) {
		delete(c.items, k) // does nothing if k is missing
		var zero V
		return zero, false
	}
	return e.value, true
}

// Delete removes k from the cache. Deleting a missing key does nothing.
func (c *Cache[K, V]) Delete(k K) {
	c.mu.Lock()
	defer c.mu.Unlock()
	delete(c.items, k)
}

// Len returns how many entries the cache holds, including expired entries
// that have not been removed yet.
func (c *Cache[K, V]) Len() int {
	c.mu.Lock()
	defer c.mu.Unlock()
	return len(c.items)
}

// Cleanup removes every expired entry and returns how many it removed.
func (c *Cache[K, V]) Cleanup() int {
	c.mu.Lock()
	defer c.mu.Unlock()
	now := c.now()
	removed := 0
	for k, e := range c.items {
		if !now.Before(e.expiresAt) {
			delete(c.items, k)
			removed++
		}
	}
	return removed
}
