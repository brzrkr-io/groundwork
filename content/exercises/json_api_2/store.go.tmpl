package jsonapi

import (
	"errors"
	"sync"
)

// Alert is one firing alert.
type Alert struct {
	Name     string `json:"name"`
	Severity string `json:"severity"`
	Summary  string `json:"summary"`
}

// Validate reports what is wrong with a, or returns nil if a is fine.
func (a Alert) Validate() error {
	if a.Name == "" {
		return errors.New("name is required")
	}
	switch a.Severity {
	case "info", "warning", "critical":
		return nil
	}
	return errors.New("severity must be info, warning or critical")
}

// ErrExists means an alert with that name is already stored.
var ErrExists = errors.New("alert already exists")

// Store keeps alerts in memory. The mutex keeps concurrent requests from
// corrupting the map; Mutexes are covered in the Concurrency module.
type Store struct {
	mu     sync.Mutex
	alerts map[string]Alert
}

// NewStore returns a store that already holds the given alerts.
func NewStore(alerts ...Alert) *Store {
	s := &Store{alerts: make(map[string]Alert)}
	for _, a := range alerts {
		s.alerts[a.Name] = a
	}
	return s
}

// All returns every alert, in no particular order. When the store is empty
// it returns a nil slice.
func (s *Store) All() []Alert {
	s.mu.Lock()
	defer s.mu.Unlock()
	var all []Alert
	for _, a := range s.alerts {
		all = append(all, a)
	}
	return all
}

// Create saves a. It fails only with ErrExists, when the name is taken.
func (s *Store) Create(a Alert) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, ok := s.alerts[a.Name]; ok {
		return ErrExists
	}
	s.alerts[a.Name] = a
	return nil
}
