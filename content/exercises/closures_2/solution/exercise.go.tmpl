// Package closures is the Groundwork exercise "Functions as values: state that sticks".
package closures

import "strconv"

// NewErrorCounter returns a function that returns 1, 2, 3, ... on
// successive calls.
func NewErrorCounter() func() int {
	count := 0
	return func() int {
		count++
		return count
	}
}

// NewIDGenerator returns a function that returns "prefix-1", "prefix-2", ...
// on successive calls.
func NewIDGenerator(prefix string) func() string {
	n := 0
	return func() string {
		n++
		return prefix + "-" + strconv.Itoa(n)
	}
}

// NewRateLimiter returns a function that allows the first limit calls and
// refuses every call after that.
func NewRateLimiter(limit int) func() bool {
	calls := 0
	return func() bool {
		calls++
		return calls <= limit
	}
}
