package controller

import appsv1 "k8s.io/api/apps/v1"

// ExposeLabel is the label that asks this controller for a Service.
// Only the exact value "true" counts.
const ExposeLabel = "gopherlings.dev/expose"

// Key returns the work-queue key for d: "namespace/name".
func Key(d *appsv1.Deployment) string {
	return d.Namespace + "/" + d.Name
}

// Exposed reports whether d carries ExposeLabel with the value "true".
func Exposed(d *appsv1.Deployment) bool {
	// Reading a missing key from a nil map is fine: it returns "".
	return d.Labels[ExposeLabel] == "true"
}
