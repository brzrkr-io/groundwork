// Package config is the Groundwork exercise "Decoding JSON: load a service config".
package config

import (
	"errors"
	"io"
)

// HealthCheck says how the platform checks that the service is alive.
type HealthCheck struct {
	Path     string `json:"path"`
	Interval string `json:"interval"`
}

// Config is a service's deploy configuration.
type Config struct {
	Service     string            `json:"service"`
	Port        int               `json:"port"`
	Replicas    int               `json:"replicas"`
	Regions     []string          `json:"regions"`
	HealthCheck HealthCheck       `json:"healthcheck"`
	Labels      map[string]string `json:"labels"`
}

// ErrNoSeverity means an alert payload has no usable labels.severity string.
var ErrNoSeverity = errors.New("alert has no severity")

// ParseConfig decodes a JSON config and defaults Replicas to 1.
func ParseConfig(data []byte) (Config, error) {
	var cfg Config
	// TODO(1): Decode data into cfg with json.Unmarshal, wrap errors as
	// "parse config: %w", and default Replicas to 1 when it is 0.
	return cfg, nil
}

// LoadStrict decodes a JSON config from r and rejects unknown keys.
func LoadStrict(r io.Reader) (Config, error) {
	var cfg Config
	// TODO(2): Decode from r with a json.Decoder that disallows unknown
	// fields. Wrap errors as "load config: %w".
	return cfg, nil
}

// Severity returns labels.severity from an alert payload of unknown shape.
func Severity(data []byte) (string, error) {
	// TODO(3): Decode into a map[string]any and dig out labels -> severity.
	// Return ErrNoSeverity when a step is missing or has the wrong type.
	return "", ErrNoSeverity
}
