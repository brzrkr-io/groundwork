// Package events is the Gopherlings exercise "Encoding JSON: fix the alert stream".
package events

import (
	"encoding/json"
	"io"
	"time"
)

// auditRecord is one entry in the audit log.
//
// TODO(1): AuditJSON always returns "{}". Fix this struct so every field is
// encoded, with the keys "time", "user", "action" and "target".
type auditRecord struct {
	at     time.Time
	user   string
	action string
	target string
}

// AuditJSON encodes one audit log entry as a single line of JSON.
func AuditJSON(user, action, target string, at time.Time) (string, error) {
	rec := auditRecord{at: at, user: user, action: action, target: target}
	b, err := json.Marshal(rec)
	if err != nil {
		return "", err
	}
	return string(b), nil
}

// Alert is an alert event sent to the log collector.
