package tags

import "testing"

// sampleTags is a typical set of tags on one of our cloud resources.
var sampleTags = []Tag{
	{Key: "env", Value: "prod"},
	{Key: "team", Value: "sre"},
	{Key: "region", Value: "eu-west-1"},
	{Key: "tier", Value: "backend"},
}

func BenchmarkFormatTags(b *testing.B) {
	b.ReportAllocs()
	for b.Loop() {
		FormatTags(sampleTags)
	}
}
