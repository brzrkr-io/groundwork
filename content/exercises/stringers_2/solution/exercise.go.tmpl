// Package stringers2 is the Gopherlings exercise "Stringers: pod phases and uptime".
package stringers2

import "fmt"

// Phase is where a pod is in its lifecycle.
type Phase int

// The pod phases, in the same order as Kubernetes lists them.
const (
	Pending Phase = iota
	Running
	Succeeded
	Failed
	Unknown
)

// phaseNames holds the name of each Phase, indexed by its value.
// It must list the names in the same order as the constants above.
var phaseNames = []string{"Pending", "Running", "Succeeded", "Failed", "Unknown"}

// String returns the phase's name, such as "Running".
func (p Phase) String() string {
	if p < 0 || int(p) >= len(phaseNames) {
		return fmt.Sprintf("Phase(%d)", int(p))
	}
	return phaseNames[p]
}

// PodStatusLine describes a pod, such as "pod api-7f9c is Running".
func PodStatusLine(name string, phase Phase) string {
	// %v calls phase.String(); %d would print the raw number.
	return fmt.Sprintf("pod %s is %v", name, phase)
}

// Uptime is how long something has been running, in seconds.
type Uptime int

// Time units, in seconds.
const (
	Minute = 60
	Hour   = 60 * Minute
	Day    = 24 * Hour
)

// String returns the uptime in its two largest units, such as "12m 5s".
func (u Uptime) String() string {
	s := int(u)
	switch {
	case s < Minute:
		return fmt.Sprintf("%ds", s)
	case s < Hour:
		return fmt.Sprintf("%dm %ds", s/Minute, s%Minute)
	case s < Day:
		return fmt.Sprintf("%dh %dm", s/Hour, s%Hour/Minute)
	default:
		return fmt.Sprintf("%dd %dh", s/Day, s%Day/Hour)
	}
}
