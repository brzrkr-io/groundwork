package text

import "testing"

func TestRedact(t *testing.T) {
	tests := []struct {
		name   string
		line   string
		secret string
		want   string
	}{
		{name: "one copy", line: "password=hunter2 user=bob", secret: "hunter2", want: "password=******* user=bob"},
		{name: "two copies", line: "token=abc123 retry token=abc123", secret: "abc123", want: "token=****** retry token=******"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := Redact(tt.line, tt.secret)
			if got != tt.want {
				t.Errorf("Redact(%q, %q) = %q, want %q", tt.line, tt.secret, got, tt.want)
			}
		})
	}
}

func TestHostFromURL(t *testing.T) {
	tests := []struct {
		name string
		url  string
		want string
	}{
		{name: "scheme, slash and capitals", url: "https://API.Example.com/", want: "api.example.com"},
		{name: "no trailing slash", url: "https://grafana.internal", want: "grafana.internal"},
		{name: "no scheme", url: "vault.internal/", want: "vault.internal"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := HostFromURL(tt.url)
			if got != tt.want {
				t.Errorf("HostFromURL(%q) = %q, want %q", tt.url, got, tt.want)
			}
		})
	}
}

func TestEnvVarName(t *testing.T) {
	tests := []struct {
		name    string
		service string
		setting string
		want    string
	}{
		{name: "dash and space", service: "checkout-api", setting: "db url", want: "CHECKOUT_API_DB_URL"},
		{name: "dash in setting", service: "auth", setting: "log-level", want: "AUTH_LOG_LEVEL"},
		{name: "several of each", service: "payment-gateway", setting: "max open conns", want: "PAYMENT_GATEWAY_MAX_OPEN_CONNS"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := EnvVarName(tt.service, tt.setting)
			if got != tt.want {
				t.Errorf("EnvVarName(%q, %q) = %q, want %q", tt.service, tt.setting, got, tt.want)
			}
		})
	}
}
