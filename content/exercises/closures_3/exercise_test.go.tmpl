package closures

import "testing"

func TestRetryWithBackoff(t *testing.T) {
	// op counts its calls and returns true on attempt number succeedsOn
	// (0 means it never succeeds).
	// sleep remembers how often it was called, the total seconds slept,
	// and the last number of seconds it was given.
	// Before each check we reset everything and pick a new succeedsOn.
	calls := 0
	succeedsOn := 0
	op := func(attempt int) bool {
		calls++
		if attempt != calls {
			t.Errorf("call %d got attempt %d, want %d", calls, attempt, calls)
		}
		return attempt == succeedsOn
	}
	sleeps, total, last := 0, 0, 0
	sleep := func(seconds int) {
		sleeps++
		total += seconds
		last = seconds
	}

	// Succeeds straight away: no sleeping.
	calls, sleeps, total, last = 0, 0, 0, 0
	succeedsOn = 1
	if !RetryWithBackoff(5, 1, op, sleep) {
		t.Errorf("RetryWithBackoff(5, 1, succeeds on 1) = false, want true")
	}
	if sleeps != 0 {
		t.Errorf("RetryWithBackoff(5, 1, succeeds on 1) slept %d times, want 0", sleeps)
	}

	// Succeeds on attempt 4: sleeps 1, 2, then 4 seconds.
	calls, sleeps, total, last = 0, 0, 0, 0
	succeedsOn = 4
	if !RetryWithBackoff(5, 1, op, sleep) {
		t.Errorf("RetryWithBackoff(5, 1, succeeds on 4) = false, want true")
	}
	if sleeps != 3 || total != 7 || last != 4 {
		t.Errorf("RetryWithBackoff(5, 1, succeeds on 4) slept %d times, %d seconds in total, last %d; want 3 times, 7 seconds, last 4", sleeps, total, last)
	}

	// Succeeds on the last attempt: sleeps 2, then 4 seconds.
	calls, sleeps, total, last = 0, 0, 0, 0
	succeedsOn = 3
	if !RetryWithBackoff(3, 2, op, sleep) {
		t.Errorf("RetryWithBackoff(3, 2, succeeds on 3) = false, want true")
	}
	if sleeps != 2 || total != 6 || last != 4 {
		t.Errorf("RetryWithBackoff(3, 2, succeeds on 3) slept %d times, %d seconds in total, last %d; want 2 times, 6 seconds, last 4", sleeps, total, last)
	}

	// Never succeeds: sleeps between attempts, but not after the last one.
	calls, sleeps, total, last = 0, 0, 0, 0
	succeedsOn = 0
	if RetryWithBackoff(3, 2, op, sleep) {
		t.Errorf("RetryWithBackoff(3, 2, never succeeds) = true, want false")
	}
	if sleeps != 2 || total != 6 || last != 4 {
		t.Errorf("RetryWithBackoff(3, 2, never succeeds) slept %d times, %d seconds in total, last %d; want 2 times, 6 seconds, last 4", sleeps, total, last)
	}

	calls, sleeps, total, last = 0, 0, 0, 0
	succeedsOn = 0
	if RetryWithBackoff(1, 5, op, sleep) {
		t.Errorf("RetryWithBackoff(1, 5, never succeeds) = true, want false")
	}
	if sleeps != 0 {
		t.Errorf("RetryWithBackoff(1, 5, never succeeds) slept %d times, want 0", sleeps)
	}
}

func TestNewCircuitBreaker(t *testing.T) {
	// A new breaker is closed.
	_, isOpen := NewCircuitBreaker(3)
	if isOpen() {
		t.Errorf("NewCircuitBreaker(3) with no calls: isOpen() = true, want false")
	}

	// Two failures are not enough to open it.
	record, isOpen := NewCircuitBreaker(3)
	record(false)
	record(false)
	if isOpen() {
		t.Errorf("NewCircuitBreaker(3) after fail, fail: isOpen() = true, want false")
	}

	// Three failures in a row open it.
	record, isOpen = NewCircuitBreaker(3)
	record(false)
	record(false)
	record(false)
	if !isOpen() {
		t.Errorf("NewCircuitBreaker(3) after fail, fail, fail: isOpen() = false, want true")
	}

	// More failures keep it open.
	record, isOpen = NewCircuitBreaker(3)
	record(false)
	record(false)
	record(false)
	record(false)
	record(false)
	if !isOpen() {
		t.Errorf("NewCircuitBreaker(3) after 5 fails: isOpen() = false, want true")
	}

	// A success resets the count.
	record, isOpen = NewCircuitBreaker(3)
	record(false)
	record(false)
	record(false)
	record(true)
	if isOpen() {
		t.Errorf("NewCircuitBreaker(3) after fail, fail, fail, success: isOpen() = true, want false")
	}

	// The failures must come in a row.
	record, isOpen = NewCircuitBreaker(3)
	record(false)
	record(false)
	record(true)
	record(false)
	record(false)
	if isOpen() {
		t.Errorf("NewCircuitBreaker(3) after fail, fail, success, fail, fail: isOpen() = true, want false")
	}

	// With a threshold of 1, one failure opens it.
	record, isOpen = NewCircuitBreaker(1)
	record(true)
	record(false)
	if !isOpen() {
		t.Errorf("NewCircuitBreaker(1) after success, fail: isOpen() = false, want true")
	}
}
