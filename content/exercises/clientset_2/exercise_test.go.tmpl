// deployment builds a Deployment with labels, a replica count and one container.
func deployment(namespace, name, image string, replicas int32) *appsv1.Deployment {
	labels := map[string]string{"app": name}
	return &appsv1.Deployment{
		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace, Labels: labels},
		Spec: appsv1.DeploymentSpec{
			Replicas: new(replicas),
			Selector: &metav1.LabelSelector{MatchLabels: labels},
			Template: corev1.PodTemplateSpec{
				ObjectMeta: metav1.ObjectMeta{Labels: labels},
				Spec: corev1.PodSpec{
					Containers: []corev1.Container{{Name: name, Image: image}},
				},
			},
		},
	}
}

// configMap builds a ConfigMap owned by the payments team.
func configMap(namespace, name string, data map[string]string) *corev1.ConfigMap {
	return &corev1.ConfigMap{
		ObjectMeta: metav1.ObjectMeta{
			Name:      name,
			Namespace: namespace,
			Labels:    map[string]string{"team": "payments"},
		},
		Data: data,
	}
}

// countActions counts the requests the fake clientset received with the
// given verb ("get", "create", "update", ...) for the given resource.
func countActions(cs *fake.Clientset, verb, resource string) int {
	n := 0
	for _, a := range cs.Actions() {
		if a.GetVerb() == verb && a.GetResource().Resource == resource {
			n++
		}
	}
	return n
}

func TestScaleDeployment(t *testing.T) {
	ctx := context.Background()

	tests := []struct {
		namespace, name, image string
		replicas               int32
	}{
		{"shop", "web", "registry.example.com/shop/web:2.0.1", 5},
		{"payments", "checkout", "registry.example.com/payments/checkout:1.4.2", 0},
	}
	for _, tt := range tests {
		t.Run(tt.namespace+"/"+tt.name, func(t *testing.T) {
			cs := fake.NewClientset(deployment(tt.namespace, tt.name, tt.image, 2))
			if err := ScaleDeployment(ctx, cs, tt.namespace, tt.name, tt.replicas); err != nil {
				t.Fatalf("ScaleDeployment(%q, %q, %d) = %v, want nil", tt.namespace, tt.name, tt.replicas, err)
			}

			d, err := cs.AppsV1().Deployments(tt.namespace).Get(ctx, tt.name, metav1.GetOptions{})
			if err != nil {
				t.Fatalf("after ScaleDeployment, Get(%q, %q) error = %v", tt.namespace, tt.name, err)
			}
			// A nil Replicas means the default, 1.
			if got := ptr.Deref(d.Spec.Replicas, 1); got != tt.replicas {
				t.Errorf("after ScaleDeployment(%q, %q, %d), replicas = %d, want %d",
					tt.namespace, tt.name, tt.replicas, got, tt.replicas)
			}
			if d.Labels["app"] != tt.name {
				t.Errorf("after ScaleDeployment(%q, %q, %d), label app = %q, want %q (keep the labels)",
					tt.namespace, tt.name, tt.replicas, d.Labels["app"], tt.name)
			}
			containers := d.Spec.Template.Spec.Containers
			if len(containers) != 1 || containers[0].Image != tt.image {
				t.Errorf("after ScaleDeployment(%q, %q, %d), the Deployment has %d containers, want 1 with image %q (keep the containers)",
					tt.namespace, tt.name, tt.replicas, len(containers), tt.image)
			}
		})
	}

	t.Run("missing deployment", func(t *testing.T) {
		cs := fake.NewClientset()
		for _, name := range []string{"web", "worker"} {
			err := ScaleDeployment(ctx, cs, "shop", name, 3)
			if !apierrors.IsNotFound(err) {
				t.Errorf("ScaleDeployment(%q, %q, 3) = %v, want a NotFound error", "shop", name, err)
			}
		}
	})
}

func TestApplyConfigMap(t *testing.T) {
	ctx := context.Background()

	tests := []struct {
		name     string
		existing map[string]string // nil means the ConfigMap does not exist yet
		data     map[string]string
	}{
		{"creates missing", nil, map[string]string{"currency": "EUR"}},
		{"creates missing with two keys", nil, map[string]string{"currency": "USD", "retries": "3"}},
		{"updates existing", map[string]string{"currency": "EUR"}, map[string]string{"currency": "GBP"}},
		{"updates existing with new key", map[string]string{"currency": "EUR"}, map[string]string{"currency": "EUR", "retries": "5"}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			cs := fake.NewClientset()
			if tt.existing != nil {
				cs = fake.NewClientset(configMap("payments", "gateway-config", tt.existing))
			}

			got, err := ApplyConfigMap(ctx, cs, "payments", "gateway-config", tt.data)
			if err != nil {
				t.Fatalf("ApplyConfigMap(%q, %q, %v) error = %v, want nil", "payments", "gateway-config", tt.data, err)
			}
			if got == nil {
				t.Fatalf("ApplyConfigMap(%q, %q, %v) returned a nil ConfigMap, want the stored ConfigMap", "payments", "gateway-config", tt.data)
			}
			if !maps.Equal(got.Data, tt.data) {
				t.Errorf("ApplyConfigMap(%q, %q, %v) returned data %v, want %v", "payments", "gateway-config", tt.data, got.Data, tt.data)
			}

			stored, err := cs.CoreV1().ConfigMaps("payments").Get(ctx, "gateway-config", metav1.GetOptions{})
			if err != nil {
				t.Fatalf("after ApplyConfigMap, Get error = %v, want the ConfigMap to exist", err)
			}
			if !maps.Equal(stored.Data, tt.data) {
				t.Errorf("after ApplyConfigMap(%v), stored data = %v, want %v", tt.data, stored.Data, tt.data)
			}
			if tt.existing != nil && stored.Labels["team"] != "payments" {
				t.Errorf("after ApplyConfigMap(%v), label team = %q, want %q (keep the existing labels)", tt.data, stored.Labels["team"], "payments")
			}
		})
	}

	t.Run("other errors", func(t *testing.T) {
		cs := fake.NewClientset()
		// PrependReactor makes the fake fail every ConfigMap create, as if
		// the API server were unreachable.
		cs.PrependReactor("create", "configmaps", func(k8stesting.Action) (bool, runtime.Object, error) {
			return true, nil, errors.New("connection refused")
		})
		for _, name := range []string{"gateway-config", "ledger-config"} {
			if _, err := ApplyConfigMap(ctx, cs, "payments", name, map[string]string{"currency": "EUR"}); err == nil {
				t.Errorf("ApplyConfigMap(%q, %q, ...) error = nil, want an error", "payments", name)
			}
		}
	})
}

func TestApplyConfigMapSkipsNoOpUpdates(t *testing.T) {
	ctx := context.Background()

	tests := []struct {
		name        string
		existing    map[string]string
		data        map[string]string
		wantUpdates int
	}{
		{"same data", map[string]string{"currency": "EUR"}, map[string]string{"currency": "EUR"}, 0},
		{"same two keys", map[string]string{"currency": "USD", "retries": "3"}, map[string]string{"currency": "USD", "retries": "3"}, 0},
		{"changed data", map[string]string{"currency": "EUR"}, map[string]string{"currency": "GBP"}, 1},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			cs := fake.NewClientset(configMap("payments", "gateway-config", tt.existing))

			got, err := ApplyConfigMap(ctx, cs, "payments", "gateway-config", tt.data)
			if err != nil {
				t.Fatalf("ApplyConfigMap(%q, %q, %v) error = %v, want nil", "payments", "gateway-config", tt.data, err)
			}
			if got == nil {
				t.Fatalf("ApplyConfigMap(%q, %q, %v) returned a nil ConfigMap, want the stored ConfigMap", "payments", "gateway-config", tt.data)
			}
			if !maps.Equal(got.Data, tt.data) {
				t.Errorf("ApplyConfigMap(%q, %q, %v) returned data %v, want %v", "payments", "gateway-config", tt.data, got.Data, tt.data)
			}
			if n := countActions(cs, "update", "configmaps"); n != tt.wantUpdates {
				t.Errorf("ApplyConfigMap(%q, %q, %v) sent %d updates for existing data %v, want %d",
					"payments", "gateway-config", tt.data, n, tt.existing, tt.wantUpdates)
			}
		})
	}
}
