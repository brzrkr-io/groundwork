// Package inventory is the Gopherlings exercise "Slices: fix the inventory script".
package inventory

// SkipHeader returns every line after the header line.
func SkipHeader(lines []string) []string {
	// TODO(1): This drops the last host. Fix the bounds.
	return lines[1 : len(lines)-1]
}

// Drain returns the hosts before index i and the hosts after it, leaving out
// hosts[i].
func Drain(hosts []string, i int) (before, after []string) {
	before = hosts[:i]
	// TODO(2): after still contains hosts[i]. Fix the bounds.
	after = hosts[i:]
	return before, after
}

// LastHost returns the last host, or "" when there are no hosts.
func LastHost(hosts []string) string {
	// TODO(3): This panics when hosts is empty. Return "" in that case.
	return hosts[len(hosts)-1]
}
