package functions

import "testing"

func TestUsageLine(t *testing.T) {
	// Each line is one case: the inputs, then the answer we want.
	cases := []struct {
		service     string
		used, total float64
		want        string
	}{
		{"api", 3, 8, "api: 37.5% CPU"},
		{"worker", 1, 4, "worker: 25.0% CPU"},
		{"db", 2, 2, "db: 100.0% CPU"},
	}
	for _, c := range cases {
		t.Run(c.service, func(t *testing.T) {
			if got := UsageLine(c.service, c.used, c.total); got != c.want {
				t.Errorf("UsageLine(%q, %v, %v) = %q, want %q", c.service, c.used, c.total, got, c.want)
			}
		})
	}
}

func TestTagOrLatest(t *testing.T) {
	cases := []struct {
		tag, want string
	}{
		{"1.4.2", "1.4.2"},
		{"stable", "stable"},
		{"", "latest"},
	}
	for _, c := range cases {
		t.Run(c.want, func(t *testing.T) {
			if got := TagOrLatest(c.tag); got != c.want {
				t.Errorf("TagOrLatest(%q) = %q, want %q", c.tag, got, c.want)
			}
		})
	}
}

func TestImageRef(t *testing.T) {
	cases := []struct {
		registry, name, tag, want string
	}{
		{"ghcr.io/acme", "api", "1.4.2", "ghcr.io/acme/api:1.4.2"},
		{"docker.io", "nginx", "", "docker.io/nginx:latest"},
		{"registry.local", "worker", "v2", "registry.local/worker:v2"},
	}
	for _, c := range cases {
		t.Run(c.want, func(t *testing.T) {
			if got := ImageRef(c.registry, c.name, c.tag); got != c.want {
				t.Errorf("ImageRef(%q, %q, %q) = %q, want %q", c.registry, c.name, c.tag, got, c.want)
			}
		})
	}
}
