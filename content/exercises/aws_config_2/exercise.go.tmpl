// Package awsconfig is the Gopherlings exercise "AWS SDK configuration: many regions, no leaked keys".
package awsconfig

import (
	"context"
	"fmt"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/config"
)

// ForRegions returns one copy of cfg per region, in the same order as
// regions, each with its Region set. cfg itself is not changed.
func ForRegions(cfg aws.Config, regions []string) []aws.Config {
	out := make([]aws.Config, 0, len(regions))
	// TODO(1): For each region, append a copy of cfg with that Region to out.
	return out
}

// LoadProfile loads the config for profile from the shared files. A
// non-empty region always wins over AWS_REGION and the profile's region.
func LoadProfile(ctx context.Context, profile, region string) (aws.Config, error) {
	cfg, err := config.LoadDefaultConfig(ctx, config.WithSharedConfigProfile(profile))
	if err != nil {
		return aws.Config{}, err
	}
	// TODO(2): Fix the bug: the region override is ignored whenever the
	// profile or AWS_REGION already sets a region.
	if cfg.Region == "" {
		cfg.Region = region
	}
	return cfg, nil
}

// mask keeps the first 4 characters of s and hides the rest.
func mask(s string) string {
	if len(s) <= 4 {
		return "****"
	}
	return s[:4] + "****"
}

// Summary returns a log-safe line describing cfg, such as
// "region=us-east-1 key=AKIA**** temporary=no".
func Summary(ctx context.Context, cfg aws.Config) (string, error) {
	creds, err := cfg.Credentials.Retrieve(ctx)
	if err != nil {
		return "", err
	}
	// TODO(3): Fix the bug: this line still leaks the secret key and session
	// token into the deploy log.
	return fmt.Sprintf("region=%s key=%s secret=%s token=%s",
		cfg.Region, mask(creds.AccessKeyID), creds.SecretAccessKey, creds.SessionToken), nil
}
