package zerovalues

import "testing"

func TestEffectiveTimeout(t *testing.T) {
	// Each line is one case: the inputs, then the answer we want.
	tests := []struct {
		request, service, global int
		want                     int
	}{
		{5, 10, 60, 5},
		{0, 10, 60, 10},
		{0, 0, 60, 60},
		{0, 0, 0, 30},
		{7, 0, 0, 7},
		{0, 15, 0, 15},
	}
	for _, tt := range tests {
		t.Run("", func(t *testing.T) {
			if got := EffectiveTimeout(tt.request, tt.service, tt.global); got != tt.want {
				t.Errorf("EffectiveTimeout(%d, %d, %d) = %d, want %d", tt.request, tt.service, tt.global, got, tt.want)
			}
		})
	}
}

func TestProbeConfig(t *testing.T) {
	// Each line is one case: the inputs, then the answer we want.
	tests := []struct {
		path   string
		port   int
		period int
		want   string
	}{
		{"", 0, 0, "GET /healthz on :8080 every 10s"},
		{"/ready", 9090, 5, "GET /ready on :9090 every 5s"},
		{"/live", 0, 30, "GET /live on :8080 every 30s"},
		{"", 3000, 0, "GET /healthz on :3000 every 10s"},
	}
	for _, tt := range tests {
		t.Run(tt.want, func(t *testing.T) {
			if got := ProbeConfig(tt.path, tt.port, tt.period); got != tt.want {
				t.Errorf("ProbeConfig(%q, %d, %d) = %q, want %q", tt.path, tt.port, tt.period, got, tt.want)
			}
		})
	}
}
