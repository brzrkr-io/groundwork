// ProbeConfig describes an HTTP health probe, filling in defaults.
func ProbeConfig(path string, port, periodSeconds int) string {
	// TODO(2): Default path to "/healthz", port to 8080, periodSeconds to 10,
	// then return "GET PATH on :PORT every Ns".
	return fmt.Sprintf("%s %d %d", path, port, periodSeconds)
}
