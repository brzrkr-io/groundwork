// EffectiveTimeout returns the first non-zero timeout of request, service and
// global, or 30 when none is set.
func EffectiveTimeout(requestSeconds, serviceSeconds, globalSeconds int) int {
	// TODO(1): Return the first non-zero value, in order; 30 if all are 0.
