package functions

import "testing"

func TestMiBToBytes(t *testing.T) {
	if got := MiBToBytes(1); got != 1048576 {
		t.Errorf("MiBToBytes(1) = %d, want 1048576", got)
	}
	if got := MiBToBytes(512); got != 536870912 {
		t.Errorf("MiBToBytes(512) = %d, want 536870912", got)
	}
	if got := MiBToBytes(0); got != 0 {
		t.Errorf("MiBToBytes(0) = %d, want 0", got)
	}
}

func TestFormatUnit(t *testing.T) {
	if got := FormatUnit(1536, KiB, "KiB"); got != "1.5 KiB" {
		t.Errorf(`FormatUnit(1536, KiB, "KiB") = %q, want "1.5 KiB"`, got)
	}
	if got := FormatUnit(3*MiB, MiB, "MiB"); got != "3.0 MiB" {
		t.Errorf(`FormatUnit(3 * MiB, MiB, "MiB") = %q, want "3.0 MiB"`, got)
	}
	if got := FormatUnit(5*GiB/2, GiB, "GiB"); got != "2.5 GiB" {
		t.Errorf(`FormatUnit(5 * GiB / 2, GiB, "GiB") = %q, want "2.5 GiB"`, got)
	}
}

func TestHumanBytes(t *testing.T) {
	if got := HumanBytes(500); got != "500 B" {
		t.Errorf(`HumanBytes(500) = %q, want "500 B"`, got)
	}
	if got := HumanBytes(0); got != "0 B" {
		t.Errorf(`HumanBytes(0) = %q, want "0 B"`, got)
	}
	if got := HumanBytes(1024); got != "1.0 KiB" {
		t.Errorf(`HumanBytes(1024) = %q, want "1.0 KiB"`, got)
	}
	if got := HumanBytes(2560); got != "2.5 KiB" {
		t.Errorf(`HumanBytes(2560) = %q, want "2.5 KiB"`, got)
	}
	if got := HumanBytes(MiBToBytes(512)); got != "512.0 MiB" {
		t.Errorf(`HumanBytes(MiBToBytes(512)) = %q, want "512.0 MiB"`, got)
	}
	if got := HumanBytes(3 * GiB / 2); got != "1.5 GiB" {
		t.Errorf(`HumanBytes(3 * GiB / 2) = %q, want "1.5 GiB"`, got)
	}
}
