// Package pointers3 is the Groundwork exercise "Pointers: optional config fields".
package pointers3

// DefaultReplicas is the replica count used when a spec does not set one.
const DefaultReplicas = 1

// DeploymentSpec describes a deployment. A nil Replicas means "not set".
type DeploymentSpec struct {
	Name     string
	Replicas *int
}

// Config is the final, fully resolved config for a service.
type Config struct {
	Image    string
	Replicas int
	Debug    bool
}

// Overrides holds optional changes to a Config. A nil field means "keep the
// current value".
type Overrides struct {
	Image    *string
	Replicas *int
	Debug    *bool
}

// WithReplicas returns a copy of spec with Replicas set to n.
func WithReplicas(spec DeploymentSpec, n int) DeploymentSpec {
	spec.Replicas = new(n)
	return spec
}

// EffectiveReplicas returns the replica count spec asks for, or
// DefaultReplicas when spec.Replicas is nil.
func EffectiveReplicas(spec DeploymentSpec) int {
	if spec.Replicas == nil {
		return DefaultReplicas
	}
	return *spec.Replicas
}

// Merge applies each layer of overrides to base, in order, and returns the
// result. Nil fields in a layer keep the current value.
func Merge(base Config, layers ...Overrides) Config {
	cfg := base
	for _, o := range layers {
		if o.Image != nil {
			cfg.Image = *o.Image
		}
		if o.Replicas != nil {
			cfg.Replicas = *o.Replicas
		}
		if o.Debug != nil {
			cfg.Debug = *o.Debug
		}
	}
	return cfg
}
