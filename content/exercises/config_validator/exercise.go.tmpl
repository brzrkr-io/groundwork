// Package config is the Gopherlings exercise "Practice: config validator".
package config

import "errors"

// Config describes one service to deploy.
type Config struct {
	Name     string
	Image    string
	Port     int
	Replicas int
	Env      map[string]string
}

// Error categories. A FieldError wraps one of these, so callers can ask
// errors.Is(err, ErrRequired) without parsing messages.
var (
	ErrRequired   = errors.New("required")
	ErrOutOfRange = errors.New("out of range")
	ErrInvalid    = errors.New("invalid")
)

// FieldError reports a problem with one field of a Config.
type FieldError struct {
	Field string // which field is wrong, such as "port" or "env.LOG_LEVEL"
	Err   error  // what is wrong; wraps one of the Err* categories
}

// Error returns the field name and the problem, such as "name: required".
func (e *FieldError) Error() string {
	// TODO(1): Return the field, a colon and a space, then the message of e.Err.
	return e.Field
}

// Unwrap returns the error inside e, so errors.Is and errors.AsType can see it.
func (e *FieldError) Unwrap() error {
	// TODO(1): Return the wrapped error.
	return nil
}

