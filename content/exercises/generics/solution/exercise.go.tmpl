// Package generics is the Gopherlings exercise "Generics".
package generics

import "cmp"

// Filter returns the items for which keep returns true, in their original
// order.
func Filter[T any](items []T, keep func(T) bool) []T {
	var kept []T
	for _, item := range items {
		if keep(item) {
			kept = append(kept, item)
		}
	}
	return kept
}

// Max returns the largest item and true, or the zero value of T and false
// when items is empty.
func Max[T cmp.Ordered](items []T) (T, bool) {
	if len(items) == 0 {
		var zero T
		return zero, false
	}
	largest := items[0]
	for _, item := range items[1:] {
		if item > largest {
			largest = item
		}
	}
	return largest, true
}

// Set is a collection of distinct values.
type Set[T comparable] map[T]bool

// NewSet returns a set holding the given items.
func NewSet[T comparable](items ...T) Set[T] {
	s := Set[T]{}
	for _, item := range items {
		s[item] = true
	}
	return s
}

// Add puts v in the set.
func (s Set[T]) Add(v T) {
	s[v] = true
}

// Has reports whether v is in the set.
func (s Set[T]) Has(v T) bool {
	return s[v]
}
