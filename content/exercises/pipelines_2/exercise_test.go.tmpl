package fanin

import (
	"context"
	"slices"
	"testing"
	"testing/synctest"
	"time"
)

// The tests run inside synctest.Test, which gives them a fake clock, and
// synctest.Wait, which waits until every goroutine is finished or stuck.

// receiveAll receives from ch until it is closed and returns everything it
// got, sorted. It fails the test if ch is never closed.
func receiveAll(t *testing.T, ch <-chan string) []string {
	t.Helper()
	if ch == nil {
		t.Fatal("got a nil channel")
	}
	var got []string
	for {
		select {
		case v, ok := <-ch:
			if !ok {
				slices.Sort(got)
				return got
			}
			got = append(got, v)
		case <-time.After(time.Hour):
			t.Fatalf("the channel was never closed (received %q so far)", got)
		}
	}
}

// assertStopped checks, after cancel(), that every goroutine feeding out has
// stopped and out is closed.
func assertStopped(t *testing.T, out <-chan string, what string) {
	t.Helper()
	synctest.Wait() // let every goroutine finish or get stuck
	select {
	case v, ok := <-out:
		if ok {
			t.Errorf("after cancel(), %s was still trying to send %q: that goroutine leaks", what, v)
			for range out { // let the stuck goroutine finish so the test can end
			}
		}
	default:
		t.Errorf("after cancel(), %s did not close its output", what)
	}
}

// sendAll returns a closed, buffered channel holding values.
func sendAll(values ...string) <-chan string {
	ch := make(chan string, len(values))
	for _, v := range values {
		ch <- v
	}
	close(ch)
	return ch
}

func TestGenerate(t *testing.T) {
	t.Run("sends every line", func(t *testing.T) {
		synctest.Test(t, func(t *testing.T) {
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			lines := []string{"db-1", "web-1", "web-2"}
			if got := receiveAll(t, Generate(ctx, lines)); !slices.Equal(got, lines) {
				t.Errorf("Generate(%q) carried %q (sorted), want %q", lines, got, lines)
			}
		})
	})

	tests := []struct {
		name  string
		lines []string
		read  int // how many lines the consumer reads before cancelling
	}{
		{"cancel after one line", []string{"web-1", "web-2", "web-3"}, 1},
		{"cancel straight away", []string{"web-1", "web-2"}, 0},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			synctest.Test(t, func(t *testing.T) {
				ctx, cancel := context.WithCancel(context.Background())
				out := Generate(ctx, tt.lines)
				for range tt.read {
					<-out
				}
				cancel()
				assertStopped(t, out, "Generate")
			})
		})
	}
}

func TestMerge(t *testing.T) {
	tests := []struct {
		name   string
		inputs [][]string
		want   []string // sorted
	}{
		{"two inputs", [][]string{{"web-1", "web-2"}, {"db-1"}}, []string{"db-1", "web-1", "web-2"}},
		{"three inputs", [][]string{{"a"}, {"b", "c"}, {"d", "e", "f"}}, []string{"a", "b", "c", "d", "e", "f"}},
		{"one empty input", [][]string{{"web-1"}, {}}, []string{"web-1"}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			synctest.Test(t, func(t *testing.T) {
				ctx, cancel := context.WithCancel(context.Background())
				defer cancel()
				var inputs []<-chan string
				for _, values := range tt.inputs {
					inputs = append(inputs, sendAll(values...))
				}
				if got := receiveAll(t, Merge(ctx, inputs...)); !slices.Equal(got, tt.want) {
					t.Errorf("Merge(%q) carried %q (sorted), want %q", tt.inputs, got, tt.want)
				}
			})
		})
	}

	t.Run("stops when cancelled", func(t *testing.T) {
		synctest.Test(t, func(t *testing.T) {
			ctx, cancel := context.WithCancel(context.Background())
			out := Merge(ctx, sendAll("a", "b", "c"), sendAll("d", "e", "f"))
			if out == nil {
				t.Fatal("Merge returned a nil channel")
			}
			<-out // read one value, then give up
			cancel()
			assertStopped(t, out, "Merge")
		})
	})
}

func TestFanOut(t *testing.T) {
	tests := []struct {
		name        string
		hosts       []string
		workers     int
		wantElapsed time.Duration // each check takes 1s
	}{
		{"6 hosts, 3 workers", []string{"web-1", "web-2", "web-3", "web-4", "web-5", "web-6"}, 3, 2 * time.Second},
		{"4 hosts, 4 workers", []string{"db-1", "db-2", "web-1", "web-2"}, 4, 1 * time.Second},
		{"3 hosts, 1 worker", []string{"db-1", "web-1", "web-2"}, 1, 3 * time.Second},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			synctest.Test(t, func(t *testing.T) {
				ctx, cancel := context.WithCancel(context.Background())
				defer cancel()
				check := func(host string) string {
					time.Sleep(time.Second) // each check takes 1 second
					return host + " ok"
				}

				start := time.Now()
				got := receiveAll(t, FanOut(ctx, sendAll(tt.hosts...), tt.workers, check))
				elapsed := time.Since(start)

				var want []string
				for _, host := range tt.hosts {
					want = append(want, host+" ok")
				}
				slices.Sort(want)
				if !slices.Equal(got, want) {
					t.Errorf("FanOut(%q, %d) carried %q (sorted), want %q", tt.hosts, tt.workers, got, want)
				}
				if elapsed != tt.wantElapsed {
					t.Errorf("FanOut(%q, %d) took %v, want %v", tt.hosts, tt.workers, elapsed, tt.wantElapsed)
				}
			})
		})
	}
}
