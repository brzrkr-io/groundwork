// Package costs is the Groundwork exercise "Cloud costs: estimates and budget alarms".
package costs

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
)

// HoursPerMonth is how many hours AWS bills for a month of running nonstop.
const HoursPerMonth = 730

// Prices holds the on-demand prices of one region, in US dollars.
type Prices struct {
	Region        string             `json:"region"`
	EC2Hourly     map[string]float64 `json:"ec2_hourly"`           // per instance-hour, by instance type
	EBSPerGB      float64            `json:"ebs_gp3_gb_month"`     // per GB-month of gp3 disk
	S3PerGB       float64            `json:"s3_standard_gb_month"` // per GB-month in S3 Standard
	NATHourly     float64            `json:"nat_hourly"`           // per NAT gateway-hour
	NATPerGB      float64            `json:"nat_gb"`               // per GB through a NAT gateway
	TransferPerGB float64            `json:"transfer_out_gb"`      // per GB out to the internet
}

// LoadPrices reads a price list such as testdata/prices.json.
func LoadPrices(path string) (Prices, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return Prices{}, err
	}
	var p Prices
	err = json.Unmarshal(data, &p)
	return p, err
}

// Item is one line of a monthly estimate. Which fields count depends on
// Service:
//
//	"ec2":      Count instances of InstanceType, each running Hours
//	"ebs":      GB of gp3 disk
//	"s3":       GB stored in S3 Standard
//	"nat":      Count NAT gateways running Hours, plus GB processed
//	"transfer": GB sent out to the internet
type Item struct {
	Service      string
	InstanceType string
	Count        int
	Hours        float64
	GB           float64
}

// Bill is a monthly estimate in US dollars, rounded to cents.
type Bill struct {
	Total     float64
	ByService map[string]float64
}

// LineCost returns what one item costs per month in US dollars, not
// rounded.
func LineCost(item Item, p Prices) (float64, error) {
	switch item.Service {
	case "ec2":
		hourly, ok := p.EC2Hourly[item.InstanceType]
		if !ok {
			return 0, fmt.Errorf("no price for instance type %q", item.InstanceType)
		}
		return float64(item.Count) * item.Hours * hourly, nil
	case "ebs":
		return item.GB * p.EBSPerGB, nil
	case "s3":
		return item.GB * p.S3PerGB, nil
	case "nat":
		return float64(item.Count)*item.Hours*p.NATHourly + item.GB*p.NATPerGB, nil
	case "transfer":
		return item.GB * p.TransferPerGB, nil
	}
	return 0, fmt.Errorf("unknown service %q", item.Service)
}

// Estimate adds up the cost of items, in total and per service.
func Estimate(items []Item, p Prices) (Bill, error) {
	bill := Bill{ByService: map[string]float64{}}
	for _, item := range items {
		cost, err := LineCost(item, p)
		if err != nil {
			return Bill{}, err
		}
		bill.Total += cost
		bill.ByService[item.Service] += cost
	}
	// Round once at the end: rounding every line would add up small errors.
	bill.Total = cents(bill.Total)
	for service, cost := range bill.ByService {
		bill.ByService[service] = cents(cost)
	}
	return bill, nil
}

// cents rounds a dollar amount to two decimals.
func cents(dollars float64) float64 {
	return math.Round(dollars*100) / 100
}

// BudgetAlerts returns the AWS Budgets-style alerts for a monthly budget
// after spending spent in the first day days of a days-long month.
func BudgetAlerts(budget, spent float64, day, days int, thresholds []int) []string {
	forecast := spent / float64(day) * float64(days)
	var alerts []string
	for _, t := range thresholds {
		limit := budget * float64(t) / 100
		if spent >= limit {
			alerts = append(alerts, fmt.Sprintf("ACTUAL %d%%: $%.2f of $%.2f", t, spent, budget))
		} else if forecast >= limit {
			alerts = append(alerts, fmt.Sprintf("FORECASTED %d%%: $%.2f of $%.2f", t, forecast, budget))
		}
	}
	return alerts
}
