package deploy

import (
	"slices"
	"testing"
)

func TestTargets(t *testing.T) {
	tests := []struct {
		name  string
		hosts []string
		port  int
		want  []string
	}{
		{"clean names", []string{"web-1", "web-2"}, 8080, []string{"web-1:8080", "web-2:8080"}},
		{"messy names", []string{" Web-1", "web-2 "}, 443, []string{"web-1:443", "web-2:443"}},
		{"no hosts", []string{}, 80, []string{}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := Targets(tt.hosts, tt.port)
			if !slices.Equal(got, tt.want) {
				t.Errorf("Targets(%q, %d) = %q, want %q", tt.hosts, tt.port, got, tt.want)
			}
		})
	}
}
