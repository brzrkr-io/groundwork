// Package report formats the deploy status report for the on-call channel.
package report

import "groundwork.local/internal_packages_2/deploy"

// Line returns one report line: the release name, a colon, and "healthy" or
// "DOWN".
func Line(service, version string, healthy bool) string {
	status := "DOWN"
	if healthy {
		status = "healthy"
	}
	return deploy.ReleaseName(service, version) + ": " + status
}
