// Package rollout plans the steps of a deploy, host by host.
package rollout

import "groundwork.local/internal_packages_2/deploy/internal/naming"

// Steps returns one "deploy <release> to <host>" line per host, in order.
// The release name comes from naming.Release.
func Steps(service, version string, hosts []string) []string {
	name := naming.Release(service, version)
	var steps []string
	for _, host := range hosts {
		steps = append(steps, "deploy "+name+" to "+host)
	}
	return steps
}
