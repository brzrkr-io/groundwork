package slo

import (
	"math"
	"testing"
)

// near reports whether got is within 0.001 of want. 1 - 0.999 is not
// exactly 0.001 in a float64, so the tests never compare floats with ==.
func near(got, want float64) bool {
	return math.Abs(got-want) < 0.001
}

func TestSLI(t *testing.T) {
	tests := []struct {
		name        string
		good, total int
		want        float64
	}{
		{"99.9% good", 999, 1000, 0.999},
		{"99% good", 4950, 5000, 0.99},
		{"all good", 250, 250, 1},
		{"all bad", 0, 10, 0},
		{"no requests", 0, 0, 1},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			if got := SLI(tc.good, tc.total); !near(got, tc.want) {
				t.Errorf("SLI(%d, %d) = %v, want %v", tc.good, tc.total, got, tc.want)
			}
		})
	}
}

func TestErrorBudget(t *testing.T) {
	allowed := []struct {
		name   string
		target float64
		total  int
		want   float64
	}{
		{"99.9% of a million", 0.999, 1_000_000, 1000},
		{"99% of 5000", 0.99, 5_000, 50},
		{"a fraction of a request", 0.995, 500, 2.5},
		{"no requests", 0.999, 0, 0},
	}
	for _, tc := range allowed {
		t.Run("AllowedFailures "+tc.name, func(t *testing.T) {
			if got := AllowedFailures(tc.target, tc.total); !near(got, tc.want) {
				t.Errorf("AllowedFailures(%v, %d) = %v, want %v", tc.target, tc.total, got, tc.want)
			}
		})
	}

	remaining := []struct {
		name        string
		target      float64
		good, total int
		want        float64
	}{
		{"quarter spent", 0.999, 999_750, 1_000_000, 0.75},
		{"blown by half", 0.999, 998_500, 1_000_000, -0.5},
		{"exactly spent", 0.99, 4_950, 5_000, 0},
		{"untouched", 0.99, 5_000, 5_000, 1},
		{"blown by a lot", 0.99, 4_000, 5_000, -19},
		{"no requests", 0.999, 0, 0, 1},
	}
	for _, tc := range remaining {
		t.Run("BudgetRemaining "+tc.name, func(t *testing.T) {
			if got := BudgetRemaining(tc.target, tc.good, tc.total); !near(got, tc.want) {
				t.Errorf("BudgetRemaining(%v, %d, %d) = %v, want %v", tc.target, tc.good, tc.total, got, tc.want)
			}
		})
	}
}

func TestBurnRate(t *testing.T) {
	tests := []struct {
		name        string
		target      float64
		good, total int
		want        float64
	}{
		{"on schedule", 0.999, 9_990, 10_000, 1},
		{"fast burn", 0.999, 9_856, 10_000, 14.4},
		{"99% target", 0.99, 900, 1_000, 10},
		{"half the allowed errors", 0.99, 995, 1_000, 0.5},
		{"no errors", 0.999, 10_000, 10_000, 0},
		{"no requests", 0.999, 0, 0, 0},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			if got := BurnRate(tc.target, tc.good, tc.total); !near(got, tc.want) {
				t.Errorf("BurnRate(%v, %d, %d) = %v, want %v", tc.target, tc.good, tc.total, got, tc.want)
			}
		})
	}
}

func TestShouldPage(t *testing.T) {
	tests := []struct {
		name              string
		target, threshold float64
		long, short       Window
		want              bool
	}{
		{"both windows burn fast", 0.999, 14.4, Window{9_800, 10_000}, Window{780, 800}, true},
		{"already fixed", 0.999, 14.4, Window{9_800, 10_000}, Window{800, 800}, false},
		{"short blip", 0.999, 14.4, Window{9_990, 10_000}, Window{700, 800}, false},
		{"no recent traffic", 0.999, 14.4, Window{9_800, 10_000}, Window{0, 0}, false},
		{"both calm", 0.999, 14.4, Window{9_995, 10_000}, Window{800, 800}, false},
		{"slow burn under a lower threshold", 0.99, 6, Window{950, 1_000}, Window{90, 100}, false},
		{"lower threshold, both over", 0.99, 6, Window{900, 1_000}, Window{90, 100}, true},
		{"just under the threshold", 0.999, 14.4, Window{9_860, 10_000}, Window{780, 800}, false},
		{"just over the threshold", 0.999, 14.4, Window{9_850, 10_000}, Window{780, 800}, true},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			got := ShouldPage(tc.target, tc.threshold, tc.long, tc.short)
			if got != tc.want {
				t.Errorf("ShouldPage(%v, %v, %+v, %+v) = %t, want %t",
					tc.target, tc.threshold, tc.long, tc.short, got, tc.want)
			}
		})
	}
}
