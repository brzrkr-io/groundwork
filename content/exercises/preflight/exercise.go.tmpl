// Version is what "preflight version" prints.
const Version = "1.4.0"

// command is one preflight subcommand: a one-line summary for the help text
// and the function that does the work.
type command struct {
	summary string
	run     func(args []string, stdin io.Reader, stdout, stderr io.Writer, lookup func(string) (string, bool)) int
}

// commands maps each command name to its command.
var commands = map[string]command{
	"check":   {summary: "check the settings and the host list before a deploy", run: runCheck},
	"init":    {summary: "write a config file with the default settings", run: runInit},
	"version": {summary: "print the version", run: runVersion},
}

// Run is the whole preflight program. args is os.Args[1:], so args[0] is the
// command name. lookup reads environment variables, like os.LookupEnv. Run
// returns the exit code: 0 for success, 1 when problems were found and 2 for
// a usage or config error.
func Run(args []string, stdin io.Reader, stdout, stderr io.Writer, lookup func(string) (string, bool)) int {
	if len(args) == 0 {
		writeUsage(stderr)
		return 2
	}
	name := args[0]
	if name == "help" || name == "-h" || name == "--help" {
		writeUsage(stdout)
		return 0
	}
	// TODO(1): Look name up in commands. Report an unknown command, or call
	// its run function with the arguments after the name.
	return 2
}

// writeUsage writes the help text to w, listing every command in commands.
func writeUsage(w io.Writer) {
	fmt.Fprintln(w, "usage: preflight <command> [flags]")
	fmt.Fprintln(w)
	fmt.Fprintln(w, "commands:")
	for _, name := range slices.Sorted(maps.Keys(commands)) {
		fmt.Fprintf(w, "  %-8s %s\n", name, commands[name].summary)
	}
}

// runVersion handles "preflight version".
// It is finished: use it as the example for the other handlers.
func runVersion(args []string, stdin io.Reader, stdout, stderr io.Writer, lookup func(string) (string, bool)) int {
	fs := flag.NewFlagSet("version", flag.ContinueOnError)
	fs.SetOutput(stderr)
	if err := fs.Parse(args); err != nil {
		if errors.Is(err, flag.ErrHelp) {
			return 0 // "preflight version -h" asked for help
		}
		return 2 // the flag package has already printed the problem
	}
	if fs.NArg() != 0 {
		fmt.Fprintln(stderr, "preflight: version takes no arguments")
		return 2
	}
	fmt.Fprintf(stdout, "preflight %s\n", Version)
	return 0
}

