package tcp

import (
	"bufio"
	"errors"
	"fmt"
	"io"
	"net"
	"testing"
	"time"
)

func TestRespond(t *testing.T) {
	tests := []struct {
		line      string
		wantReply string
		wantQuit  bool
	}{
		{"PING", "PONG", false},
		{"ECHO deploy ok", "deploy ok", false},
		{"ECHO hello", "hello", false},
		{"QUIT", "BYE", true},
		{"RESTART", "ERR unknown command", false},
		{"ping", "ERR unknown command", false},
		{"ECHO", "ERR unknown command", false},
	}
	for _, tt := range tests {
		t.Run(tt.line, func(t *testing.T) {
			reply, quit := Respond(tt.line)
			if reply != tt.wantReply || quit != tt.wantQuit {
				t.Errorf("Respond(%q) = %q, %v, want %q, %v",
					tt.line, reply, quit, tt.wantReply, tt.wantQuit)
			}
		})
	}
}

func TestHandleConn(t *testing.T) {
	// Run the real server (Serve calls your HandleConn) on a free local port.
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { ln.Close() })
	go Serve(ln)

	tests := []struct {
		name       string
		send       []string
		want       []string
		wantClosed bool
	}{
		{"ping", []string{"PING"}, []string{"PONG"}, false},
		{
			"echo and unknown",
			[]string{"ECHO hello", "RESTART", "PING"},
			[]string{"hello", "ERR unknown command", "PONG"},
			false,
		},
		{"quit closes", []string{"PING", "QUIT"}, []string{"PONG", "BYE"}, true},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			conn, err := net.Dial("tcp", ln.Addr().String())
			if err != nil {
				t.Fatal(err)
			}
			defer conn.Close()
			// Give up quickly if the server never answers.
			conn.SetDeadline(time.Now().Add(300 * time.Millisecond))
			r := bufio.NewReader(conn)

			for i, line := range tt.send {
				fmt.Fprintf(conn, "%s\n", line)
				got, err := r.ReadString('\n')
				if err != nil {
					t.Fatalf("sent %q, reading the reply failed: %v", line, err)
				}
				if got != tt.want[i]+"\n" {
					t.Fatalf("sent %q, server replied %q, want %q", line, got, tt.want[i]+"\n")
				}
			}

			if tt.wantClosed {
				if _, err := r.ReadString('\n'); !errors.Is(err, io.EOF) {
					t.Errorf("after QUIT, reading returned error %v, want io.EOF (the server should close the connection)", err)
				}
			}
		})
	}
}

// startFakeServer starts a tiny server that answers one line on each
// connection with "got <line>" and then closes it. It returns its address.
func startFakeServer(t *testing.T) string {
	t.Helper()
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { ln.Close() })
	go func() {
		for {
			conn, err := ln.Accept()
			if err != nil {
				return // the listener was closed
			}
			conn.SetDeadline(time.Now().Add(500 * time.Millisecond))
			line, err := bufio.NewReader(conn).ReadString('\n')
			if err == nil {
				fmt.Fprintf(conn, "got %s", line)
			}
			conn.Close()
		}
	}()
	return ln.Addr().String()
}

func TestSendCommand(t *testing.T) {
	addr := startFakeServer(t)

	for _, cmd := range []string{"PING", "ECHO hello world"} {
		t.Run(cmd, func(t *testing.T) {
			want := "got " + cmd
			got, err := SendCommand(addr, cmd)
			if err != nil {
				t.Fatalf("SendCommand(addr, %q) returned error %v, want nil", cmd, err)
			}
			if got != want {
				t.Errorf("SendCommand(addr, %q) = %q, want %q", cmd, got, want)
			}
		})
	}

	t.Run("nothing listening", func(t *testing.T) {
		// Grab a free port, then stop listening on it.
		ln, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		closedAddr := ln.Addr().String()
		ln.Close()

		got, err := SendCommand(closedAddr, "PING")
		if err == nil {
			t.Errorf("SendCommand(%q, %q) = %q, nil; want an error", closedAddr, "PING", got)
		}
	})
}
