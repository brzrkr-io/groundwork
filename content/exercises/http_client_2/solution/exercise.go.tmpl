// Package httpclient is the Groundwork exercise "HTTP clients: fix the deploy notifier".
package httpclient

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"strings"
)

// GetVersion fetches url and returns the version text in its body, such as "v1.4.2".
func GetVersion(client *http.Client, url string) (string, error) {
	resp, err := client.Get(url)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		return "", fmt.Errorf("version: unexpected status %d", resp.StatusCode)
	}
	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
	if err != nil {
		return "", err
	}
	return strings.TrimSpace(string(body)), nil
}

// DeployEvent is the JSON body sent to the deploy webhook.
type DeployEvent struct {
	Service string `json:"service"`
	Version string `json:"version"`
	Env     string `json:"env"`
}

// NewDeployRequest builds a POST request that sends ev to url as JSON.
func NewDeployRequest(ctx context.Context, url string, ev DeployEvent) (*http.Request, error) {
	body, err := json.Marshal(ev)
	if err != nil {
		return nil, err
	}
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
	if err != nil {
		return nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	return req, nil
}

// NotifyDeploy sends req with client. Any 2xx status counts as success.
func NotifyDeploy(client *http.Client, req *http.Request) error {
	resp, err := client.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode > 299 {
		return fmt.Errorf("notify: unexpected status %d", resp.StatusCode)
	}
	return nil
}
