// Package returns is the Groundwork exercise "Multiple return values: image refs and TTLs".
package returns

import (
	"errors"
	"fmt"
	"strconv"
	"strings"
)

// ParseImage splits an image reference "name:tag" into its name and tag.
// A missing tag means "latest".
func ParseImage(ref string) (name, tag string, err error) {
	name, tag, found := strings.Cut(ref, ":")
	if name == "" {
		return "", "", errors.New("image name is empty")
	}
	if !found {
		return name, "latest", nil
	}
	if tag == "" {
		return "", "", fmt.Errorf("empty tag in %q", ref)
	}
	return name, tag, nil
}

// ParseTTL converts a TTL such as "90s", "5m" or "2h" to seconds.
func ParseTTL(ttl string) (int, error) {
	multiplier := 0
	num := ""
	if rest, found := strings.CutSuffix(ttl, "s"); found {
		num, multiplier = rest, 1
	} else if rest, found := strings.CutSuffix(ttl, "m"); found {
		num, multiplier = rest, 60
	} else if rest, found := strings.CutSuffix(ttl, "h"); found {
		num, multiplier = rest, 3600
	} else {
		return 0, fmt.Errorf("unknown unit in %q", ttl)
	}
	n, err := strconv.Atoi(num)
	if err != nil {
		return 0, err
	}
	if n < 1 {
		return 0, fmt.Errorf("TTL must be above 0, got %q", ttl)
	}
	return n * multiplier, nil
}
