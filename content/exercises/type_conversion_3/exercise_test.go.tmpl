package conversion

import "testing"

func TestMiBToGiB(t *testing.T) {
	if got := MiBToGiB(1536); got != 1.5 {
		t.Errorf(`MiBToGiB(1536) = %v, want 1.5`, got)
	}

	if got := MiBToGiB(2048); got != 2 {
		t.Errorf(`MiBToGiB(2048) = %v, want 2`, got)
	}

	if got := MiBToGiB(512); got != 0.5 {
		t.Errorf(`MiBToGiB(512) = %v, want 0.5`, got)
	}
}

func TestGiBString(t *testing.T) {
	if got := GiBString(1536); got != "1.5 GiB" {
		t.Errorf(`GiBString(1536) = %q, want "1.5 GiB"`, got)
	}

	if got := GiBString(3072); got != "3.0 GiB" {
		t.Errorf(`GiBString(3072) = %q, want "3.0 GiB"`, got)
	}

	if got := GiBString(1000); got != "1.0 GiB" {
		t.Errorf(`GiBString(1000) = %q, want "1.0 GiB"`, got)
	}
}

func TestDiskLine(t *testing.T) {
	if got := DiskLine("/var", 1536, 2048); got != "/var: 1.5 GiB of 2.0 GiB used (75%)" {
		t.Errorf(`DiskLine("/var", 1536, 2048) = %q, want "/var: 1.5 GiB of 2.0 GiB used (75%%)"`, got)
	}

	if got := DiskLine("/data", 2048, 3072); got != "/data: 2.0 GiB of 3.0 GiB used (66%)" {
		t.Errorf(`DiskLine("/data", 2048, 3072) = %q, want "/data: 2.0 GiB of 3.0 GiB used (66%%)"`, got)
	}

	if got := DiskLine("/", 1000, 1000); got != "/: 1.0 GiB of 1.0 GiB used (100%)" {
		t.Errorf(`DiskLine("/", 1000, 1000) = %q, want "/: 1.0 GiB of 1.0 GiB used (100%%)"`, got)
	}
}
