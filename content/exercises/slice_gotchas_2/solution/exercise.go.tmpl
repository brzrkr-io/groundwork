// Package waves is the Gopherlings exercise "Slice gotchas: two bugs from one buffer".
package waves

import "strings"

// Split returns the first n hosts as the canary wave and the remaining hosts
// as rest. Appending to canary never changes rest or hosts.
func Split(hosts []string, n int) (canary, rest []string) {
	return hosts[:n:n], hosts[n:]
}

// RestartCommands returns the kubectl commands that restart the canary and
// the main version of deployment in namespace.
func RestartCommands(namespace, deployment string) (canaryCmd, mainCmd string) {
	args := make([]string, 0, 8) // room for every argument, to avoid copying
	args = append(args, "kubectl", "rollout", "restart", "-n", namespace)

	// No spare capacity, so each append copies into its own array.
	prefix := args[:len(args):len(args)]
	canary := append(prefix, "deployment/"+deployment+"-canary")
	main := append(prefix, "deployment/"+deployment)

	return strings.Join(canary, " "), strings.Join(main, " ")
}
