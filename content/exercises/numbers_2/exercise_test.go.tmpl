package numbers

import "testing"

func TestShard(t *testing.T) {
	tests := []struct {
		name   string
		userID int
		shards int
		want   int
	}{
		{name: "remainder two", userID: 17, shards: 5, want: 2},
		{name: "divides exactly", userID: 10, shards: 5, want: 0},
		{name: "fewer users than shards", userID: 3, shards: 8, want: 3},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := Shard(tt.userID, tt.shards)
			if got != tt.want {
				t.Errorf("Shard(%d, %d) = %d, want %d", tt.userID, tt.shards, got, tt.want)
			}
		})
	}
}

func TestErrorRatePercent(t *testing.T) {
	tests := []struct {
		name     string
		errors   int
		requests int
		want     int
	}{
		{name: "rounds down", errors: 5, requests: 200, want: 2},
		{name: "a quarter", errors: 50, requests: 200, want: 25},
		{name: "a third", errors: 1, requests: 3, want: 33},
		{name: "no errors", errors: 0, requests: 100, want: 0},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := ErrorRatePercent(tt.errors, tt.requests)
			if got != tt.want {
				t.Errorf("ErrorRatePercent(%d, %d) = %d, want %d", tt.errors, tt.requests, got, tt.want)
			}
		})
	}
}

func TestDiskFreePercent(t *testing.T) {
	tests := []struct {
		name  string
		total float64
		used  float64
		want  float64
	}{
		{name: "mostly full", total: 200, used: 150, want: 25},
		{name: "mostly empty", total: 64, used: 16, want: 75},
		{name: "empty disk", total: 100, used: 0, want: 100},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := DiskFreePercent(tt.total, tt.used)
			if got != tt.want {
				t.Errorf("DiskFreePercent(%v, %v) = %v, want %v", tt.total, tt.used, got, tt.want)
			}
		})
	}
}
