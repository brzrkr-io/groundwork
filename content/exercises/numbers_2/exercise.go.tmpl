// ErrorRatePercent returns the percentage of requests that failed, rounded
// down to a whole number.
func ErrorRatePercent(errors, requests int) int {
	// TODO(2): This is almost always 0. Fix it.
	return errors / requests * 100
}

// DiskFreePercent returns the free space as a percentage of the disk size.
func DiskFreePercent(totalGiB, usedGiB float64) float64 {
	// TODO(3): This calculates the wrong thing. Fix it.
