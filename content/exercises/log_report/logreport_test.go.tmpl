// Task 1 (parse.go)

func TestParseLine(t *testing.T) {
	tests := []struct {
		name string
		line string
		want Entry
	}{
		{
			name: "GET with a body",
			line: `10.0.0.7 - - [11/Oct/2026:13:55:36 +0000] "GET /api/orders HTTP/1.1" 200 512 0.043`,
			want: Entry{
				IP:       "10.0.0.7",
				Time:     time.Date(2026, time.October, 11, 13, 55, 36, 0, time.UTC),
				Method:   "GET",
				Path:     "/api/orders",
				Status:   200,
				Bytes:    512,
				Duration: 43 * time.Millisecond,
			},
		},
		{
			name: "query string removed, user and offset",
			line: `192.168.1.20 - alice [11/Oct/2026:15:55:58 +0200] "POST /login?next=/admin HTTP/2.0" 401 64 1.250`,
			want: Entry{
				IP:       "192.168.1.20",
				Time:     time.Date(2026, time.October, 11, 13, 55, 58, 0, time.UTC),
				Method:   "POST",
				Path:     "/login",
				Status:   401,
				Bytes:    64,
				Duration: 1250 * time.Millisecond,
			},
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got, err := ParseLine(tt.line)
			if err != nil {
				t.Fatalf("ParseLine(%q) returned error %v, want nil", tt.line, err)
			}
			if !got.Time.Equal(tt.want.Time) {
				t.Errorf("ParseLine(%q).Time = %v, want %v", tt.line, got.Time, tt.want.Time)
			}
			got.Time = tt.want.Time // already compared above; == on time.Time also compares time zones
			if got != tt.want {
				t.Errorf("ParseLine(%q) =\n%+v\nwant\n%+v", tt.line, got, tt.want)
			}
		})
	}

	t.Run("malformed lines", func(t *testing.T) {
		for _, line := range []string{
			"this line was cut in half when logrotate moved the f",
			`10.0.0.7 - - [11/Oct/2026:13:55:36 +0000] "GET /api/orders HTTP/1.1" 200 512`,
		} {
			_, err := ParseLine(line)
			if !errors.Is(err, ErrMalformed) {
				t.Fatalf("ParseLine(%q) error = %v, want ErrMalformed", line, err)
			}
			want := fmt.Sprintf("malformed line: %q", line)
			if err.Error() != want {
				t.Errorf("ParseLine(%q) error message = %q, want %q", line, err.Error(), want)
			}
		}
	})

	t.Run("bad time", func(t *testing.T) {
		line := `10.0.0.7 - - [32/Oct/2026:13:57:42 +0000] "GET /healthz HTTP/1.1" 200 2 0.001`
		if _, err := ParseLine(line); err == nil {
			t.Errorf("ParseLine(%q) returned nil error, want an error for day 32", line)
		}
	})
}

// Task 2 (parse.go)

func TestReadLog(t *testing.T) {
	t.Run("testdata/access.log", func(t *testing.T) {
		f, err := os.Open("testdata/access.log")
		if err != nil {
			t.Fatal(err)
		}
		defer f.Close()

		got, err := ReadLog(f)
		if err != nil {
			t.Fatalf("ReadLog(access.log) returned error %v, want nil", err)
		}
		if len(got.Entries) != 16 {
			t.Errorf("ReadLog(access.log) found %d entries, want 16", len(got.Entries))
		}
		if len(got.Entries) > 0 && got.Entries[0].Path != "/api/orders" {
			t.Errorf("first entry path = %q, want %q", got.Entries[0].Path, "/api/orders")
		}
		if len(got.Entries) == 16 && got.Entries[15].Path != "/metrics" {
			t.Errorf("last entry path = %q, want %q", got.Entries[15].Path, "/metrics")
		}
		if len(got.Problems) != 2 {
			t.Fatalf("ReadLog(access.log) found %d problems, want 2: %v", len(got.Problems), got.Problems)
		}
		want := `line 10: malformed line: "this line was cut in half when logrotate moved the f"`
		if got.Problems[0].Error() != want {
			t.Errorf("Problems[0] = %q, want %q", got.Problems[0].Error(), want)
		}
		if !errors.Is(got.Problems[0], ErrMalformed) {
			t.Errorf("errors.Is(Problems[0], ErrMalformed) = false, want true")
		}
		if !strings.HasPrefix(got.Problems[1].Error(), "line 19: ") {
			t.Errorf("Problems[1] = %q, want it to start with %q", got.Problems[1].Error(), "line 19: ")
		}
	})

	t.Run("blank lines are skipped, not problems", func(t *testing.T) {
		input := "\n" +
			`10.0.0.8 - - [11/Oct/2026:13:55:37 +0000] "GET /healthz HTTP/1.1" 200 2 0.001` + "\n" +
			"   \n" +
			"oops\n"
		got, err := ReadLog(strings.NewReader(input))
		if err != nil {
			t.Fatalf("ReadLog(%q) returned error %v, want nil", input, err)
		}
		if len(got.Entries) != 1 {
			t.Errorf("ReadLog(%q) found %d entries, want 1", input, len(got.Entries))
		}
		if len(got.Problems) != 1 || got.Problems[0].Error() != `line 4: malformed line: "oops"` {
			t.Errorf("ReadLog(%q).Problems = %v, want [line 4: malformed line: \"oops\"]", input, got.Problems)
		}
	})

	t.Run("read error", func(t *testing.T) {
		errDisk := errors.New("disk on fire")
		r := io.MultiReader(strings.NewReader("oops\n"), iotest.ErrReader(errDisk))
		if _, err := ReadLog(r); !errors.Is(err, errDisk) {
			t.Errorf("ReadLog(failing reader) error = %v, want %v", err, errDisk)
		}
	})
}

// Task 3 (stats.go)

func TestCountByClass(t *testing.T) {
	tests := []struct {
		name     string
		statuses []int
		want     map[string]int
	}{
		{"mixed", []int{200, 201, 204, 302, 404, 500, 503}, map[string]int{"2xx": 3, "3xx": 1, "4xx": 1, "5xx": 2}},
		{"all healthy", []int{200, 200}, map[string]int{"2xx": 2}},
		{"no entries", nil, map[string]int{}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			var entries []Entry
			for _, s := range tt.statuses {
				entries = append(entries, Entry{Status: s})
			}
			got := CountByClass(entries)
			if got == nil {
				t.Fatalf("CountByClass(%v) = nil, want an empty map", tt.statuses)
			}
			if !maps.Equal(got, tt.want) {
				t.Errorf("CountByClass(%v) = %v, want %v", tt.statuses, got, tt.want)
			}
		})
	}
}

// Task 4 (stats.go)

func TestTopPaths(t *testing.T) {
	paths := []string{
		"/healthz", "/api/orders", "/login", "/healthz", "/api/orders",
		"/metrics", "/healthz", "/api/orders", "/login", "/metrics",
	}
	var entries []Entry
	for _, p := range paths {
		entries = append(entries, Entry{Path: p})
	}

	tests := []struct {
		name string
		n    int
		want []PathCount
	}{
		{"top 1", 1, []PathCount{{"/api/orders", 3}}},
		{
			"ties sorted by path",
			4,
			[]PathCount{{"/api/orders", 3}, {"/healthz", 3}, {"/login", 2}, {"/metrics", 2}},
		},
		{
			"n bigger than the number of paths",
			10,
			[]PathCount{{"/api/orders", 3}, {"/healthz", 3}, {"/login", 2}, {"/metrics", 2}},
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := TopPaths(entries, tt.n)
			if !slices.Equal(got, tt.want) {
				t.Errorf("TopPaths(entries, %d) = %v, want %v", tt.n, got, tt.want)
			}
		})
	}
}

// Task 5 (stats.go)

func TestPercentile(t *testing.T) {
	ms := func(values ...int) []time.Duration {
		var ds []time.Duration
		for _, v := range values {
			ds = append(ds, time.Duration(v)*time.Millisecond)
		}
		return ds
	}

	tests := []struct {
		name      string
		durations []time.Duration
		p         int
		want      time.Duration
	}{
		{"p50 of 10", ms(90, 10, 80, 20, 70, 30, 60, 40, 50, 100), 50, 50 * time.Millisecond},
		{"p95 of 10", ms(90, 10, 80, 20, 70, 30, 60, 40, 50, 100), 95, 100 * time.Millisecond},
		{"p90 of 10", ms(90, 10, 80, 20, 70, 30, 60, 40, 50, 100), 90, 90 * time.Millisecond},
		{"p50 of 5", ms(5, 1, 4, 2, 3), 50, 3 * time.Millisecond},
		{"p100 is the maximum", ms(7, 300, 12), 100, 300 * time.Millisecond},
		{"single value", ms(42), 95, 42 * time.Millisecond},
		{"empty", nil, 50, 0},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			before := slices.Clone(tt.durations)
			got := Percentile(tt.durations, tt.p)
			if got != tt.want {
				t.Errorf("Percentile(%v, %d) = %v, want %v", before, tt.p, got, tt.want)
			}
			if !slices.Equal(tt.durations, before) {
				t.Errorf("Percentile reordered its input: %v, want %v unchanged", tt.durations, before)
			}
		})
	}
}

// Task 6 (report.go)

func TestWriteReports(t *testing.T) {
	report := Report{
		Requests: 16,
		Skipped:  2,
		ByClass:  map[string]int{"5xx": 2, "2xx": 11, "4xx": 2, "3xx": 1},
		TopPaths: []PathCount{{"/api/orders", 6}, {"/healthz", 4}, {"/api/orders/42", 2}},
		P50:      16 * time.Millisecond,
		P95:      2500 * time.Millisecond,
	}

	t.Run("text", func(t *testing.T) {
		want := `requests: 16
skipped: 2
status classes:
  2xx: 11
  3xx: 1
  4xx: 2
  5xx: 2
top paths:
  /api/orders: 6
  /healthz: 4
  /api/orders/42: 2
latency: p50 16ms, p95 2.5s
`
		var b strings.Builder
		if err := WriteText(&b, report); err != nil {
			t.Fatalf("WriteText returned error %v, want nil", err)
		}
		if b.String() != want {
			t.Errorf("WriteText wrote\n%s\nwant\n%s", b.String(), want)
		}
	})

	t.Run("json", func(t *testing.T) {
		want := `{
  "requests": 16,
  "skipped": 2,
  "by_class": {
    "2xx": 11,
    "3xx": 1,
    "4xx": 2,
    "5xx": 2
  },
  "top_paths": [
    {
      "path": "/api/orders",
      "count": 6
    },
    {
      "path": "/healthz",
      "count": 4
    },
    {
      "path": "/api/orders/42",
      "count": 2
    }
  ],
  "p50_ms": 16,
  "p95_ms": 2500
}
`
		var b strings.Builder
		if err := WriteJSON(&b, report); err != nil {
			t.Fatalf("WriteJSON returned error %v, want nil", err)
		}
		if b.String() != want {
			t.Errorf("WriteJSON wrote\n%s\nwant\n%s", b.String(), want)
		}
	})

	t.Run("write error", func(t *testing.T) {
		if err := WriteText(failingWriter{}, report); err == nil {
			t.Error("WriteText(failing writer) returned nil, want the write error")
		}
		if err := WriteJSON(failingWriter{}, report); err == nil {
			t.Error("WriteJSON(failing writer) returned nil, want the write error")
		}
	})
}

// failingWriter is an io.Writer whose every write fails, like a full disk.
type failingWriter struct{}

func (failingWriter) Write(p []byte) (int, error) {
	return 0, errors.New("disk full")
}
