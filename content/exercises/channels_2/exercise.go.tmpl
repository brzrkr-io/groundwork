// Package logship is the Groundwork exercise "Channels: deadlocks and directions".
package logship

import "sync"

// CheckHosts runs check(host) for every host at the same time and returns
// every answer, in any order.
func CheckHosts(hosts []string, check func(host string) string) []string {
	// TODO(1): Nobody receives until wg.Wait() returns, so these sends wait
	// forever. Give the channel room for every answer.
	answers := make(chan string)

	var wg sync.WaitGroup
	for _, host := range hosts {
		wg.Go(func() {
			answers <- check(host)
		})
	}
	wg.Wait()
	close(answers)

	var all []string
	for answer := range answers {
		all = append(all, answer)
	}
	return all
}

