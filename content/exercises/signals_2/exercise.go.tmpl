// Package reload is the Gopherlings exercise "Signals: SIGHUP reloads, SIGTERM stops".
package reload

import (
	"fmt"
	"io"
	"os"
)

// ExitCodeFor returns the exit code for a program stopped by sig,
// following the 128 + signal number convention.
func ExitCodeFor(sig os.Signal) int {
	// TODO(1): Return 130 for os.Interrupt and 143 for syscall.SIGTERM.
	// You need to import "syscall".
	return 1
}

// Serve handles signals until a stop signal arrives or sigs is closed.
// SIGHUP reloads the config; any other signal stops the service.
func Serve(sigs <-chan os.Signal, reload func() error, log io.Writer) int {
	for sig := range sigs {
		// TODO(2): Bug! SIGHUP should call reload and keep going,
		// not shut the agent down.
		fmt.Fprintf(log, "received %v: shutting down\n", sig)
		return ExitCodeFor(sig)
	}
	return 0
}
