package text

import "testing"

func TestIsProdHost(t *testing.T) {
	if got := IsProdHost("web-01.prod.example.com"); got != true {
		t.Errorf(`IsProdHost("web-01.prod.example.com") = %t, want true`, got)
	}

	if got := IsProdHost("db-02.prod.example.com"); got != true {
		t.Errorf(`IsProdHost("db-02.prod.example.com") = %t, want true`, got)
	}

	if got := IsProdHost("web-01.staging.example.com"); got != false {
		t.Errorf(`IsProdHost("web-01.staging.example.com") = %t, want false`, got)
	}
}

func TestMetricName(t *testing.T) {
	if got := MetricName("checkout-api"); got != "checkout_api_requests_total" {
		t.Errorf(`MetricName("checkout-api") = %q, want "checkout_api_requests_total"`, got)
	}

	if got := MetricName("payment-gateway-v2"); got != "payment_gateway_v2_requests_total" {
		t.Errorf(`MetricName("payment-gateway-v2") = %q, want "payment_gateway_v2_requests_total"`, got)
	}

	if got := MetricName("auth"); got != "auth_requests_total" {
		t.Errorf(`MetricName("auth") = %q, want "auth_requests_total"`, got)
	}
}

func TestMentionsTimeout(t *testing.T) {
	if got := MentionsTimeout("upstream timeout after 30s"); got != true {
		t.Errorf(`MentionsTimeout("upstream timeout after 30s") = %t, want true`, got)
	}

	if got := MentionsTimeout("ERROR: Timeout waiting for db"); got != true {
		t.Errorf(`MentionsTimeout("ERROR: Timeout waiting for db") = %t, want true`, got)
	}

	if got := MentionsTimeout("CONNECTION TIMEOUT"); got != true {
		t.Errorf(`MentionsTimeout("CONNECTION TIMEOUT") = %t, want true`, got)
	}

	if got := MentionsTimeout("request ok in 20ms"); got != false {
		t.Errorf(`MentionsTimeout("request ok in 20ms") = %t, want false`, got)
	}
}
