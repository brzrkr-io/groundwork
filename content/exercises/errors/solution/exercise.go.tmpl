// Package errvalues is the Groundwork exercise "Errors are values".
package errvalues

import (
	"errors"
	"fmt"
	"strconv"
	"strings"
)

// RequireName returns an error if the service name is empty.
func RequireName(name string) error {
	if name == "" {
		return errors.New("service name is empty")
	}
	return nil
}

// ParsePort converts text like "8080" into a port number between 1 and 65535.
func ParsePort(s string) (int, error) {
	n, err := strconv.Atoi(s)
	if err != nil {
		return 0, fmt.Errorf("port %q is not a number", s)
	}
	if n < 1 || n > 65535 {
		return 0, fmt.Errorf("port %d is out of range 1-65535", n)
	}
	return n, nil
}

// ParseEndpoint splits an endpoint like "db:5432" into its host and port.
func ParseEndpoint(s string) (host string, port int, err error) {
	host, portText, found := strings.Cut(s, ":")
	if !found {
		return "", 0, fmt.Errorf("endpoint %q has no port", s)
	}
	if host == "" {
		return "", 0, fmt.Errorf("endpoint %q has no host", s)
	}
	port, err = ParsePort(portText)
	if err != nil {
		return "", 0, fmt.Errorf("endpoint %q: %v", s, err)
	}
	return host, port, nil
}
