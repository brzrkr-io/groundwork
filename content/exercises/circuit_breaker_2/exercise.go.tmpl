// Package breaker is the Gopherlings exercise "Circuit breakers: protect an HTTP client".
package breaker

import (
	"errors"
	"net/http"
	"sync"
	"time"
)

// ErrOpen is returned when the breaker is rejecting calls.
var ErrOpen = errors.New("circuit breaker is open")

// State is the position of a circuit breaker.
type State int

// The three breaker states.
const (
	Closed State = iota
	Open
	HalfOpen
)

// String returns "closed", "open", "half-open", or "unknown".
func (s State) String() string {
	switch s {
	case Closed:
		return "closed"
	case Open:
		return "open"
	case HalfOpen:
		return "half-open"
	}
	return "unknown"
}

// Breaker stops calling a failing dependency for a while. It is safe for
// concurrent use.
type Breaker struct {
	// OnStateChange, if set, is called on every state change. It runs while
	// the breaker's lock is held, so it must not call methods on the breaker.
	OnStateChange func(from, to State)

	mu        sync.Mutex
	threshold int
	cooldown  time.Duration
	now       func() time.Time
	state     State
	failures  int
	openedAt  time.Time
}

// New returns a closed Breaker that opens after threshold consecutive
// failures and allows a trial call once cooldown has passed.
func New(threshold int, cooldown time.Duration, now func() time.Time) *Breaker {
	return &Breaker{threshold: threshold, cooldown: cooldown, now: now}
}

// State returns the breaker's current state.
func (b *Breaker) State() State {
	b.mu.Lock()
	defer b.mu.Unlock()
	return b.state
}

// Call runs fn unless the breaker is open, records whether fn failed, and
// returns fn's error. While the breaker is open it returns ErrOpen without
// running fn.
func (b *Breaker) Call(fn func() error) error {
	if err := b.allow(); err != nil {
		return err
	}
	err := fn()
	b.record(err)
	return err
}

// allow decides whether a call may go ahead. It returns ErrOpen if not.
func (b *Breaker) allow() error {
	b.mu.Lock()
	defer b.mu.Unlock()
	switch b.state {
	case Open:
		if b.now().Sub(b.openedAt) < b.cooldown {
			return ErrOpen
		}
		b.setState(HalfOpen)
	case HalfOpen:
		return ErrOpen
	}
	return nil
}

// record updates the breaker with the result of a call that went ahead.
// A nil err is a success.
//
// TODO(1): Fix the bug: failures hours apart, with successes in between,
// still open the breaker.
func (b *Breaker) record(err error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	if err == nil {
		b.setState(Closed)
		return
	}
	b.failures++
	if b.state == HalfOpen || b.failures >= b.threshold {
		b.setState(Open)
		b.openedAt = b.now()
	}
}

// setState moves the breaker to the state to. The caller holds b.mu.
func (b *Breaker) setState(to State) {
	// TODO(2): Call OnStateChange(from, to) when it is set and the state
	// really changes.
	b.state = to
}

// Transport is an http.RoundTripper that sends every request through a
// Breaker. Responses with status 500 or above and transport errors count as
// failures.
type Transport struct {
	Base    http.RoundTripper // sends the requests, e.g. http.DefaultTransport
	Breaker *Breaker
}

// RoundTrip sends req with Base unless the breaker is open, in which case it
// returns ErrOpen without sending anything.
func (t *Transport) RoundTrip(req *http.Request) (*http.Response, error) {
	// TODO(3): Send the request through t.Breaker.Call. Count 5xx responses
	// as failures (declare an errServerError sentinel for them), but still
	// return them.
	return t.Base.RoundTrip(req)
}
