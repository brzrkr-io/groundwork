package switches

import "testing"

func TestInstanceSize(t *testing.T) {
	if got := InstanceSize("production"); got != "large" {
		t.Errorf(`InstanceSize("production") = %q, want "large"`, got)
	}
	if got := InstanceSize("staging"); got != "medium" {
		t.Errorf(`InstanceSize("staging") = %q, want "medium"`, got)
	}
	if got := InstanceSize("dev"); got != "small" {
		t.Errorf(`InstanceSize("dev") = %q, want "small"`, got)
	}
	if got := InstanceSize("test"); got != "small" {
		t.Errorf(`InstanceSize("test") = %q, want "small"`, got)
	}
	if got := InstanceSize("prod"); got != "unknown" {
		t.Errorf(`InstanceSize("prod") = %q, want "unknown"`, got)
	}
	if got := InstanceSize(""); got != "unknown" {
		t.Errorf(`InstanceSize("") = %q, want "unknown"`, got)
	}
}

func TestMethodKind(t *testing.T) {
	if got := MethodKind("GET"); got != "read" {
		t.Errorf(`MethodKind("GET") = %q, want "read"`, got)
	}
	if got := MethodKind("get"); got != "read" {
		t.Errorf(`MethodKind("get") = %q, want "read"`, got)
	}
	if got := MethodKind("Head"); got != "read" {
		t.Errorf(`MethodKind("Head") = %q, want "read"`, got)
	}
	if got := MethodKind("OPTIONS"); got != "read" {
		t.Errorf(`MethodKind("OPTIONS") = %q, want "read"`, got)
	}
	if got := MethodKind("POST"); got != "write" {
		t.Errorf(`MethodKind("POST") = %q, want "write"`, got)
	}
	if got := MethodKind("put"); got != "write" {
		t.Errorf(`MethodKind("put") = %q, want "write"`, got)
	}
	if got := MethodKind("PATCH"); got != "write" {
		t.Errorf(`MethodKind("PATCH") = %q, want "write"`, got)
	}
	if got := MethodKind("Delete"); got != "write" {
		t.Errorf(`MethodKind("Delete") = %q, want "write"`, got)
	}
	if got := MethodKind("TRACE"); got != "unknown" {
		t.Errorf(`MethodKind("TRACE") = %q, want "unknown"`, got)
	}
	if got := MethodKind(""); got != "unknown" {
		t.Errorf(`MethodKind("") = %q, want "unknown"`, got)
	}
}

func TestLatencyRating(t *testing.T) {
	if got := LatencyRating(0); got != "fast" {
		t.Errorf(`LatencyRating(0) = %q, want "fast"`, got)
	}
	if got := LatencyRating(99); got != "fast" {
		t.Errorf(`LatencyRating(99) = %q, want "fast"`, got)
	}
	if got := LatencyRating(100); got != "ok" {
		t.Errorf(`LatencyRating(100) = %q, want "ok"`, got)
	}
	if got := LatencyRating(499); got != "ok" {
		t.Errorf(`LatencyRating(499) = %q, want "ok"`, got)
	}
	if got := LatencyRating(500); got != "slow" {
		t.Errorf(`LatencyRating(500) = %q, want "slow"`, got)
	}
	if got := LatencyRating(1999); got != "slow" {
		t.Errorf(`LatencyRating(1999) = %q, want "slow"`, got)
	}
	if got := LatencyRating(2000); got != "critical" {
		t.Errorf(`LatencyRating(2000) = %q, want "critical"`, got)
	}
	if got := LatencyRating(30000); got != "critical" {
		t.Errorf(`LatencyRating(30000) = %q, want "critical"`, got)
	}
}
