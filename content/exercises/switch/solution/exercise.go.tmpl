// Package switches is the Gopherlings exercise "Switch: size, method, latency".
package switches

import "strings"

// InstanceSize picks an instance size for an environment.
func InstanceSize(env string) string {
	switch env {
	case "production":
		return "large"
	case "staging":
		return "medium"
	case "dev", "test":
		return "small"
	default:
		return "unknown"
	}
}

// MethodKind classifies an HTTP method as "read", "write" or "unknown".
func MethodKind(method string) string {
	switch strings.ToUpper(method) {
	case "GET", "HEAD", "OPTIONS":
		return "read"
	case "POST", "PUT", "PATCH", "DELETE":
		return "write"
	default:
		return "unknown"
	}
}

// LatencyRating rates a response time in milliseconds.
func LatencyRating(ms int) string {
	switch {
	case ms < 100:
		return "fast"
	case ms < 500:
		return "ok"
	case ms < 2000:
		return "slow"
	default:
		return "critical"
	}
}
