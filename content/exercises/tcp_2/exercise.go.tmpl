// Package tcp is the Gopherlings exercise "TCP: banner grabbing with deadlines".
package tcp

import (
	"bufio"
	"fmt"
	"net"
	"slices"
	"time"
)

// HandleStats writes one "name value" line per counter in stats, sorted by
// name, and then ends the reply by closing conn.
func HandleStats(conn net.Conn, stats map[string]int) {
	// TODO(1): Fix the bug: conn is never closed, so clients reading until
	// EOF wait forever.
	var names []string
	for name := range stats {
		names = append(names, name)
	}
	slices.Sort(names)

	for _, name := range names {
		fmt.Fprintf(conn, "%s %d\n", name, stats[name])
	}
}

