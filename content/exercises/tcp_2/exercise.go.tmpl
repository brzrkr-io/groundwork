// ReadBanner connects to addr and returns the first line the server sends,
// waiting at most timeout for it.
func ReadBanner(addr string, timeout time.Duration) (string, error) {
	conn, err := net.DialTimeout("tcp", addr, timeout)
	if err != nil {
		return "", err
	}
	defer conn.Close()

	// TODO(3): Set a read deadline timeout from now.

	line, err := bufio.NewReader(conn).ReadString('\n')
	if err != nil {
		return "", err
	}
	// TODO(3): Trim the trailing "\r\n". Add the strings import.
	return line, nil
}
