// Package ports is the Gopherlings exercise "Your first test".
package ports

import (
	"fmt"
	"strconv"
)

// ParsePort converts a port such as "8080" into a number. It returns an error
// unless the text is a whole number from 1 to 65535.
//
// This code is correct. Your job in this exercise is to write a test for it.
func ParsePort(s string) (int, error) {
	return parsePort(s)
}

// parsePort points at the real implementation. Gopherlings' grader swaps in
// broken versions to check that your test catches them.
var parsePort = realParsePort

func realParsePort(s string) (int, error) {
	port, err := strconv.Atoi(s)
	if err != nil {
		return 0, fmt.Errorf("port %q is not a number", s)
	}
	if port < 1 || port > 65535 {
		return 0, fmt.Errorf("port %d is out of range 1-65535", port)
	}
	return port, nil
}
