package ifelse

import "testing"

func TestInDeployWindow(t *testing.T) {
	if !InDeployWindow("staging", 3) {
		t.Errorf(`InDeployWindow("staging", 3) = false, want true`)
	}
	if !InDeployWindow("dev", 23) {
		t.Errorf(`InDeployWindow("dev", 23) = false, want true`)
	}
	if !InDeployWindow("production", 10) {
		t.Errorf(`InDeployWindow("production", 10) = false, want true`)
	}
	if !InDeployWindow("production", 15) {
		t.Errorf(`InDeployWindow("production", 15) = false, want true`)
	}
	if InDeployWindow("production", 16) {
		t.Errorf(`InDeployWindow("production", 16) = true, want false`)
	}
	if InDeployWindow("production", 9) {
		t.Errorf(`InDeployWindow("production", 9) = true, want false`)
	}
	if InDeployWindow("production", 2) {
		t.Errorf(`InDeployWindow("production", 2) = true, want false`)
	}
}

func TestDeployGate(t *testing.T) {
	if got := DeployGate("production", 11, false, 2); got != "blocked: tests failing" {
		t.Errorf(`DeployGate("production", 11, false, 2) = %q, want "blocked: tests failing"`, got)
	}
	if got := DeployGate("production", 20, false, 0); got != "blocked: tests failing" {
		t.Errorf(`DeployGate("production", 20, false, 0) = %q, want "blocked: tests failing"`, got)
	}
	if got := DeployGate("production", 11, true, 1); got != "blocked: 1 check failing" {
		t.Errorf(`DeployGate("production", 11, true, 1) = %q, want "blocked: 1 check failing"`, got)
	}
	if got := DeployGate("staging", 3, true, 4); got != "blocked: 4 checks failing" {
		t.Errorf(`DeployGate("staging", 3, true, 4) = %q, want "blocked: 4 checks failing"`, got)
	}
	if got := DeployGate("production", 20, true, 2); got != "blocked: 2 checks failing" {
		t.Errorf(`DeployGate("production", 20, true, 2) = %q, want "blocked: 2 checks failing"`, got)
	}
	if got := DeployGate("production", 20, true, 0); got != "blocked: outside deploy window" {
		t.Errorf(`DeployGate("production", 20, true, 0) = %q, want "blocked: outside deploy window"`, got)
	}
	if got := DeployGate("production", 9, true, 0); got != "blocked: outside deploy window" {
		t.Errorf(`DeployGate("production", 9, true, 0) = %q, want "blocked: outside deploy window"`, got)
	}
	if got := DeployGate("production", 11, true, 0); got != "go" {
		t.Errorf(`DeployGate("production", 11, true, 0) = %q, want "go"`, got)
	}
	if got := DeployGate("staging", 20, true, 0); got != "go" {
		t.Errorf(`DeployGate("staging", 20, true, 0) = %q, want "go"`, got)
	}
}
