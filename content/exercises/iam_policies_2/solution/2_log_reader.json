{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLogBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::acme-app-logs"
    },
    {
      "Sid": "ReadProdLogs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::acme-app-logs/prod/*"
    }
  ]
}
