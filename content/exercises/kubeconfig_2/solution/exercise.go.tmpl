// Package kubeconfig is the Gopherlings exercise "kubeconfig: building a rest.Config".
package kubeconfig

import (
	"time"

	"k8s.io/client-go/rest"
	"k8s.io/client-go/tools/clientcmd"
	clientcmdapi "k8s.io/client-go/tools/clientcmd/api"
)

// RESTConfig builds the connection settings for the context contextName in
// cfg. It does not contact the cluster.
func RESTConfig(cfg *clientcmdapi.Config, contextName string) (*rest.Config, error) {
	clientConfig := clientcmd.NewNonInteractiveClientConfig(*cfg, contextName, &clientcmd.ConfigOverrides{}, nil)
	return clientConfig.ClientConfig()
}

// Tune applies the deploy bot's client settings to c: its rate limits, its
// request timeout and the user agent that identifies it in audit logs.
func Tune(c *rest.Config, userAgent string) {
	c.QPS = 20
	c.Burst = 40
	c.Timeout = 30 * time.Second
	c.UserAgent = userAgent
}

// Namespace returns the default namespace of the context contextName in cfg,
// or "default" when the context doesn't set one.
func Namespace(cfg *clientcmdapi.Config, contextName string) (string, error) {
	clientConfig := clientcmd.NewNonInteractiveClientConfig(*cfg, contextName, &clientcmd.ConfigOverrides{}, nil)
	ns, _, err := clientConfig.Namespace()
	return ns, err
}
