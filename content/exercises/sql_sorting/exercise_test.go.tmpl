func TestDeployTimeline(t *testing.T) {
	got := runQuery(t, "1_deploy_timeline.sql")
	want := [][]string{
		{"1", "api", "2026-03-02 09:12:00"},
		{"2", "api", "2026-03-02 10:05:00"},
		{"3", "checkout", "2026-03-02 11:30:00"},
		{"4", "checkout", "2026-03-02 13:02:00"},
		{"5", "billing", "2026-03-03 08:45:00"},
		{"6", "search", "2026-03-03 09:20:00"},
		{"7", "search", "2026-03-03 10:01:00"},
		{"8", "checkout", "2026-03-03 14:40:00"},
		{"9", "api", "2026-03-04 09:00:00"},
		{"10", "billing", "2026-03-04 11:15:00"},
		{"11", "billing", "2026-03-04 16:50:00"},
		{"12", "search", "2026-03-05 07:30:00"},
		{"13", "api", "2026-03-05 22:10:00"},
		{"14", "checkout", "2026-03-06 10:00:00"},
	}
	checkRows(t, "1_deploy_timeline.sql", got, want)
}

