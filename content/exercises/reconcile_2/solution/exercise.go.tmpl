// Package reconcile is the Gopherlings exercise "Reconcile loops: idempotent updates".
package reconcile

import (
	"context"
	"fmt"
	"strconv"

	appsv1 "k8s.io/api/apps/v1"
	corev1 "k8s.io/api/core/v1"
	apierrors "k8s.io/apimachinery/pkg/api/errors"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/client-go/kubernetes"
	"k8s.io/utils/ptr"
)

// Desired is the state a ConfigMap asks for.
type Desired struct {
	Replicas int32
	Image    string
}

// desiredFrom reads the "replicas" and "image" keys of cm.Data.
func desiredFrom(cm *corev1.ConfigMap) (Desired, error) {
	n, err := strconv.ParseInt(cm.Data["replicas"], 10, 32)
	if err != nil || n < 0 {
		return Desired{}, fmt.Errorf("configmap %s: invalid replicas %q", cm.Name, cm.Data["replicas"])
	}
	image := cm.Data["image"]
	if image == "" {
		return Desired{}, fmt.Errorf("configmap %s: missing image", cm.Name)
	}
	return Desired{Replicas: int32(n), Image: image}, nil
}

// newDeployment builds the Deployment that Reconcile creates when none
// exists yet.
func newDeployment(namespace, name string, d Desired) *appsv1.Deployment {
	labels := map[string]string{"app": name}
	return &appsv1.Deployment{
		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace, Labels: labels},
		Spec: appsv1.DeploymentSpec{
			Replicas: new(d.Replicas),
			Selector: &metav1.LabelSelector{MatchLabels: labels},
			Template: corev1.PodTemplateSpec{
				ObjectMeta: metav1.ObjectMeta{Labels: labels},
				Spec: corev1.PodSpec{
					Containers: []corev1.Container{{Name: name, Image: d.Image}},
				},
			},
		},
	}
}

// Reconcile makes the Deployment namespace/name match the ConfigMap with the
// same name. It creates the Deployment if it is missing, updates it if it
// has drifted, and makes no changes when it is already in sync.
func Reconcile(ctx context.Context, cs kubernetes.Interface, namespace, name string) error {
	// Observe: the desired state.
	cm, err := cs.CoreV1().ConfigMaps(namespace).Get(ctx, name, metav1.GetOptions{})
	if err != nil {
		return fmt.Errorf("get configmap %s/%s: %w", namespace, name, err)
	}
	desired, err := desiredFrom(cm)
	if err != nil {
		return err
	}

	// Observe: the actual state.
	current, err := cs.AppsV1().Deployments(namespace).Get(ctx, name, metav1.GetOptions{})
	if apierrors.IsNotFound(err) {
		_, err = cs.AppsV1().Deployments(namespace).Create(ctx, newDeployment(namespace, name, desired), metav1.CreateOptions{})
		if err != nil {
			return fmt.Errorf("create deployment %s/%s: %w", namespace, name, err)
		}
		return nil
	}
	if err != nil {
		return fmt.Errorf("get deployment %s/%s: %w", namespace, name, err)
	}

	// Diff and act.
	if ptr.Deref(current.Spec.Replicas, 1) == desired.Replicas &&
		current.Spec.Template.Spec.Containers[0].Image == desired.Image {
		return nil
	}
	// Change only the fields this reconciler owns; everything else on the
	// live object (labels, annotations, env vars, ...) stays as it is.
	updated := current.DeepCopy()
	updated.Spec.Replicas = new(desired.Replicas)
	updated.Spec.Template.Spec.Containers[0].Image = desired.Image
	_, err = cs.AppsV1().Deployments(namespace).Update(ctx, updated, metav1.UpdateOptions{})
	if err != nil {
		return fmt.Errorf("update deployment %s/%s: %w", namespace, name, err)
	}
	return nil
}
