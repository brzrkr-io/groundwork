package reconcile

import (
	"context"
	"slices"
	"strconv"
	"testing"

	appsv1 "k8s.io/api/apps/v1"
	corev1 "k8s.io/api/core/v1"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/client-go/kubernetes/fake"
	"k8s.io/utils/ptr"
)

const (
	img230 = "registry.example.com/payments/worker:2.3.0"
	img240 = "registry.example.com/payments/worker:2.4.0"
)

// configMap returns the ConfigMap that holds the desired state for name.
func configMap(namespace, name string, replicas int32, image string) *corev1.ConfigMap {
	return &corev1.ConfigMap{
		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace},
		Data: map[string]string{
			"replicas": strconv.Itoa(int(replicas)),
			"image":    image,
		},
	}
}

// liveDeployment returns a Deployment as it might exist in the cluster,
// including a label, an annotation and an env var that other people added.
func liveDeployment(namespace, name string, replicas *int32, image string) *appsv1.Deployment {
	return &appsv1.Deployment{
		ObjectMeta: metav1.ObjectMeta{
			Name:        name,
			Namespace:   namespace,
			Labels:      map[string]string{"app": name, "team": "payments"},
			Annotations: map[string]string{"gopherlings.dev/owner": "payments-team"},
		},
		Spec: appsv1.DeploymentSpec{
			Replicas: replicas,
			Selector: &metav1.LabelSelector{MatchLabels: map[string]string{"app": name}},
			Template: corev1.PodTemplateSpec{
				ObjectMeta: metav1.ObjectMeta{Labels: map[string]string{"app": name}},
				Spec: corev1.PodSpec{
					Containers: []corev1.Container{{
						Name:  name,
						Image: image,
						Env:   []corev1.EnvVar{{Name: "LOG_LEVEL", Value: "debug"}},
					}},
				},
			},
		},
	}
}

// writes lists the actions recorded by cs that change something, such as
// "create deployments" or "update deployments". Reads ("get") are skipped.
func writes(cs *fake.Clientset) []string {
	var out []string
	for _, a := range cs.Actions() {
		switch a.GetVerb() {
		case "create", "update", "patch", "delete":
			out = append(out, a.GetVerb()+" "+a.GetResource().Resource)
		}
	}
	return out
}

// getDeployment reads namespace/name back from the fake clientset.
func getDeployment(t *testing.T, cs *fake.Clientset, namespace, name string) *appsv1.Deployment {
	t.Helper()
	d, err := cs.AppsV1().Deployments(namespace).Get(context.Background(), name, metav1.GetOptions{})
	if err != nil {
		t.Fatalf("Get deployment %s/%s after Reconcile: %v", namespace, name, err)
	}
	return d
}

func TestReconcileCreatesMissingDeployment(t *testing.T) {
	tests := []struct {
		namespace, name string
		replicas        int32
		image           string
	}{
		{"payments", "worker", 3, img240},
		{"shop", "api", 0, "registry.example.com/shop/api:1.4.2"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			ctx := context.Background()
			cs := fake.NewClientset(configMap(tt.namespace, tt.name, tt.replicas, tt.image))

			if err := Reconcile(ctx, cs, tt.namespace, tt.name); err != nil {
				t.Fatalf("Reconcile(ctx, cs, %q, %q) error = %v, want nil", tt.namespace, tt.name, err)
			}
			if got, want := writes(cs), []string{"create deployments"}; !slices.Equal(got, want) {
				t.Errorf("Reconcile(ctx, cs, %q, %q) writes = %q, want %q", tt.namespace, tt.name, got, want)
			}
			d := getDeployment(t, cs, tt.namespace, tt.name)
			if got := ptr.Deref(d.Spec.Replicas, 1); got != tt.replicas {
				t.Errorf("created replicas = %d, want %d", got, tt.replicas)
			}
			if got := d.Spec.Template.Spec.Containers[0].Image; got != tt.image {
				t.Errorf("created image = %q, want %q", got, tt.image)
			}
		})
	}
}

func TestReconcileIsIdempotent(t *testing.T) {
	tests := []struct {
		name         string
		cmReplicas   int32
		cmImage      string
		liveReplicas *int32
		liveImage    string
		wantFirst    []string // writes made by the first Reconcile
	}{
		{"in sync", 3, img230, new(int32(3)), img230, nil},
		{"in sync with replicas unset", 1, img240, nil, img240, nil},
		{"replicas drifted", 5, img230, new(int32(2)), img230, []string{"update deployments"}},
		{"image drifted", 2, img240, new(int32(2)), img230, []string{"update deployments"}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			ctx := context.Background()
			cs := fake.NewClientset(
				configMap("payments", "worker", tt.cmReplicas, tt.cmImage),
				liveDeployment("payments", "worker", tt.liveReplicas, tt.liveImage),
			)

			if err := Reconcile(ctx, cs, "payments", "worker"); err != nil {
				t.Fatalf("first Reconcile error = %v, want nil", err)
			}
			if got := writes(cs); !slices.Equal(got, tt.wantFirst) {
				t.Errorf("first Reconcile writes = %q, want %q", got, tt.wantFirst)
			}
			d := getDeployment(t, cs, "payments", "worker")
			if got := ptr.Deref(d.Spec.Replicas, 1); got != tt.cmReplicas {
				t.Errorf("replicas after Reconcile = %d, want %d", got, tt.cmReplicas)
			}
			if got := d.Spec.Template.Spec.Containers[0].Image; got != tt.cmImage {
				t.Errorf("image after Reconcile = %q, want %q", got, tt.cmImage)
			}

			// Forget everything recorded so far, then run again. The world is
			// in sync now, so a correct reconciler only reads.
			cs.ClearActions()
			if err := Reconcile(ctx, cs, "payments", "worker"); err != nil {
				t.Fatalf("second Reconcile error = %v, want nil", err)
			}
			if got := writes(cs); len(got) != 0 {
				t.Errorf("second Reconcile writes = %q, want none (Reconcile must be idempotent)", got)
			}
		})
	}
}

func TestReconcileKeepsOtherFields(t *testing.T) {
	tests := []struct {
		name       string
		cmReplicas int32
		cmImage    string
	}{
		{"replicas drifted", 4, img230},
		{"image drifted", 2, img240},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			ctx := context.Background()
			cs := fake.NewClientset(
				configMap("payments", "worker", tt.cmReplicas, tt.cmImage),
				liveDeployment("payments", "worker", new(int32(2)), img230),
			)

			if err := Reconcile(ctx, cs, "payments", "worker"); err != nil {
				t.Fatalf("Reconcile error = %v, want nil", err)
			}
			d := getDeployment(t, cs, "payments", "worker")
			if got := ptr.Deref(d.Spec.Replicas, 1); got != tt.cmReplicas {
				t.Errorf("replicas after Reconcile = %d, want %d", got, tt.cmReplicas)
			}
			c := d.Spec.Template.Spec.Containers[0]
			if c.Image != tt.cmImage {
				t.Errorf("image after Reconcile = %q, want %q", c.Image, tt.cmImage)
			}
			if got := d.Labels["team"]; got != "payments" {
				t.Errorf("label team after Reconcile = %q, want %q (keep labels others added)", got, "payments")
			}
			if got := d.Annotations["gopherlings.dev/owner"]; got != "payments-team" {
				t.Errorf("annotation gopherlings.dev/owner after Reconcile = %q, want %q (keep annotations others added)", got, "payments-team")
			}
			if len(c.Env) != 1 || c.Env[0].Value != "debug" {
				t.Errorf("container env after Reconcile = %v, want [LOG_LEVEL=debug] (keep env vars others added)", c.Env)
			}
		})
	}
}
