package gitundo

import (
	"bytes"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
)

// Each test builds a fresh sandbox with setup.sh, runs your scripts in
// task order up to the one it checks, then inspects the repo with git.
var scripts = []string{
	"1_revert_bad_deploy.sh",
	"2_drop_experiment.sh",
	"3_restore_runbook.sh",
}

func TestRevertBadDeploy(t *testing.T) {
	repo, _ := runTasks(t, 1)
	want := "Revert \"Point web at the new database cluster\"\nUpdate deploy steps in the runbook\nPoint web at the new database cluster\nAdd deploy script\nAdd database config and runbook"
	if got := git(t, repo, "log", "--format=%s", "main"); got != want {
		t.Errorf("git log --format=%%s main:\n%s\nwant:\n%s", got, want)
	}
	if got := git(t, repo, "show", "main:config/db.yaml"); !strings.Contains(got, "host: db-old.internal") {
		t.Errorf("committed config/db.yaml:\n%s\nwant host: db-old.internal", got)
	}
}

func TestDropExperiment(t *testing.T) {
	repo, _ := runTasks(t, 2)
	if got := git(t, repo, "log", "-1", "--format=%s", "experiment"); got != "Update deploy steps in the runbook" {
		t.Errorf("experiment points at %q, want \"Update deploy steps in the runbook\"", got)
	}
	if got := git(t, repo, "branch", "--show-current"); got != "main" {
		t.Errorf("current branch = %q, want \"main\"", got)
	}
	if got := git(t, repo, "log", "-1", "--format=%s", "main"); got != "Revert \"Point web at the new database cluster\"" {
		t.Errorf("main's newest commit = %q, want still the revert from task 1", got)
	}
	if got := git(t, repo, "status", "--porcelain"); got != "" {
		t.Errorf("git status --porcelain:\n%s\nwant nothing left over", got)
	}
}

func TestRestoreRunbook(t *testing.T) {
	repo, _ := runTasks(t, 3)
	if got := git(t, repo, "log", "-1", "--format=%s", "main"); got != "Restore the rollback section of the runbook" {
		t.Errorf("main's newest commit = %q, want \"Restore the rollback section of the runbook\"", got)
	}
	if got := git(t, repo, "show", "--name-only", "--format=", "main"); got != "docs/runbook.md" {
		t.Errorf("files changed by main's newest commit:\n%s\nwant only docs/runbook.md", got)
	}
	if got, want := git(t, repo, "show", "main:docs/runbook.md"), git(t, repo, "show", "v1.0:docs/runbook.md"); got != want {
		t.Errorf("committed docs/runbook.md:\n%s\nwant v1.0's version:\n%s", got, want)
	}
	if got := git(t, repo, "status", "--porcelain"); got != "" {
		t.Errorf("git status --porcelain:\n%s\nwant nothing left to commit", got)
	}
}

// runTasks builds a fresh sandbox with setup.sh, then runs task scripts 1 to
// n inside it, in order, as you would by hand. It returns the repo's path
// and what script n printed.
func runTasks(t *testing.T, n int) (repo, printed string) {
	t.Helper()
	home := t.TempDir()
	repo = filepath.Join(home, "sandbox")
	if _, stderr, err := run(home, ".", "bash", "setup.sh", repo); err != nil {
		t.Fatalf("setup.sh failed (%v):\n%s", err, stderr)
	}
	for _, script := range scripts[:n] {
		path, err := filepath.Abs(script)
		if err != nil {
			t.Fatal(err)
		}
		stdout, stderr, err := run(home, repo, "bash", path)
		if err != nil {
			t.Fatalf("%s failed (%v). It printed:\n%s%s", script, err, stdout, stderr)
		}
		printed = stdout
	}
	return repo, printed
}

// git runs a git command in repo and returns what it printed, without the
// final newline.
func git(t *testing.T, repo string, args ...string) string {
	t.Helper()
	stdout, stderr, err := run(filepath.Dir(repo), repo, "git", args...)
	if err != nil {
		t.Fatalf("git %s failed (%v):\n%s", strings.Join(args, " "), err, stderr)
	}
	return strings.TrimSuffix(stdout, "\n")
}

// run runs a command in dir, hermetically: no personal Git config, a fixed
// author and date, and no editor or pager waiting for input.
func run(home, dir, name string, args ...string) (stdout, stderr string, err error) {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.Env = append(os.Environ(),
		"HOME="+home, "XDG_CONFIG_HOME="+home, "LC_ALL=C", "TZ=UTC",
		"GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1",
		"GIT_AUTHOR_NAME=Sam Rivera", "GIT_AUTHOR_EMAIL=sam@example.com",
		"GIT_COMMITTER_NAME=Sam Rivera", "GIT_COMMITTER_EMAIL=sam@example.com",
		"GIT_AUTHOR_DATE=2026-10-01 12:00:00 +0000", "GIT_COMMITTER_DATE=2026-10-01 12:00:00 +0000",
		"GIT_EDITOR=true", "GIT_PAGER=cat", "PAGER=cat",
	)
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	err = cmd.Run()
	return out.String(), errOut.String(), err
}
