package cli

import (
	"flag"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

// update rewrites the golden files instead of comparing with them:
//
//	go test ./internal/cli -run TestGolden -update
var update = flag.Bool("update", false, "rewrite the golden files in testdata/")

// goldenCases are the command lines TestGolden locks down. Each one's
// expected stdout is in testdata/<name>.golden.
var goldenCases = []struct {
	name string
	args []string
}{
	{"mixed-table", []string{"../../testdata/mixed.yaml"}},
	{"mixed-json", []string{"-format", "json", "../../testdata/mixed.yaml"}},
	{"violations", []string{"-enable", "image-digest", "../../testdata/violations"}},
}

func TestGolden(t *testing.T) {
	for _, tc := range goldenCases {
		t.Run(tc.name, func(t *testing.T) {
			var stdout, stderr strings.Builder
			Run(tc.args, strings.NewReader(""), &stdout, &stderr)
			golden := filepath.Join("testdata", tc.name+".golden")

			if *update {
				if err := os.MkdirAll("testdata", 0o755); err != nil {
					t.Fatal(err)
				}
				if err := os.WriteFile(golden, []byte(stdout.String()), 0o644); err != nil {
					t.Fatal(err)
				}
			}
			want, err := os.ReadFile(golden)
			if err != nil {
				t.Fatalf("reading the golden file: %v (run with -update to create it)", err)
			}
			if stdout.String() != string(want) {
				t.Errorf("kubepolicy %s printed\n%s\nwant (from %s)\n%s",
					strings.Join(tc.args, " "), stdout.String(), golden, want)
			}
		})
	}
}
