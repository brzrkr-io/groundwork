// Package deployqueue is the Groundwork exercise "Linked lists: a deploy queue with container/list".
package deployqueue

import "container/list"

// Deploy is one deploy waiting to run.
type Deploy struct {
	Service string
	Version string
}

// Queue runs deploys one at a time, first come, first served, except that a
// hotfix can jump to the front.
type Queue struct {
	deploys *list.List // front: runs next; every element holds a *Deploy
}

// New returns an empty Queue.
func New() *Queue {
	return &Queue{deploys: list.New()}
}

