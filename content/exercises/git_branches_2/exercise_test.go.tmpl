package gitbranches

import (
	"bytes"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
)

// Each test builds a fresh sandbox with setup.sh, runs your scripts in
// task order up to the one it checks, then inspects the repo with git.
var scripts = []string{
	"1_merge_metrics.sh",
	"2_start_conflicting_merge.sh",
	"3_resolve_conflict.sh",
}

func TestMergeMetrics(t *testing.T) {
	repo, _ := runTasks(t, 1)
	if got := git(t, repo, "log", "-1", "--format=%s", "main"); got != "Merge branch 'add-metrics'" {
		t.Errorf("main's newest commit = %q, want \"Merge branch 'add-metrics'\"", got)
	}
	if got := parents(t, repo, "main"); got != 2 {
		t.Errorf("main's newest commit has %d parents, want 2 (a merge commit)", got)
	}
	if got := git(t, repo, "ls-tree", "--name-only", "main", "config/"); got != "config/app.yaml\nconfig/metrics.yaml" {
		t.Errorf("files in config/ on main:\n%s\nwant:\nconfig/app.yaml\nconfig/metrics.yaml", got)
	}
}

func TestStartConflictingMerge(t *testing.T) {
	repo, _ := runTasks(t, 2)
	if _, err := os.Stat(filepath.Join(repo, ".git", "MERGE_HEAD")); err != nil {
		t.Fatal("no merge is in progress, want the raise-limits merge stopped on its conflict")
	}
	if got := git(t, repo, "diff", "--name-only", "--diff-filter=U"); got != "config/app.yaml" {
		t.Errorf("conflicted files = %q, want \"config/app.yaml\"", got)
	}
	if got := git(t, repo, "log", "-1", "--format=%s"); got != "Merge branch 'add-metrics'" {
		t.Errorf("newest commit = %q, want still \"Merge branch 'add-metrics'\" while the merge is in progress", got)
	}
}

func TestResolveConflict(t *testing.T) {
	repo, _ := runTasks(t, 3)
	if got := git(t, repo, "log", "-1", "--format=%s", "main"); got != "Merge branch 'raise-limits'" {
		t.Errorf("main's newest commit = %q, want \"Merge branch 'raise-limits'\"", got)
	}
	if got := parents(t, repo, "main"); got != 2 {
		t.Errorf("main's newest commit has %d parents, want 2 (a merge commit)", got)
	}
	want := "name: web\nreplicas: 2\ntimeout: 30s\nmax_connections: 200\nlog_level: info"
	if got := git(t, repo, "show", "main:config/app.yaml"); got != want {
		t.Errorf("committed config/app.yaml:\n%s\nwant:\n%s", got, want)
	}
	if got := git(t, repo, "status", "--porcelain"); got != "" {
		t.Errorf("git status --porcelain:\n%s\nwant nothing left to commit", got)
	}
}

// parents returns how many parents the commit at rev has.
func parents(t *testing.T, repo, rev string) int {
	t.Helper()
	return len(strings.Fields(git(t, repo, "log", "-1", "--format=%P", rev)))
}

// runTasks builds a fresh sandbox with setup.sh, then runs task scripts 1 to
// n inside it, in order, as you would by hand. It returns the repo's path
// and what script n printed.
func runTasks(t *testing.T, n int) (repo, printed string) {
	t.Helper()
	home := t.TempDir()
	repo = filepath.Join(home, "sandbox")
	if _, stderr, err := run(home, ".", "bash", "setup.sh", repo); err != nil {
		t.Fatalf("setup.sh failed (%v):\n%s", err, stderr)
	}
	for _, script := range scripts[:n] {
		path, err := filepath.Abs(script)
		if err != nil {
			t.Fatal(err)
		}
		stdout, stderr, err := run(home, repo, "bash", path)
		if err != nil {
			t.Fatalf("%s failed (%v). It printed:\n%s%s", script, err, stdout, stderr)
		}
		printed = stdout
	}
	return repo, printed
}

// git runs a git command in repo and returns what it printed, without the
// final newline.
func git(t *testing.T, repo string, args ...string) string {
	t.Helper()
	stdout, stderr, err := run(filepath.Dir(repo), repo, "git", args...)
	if err != nil {
		t.Fatalf("git %s failed (%v):\n%s", strings.Join(args, " "), err, stderr)
	}
	return strings.TrimSuffix(stdout, "\n")
}

// run runs a command in dir, hermetically: no personal Git config, a fixed
// author and date, and no editor or pager waiting for input.
func run(home, dir, name string, args ...string) (stdout, stderr string, err error) {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.Env = append(os.Environ(),
		"HOME="+home, "XDG_CONFIG_HOME="+home, "LC_ALL=C", "TZ=UTC",
		"GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1",
		"GIT_AUTHOR_NAME=Sam Rivera", "GIT_AUTHOR_EMAIL=sam@example.com",
		"GIT_COMMITTER_NAME=Sam Rivera", "GIT_COMMITTER_EMAIL=sam@example.com",
		"GIT_AUTHOR_DATE=2026-10-01 12:00:00 +0000", "GIT_COMMITTER_DATE=2026-10-01 12:00:00 +0000",
		"GIT_EDITOR=true", "GIT_PAGER=cat", "PAGER=cat",
	)
	var out, errOut bytes.Buffer
	cmd.Stdout, cmd.Stderr = &out, &errOut
	err = cmd.Run()
	return out.String(), errOut.String(), err
}
