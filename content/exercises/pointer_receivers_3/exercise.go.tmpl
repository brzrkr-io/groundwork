// Package rollout is the Groundwork exercise "Pointer receivers: a rolling deploy".
package rollout

// Rollout tracks a rolling update of a service to a new version.
type Rollout struct {
	Service  string
	Version  string
	Replicas int  // how many replicas the service runs
	Updated  int  // how many replicas already run Version
	Paused   bool // an operator paused the rollout
}

// Pause stops the rollout where it is.
func (r *Rollout) Pause() {
	r.Paused = true
}

// Status describes the rollout, for example "rolling out 2/5".
