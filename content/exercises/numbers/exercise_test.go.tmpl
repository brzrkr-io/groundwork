package numbers

import "testing"

func TestTotalMemoryMiB(t *testing.T) {
	if got := TotalMemoryMiB(3, 256); got != 768 {
		t.Errorf(`TotalMemoryMiB(3, 256) = %d, want 768`, got)
	}

	if got := TotalMemoryMiB(5, 512); got != 2560 {
		t.Errorf(`TotalMemoryMiB(5, 512) = %d, want 2560`, got)
	}

	if got := TotalMemoryMiB(0, 512); got != 0 {
		t.Errorf(`TotalMemoryMiB(0, 512) = %d, want 0`, got)
	}
}

func TestReplicasNeeded(t *testing.T) {
	if got := ReplicasNeeded(1000, 300); got != 4 {
		t.Errorf(`ReplicasNeeded(1000, 300) = %d, want 4`, got)
	}

	if got := ReplicasNeeded(900, 300); got != 3 {
		t.Errorf(`ReplicasNeeded(900, 300) = %d, want 3`, got)
	}

	if got := ReplicasNeeded(1, 300); got != 1 {
		t.Errorf(`ReplicasNeeded(1, 300) = %d, want 1`, got)
	}

	if got := ReplicasNeeded(0, 300); got != 0 {
		t.Errorf(`ReplicasNeeded(0, 300) = %d, want 0`, got)
	}
}

func TestCPUPercent(t *testing.T) {
	if got := CPUPercent(250, 1000); got != 25 {
		t.Errorf(`CPUPercent(250, 1000) = %v, want 25`, got)
	}

	if got := CPUPercent(125, 1000); got != 12.5 {
		t.Errorf(`CPUPercent(125, 1000) = %v, want 12.5`, got)
	}

	if got := CPUPercent(1500, 1000); got != 150 {
		t.Errorf(`CPUPercent(1500, 1000) = %v, want 150`, got)
	}
}
