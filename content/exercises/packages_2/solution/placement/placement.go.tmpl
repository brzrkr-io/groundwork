// Package placement decides which cloud a region name belongs to.
package placement

import (
	awsregion "gopherlings.local/packages_2/aws/region"
	gcpregion "gopherlings.local/packages_2/gcp/region"
)

// Provider returns "aws", "gcp" or "unknown" for a region name.
func Provider(name string) string {
	switch {
	case awsregion.Valid(name):
		return "aws"
	case gcpregion.Valid(name):
		return "gcp"
	default:
		return "unknown"
	}
}

// Describe returns a one-line description of a region for the on-call
// dashboard, such as "eu-west-2 is AWS, partition aws".
func Describe(name string) string {
	switch Provider(name) {
	case "aws":
		return name + " is AWS, partition " + awsregion.Partition(name)
	case "gcp":
		return name + " is GCP"
	default:
		return name + " is not a known region"
	}
}
