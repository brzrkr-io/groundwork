package routing

// This file reads exercise.go as a tree of Go syntax, the same way gofmt and
// your editor do, so the tests can check how the code is shaped as well as
// what it does. You don't need to change it, but you're welcome to read it.

import (
	"go/ast"
	"go/parser"
	"go/token"
	"testing"
)

// checkTable fails if the function called name still uses a switch, or if
// there is no package-level map variable called table.
func checkTable(t *testing.T, name, table string) {
	t.Helper()
	fset := token.NewFileSet()
	file, err := parser.ParseFile(fset, "exercise.go", nil, parser.SkipObjectResolution)
	if err != nil {
		t.Fatalf("can't read exercise.go: %v", err)
	}

	foundFunc, foundTable := false, false
	for _, decl := range file.Decls {
		switch decl := decl.(type) {
		case *ast.FuncDecl:
			if decl.Name.Name != name {
				continue
			}
			foundFunc = true
			ast.Inspect(decl.Body, func(n ast.Node) bool {
				if sw, ok := n.(*ast.SwitchStmt); ok {
					t.Errorf("exercise.go:%d: %s still uses a switch; look the value up in the %s map instead",
						fset.Position(sw.Pos()).Line, name, table)
				}
				return true
			})
		case *ast.GenDecl:
			if decl.Tok != token.VAR {
				continue
			}
			for _, spec := range decl.Specs {
				spec := spec.(*ast.ValueSpec)
				for i, id := range spec.Names {
					if id.Name == table && i < len(spec.Values) && isMap(spec.Values[i]) {
						foundTable = true
					}
				}
			}
		}
	}
	if !foundFunc {
		t.Errorf("exercise.go has no function named %s; keep its name, the alert router calls it", name)
	}
	if !foundTable {
		t.Errorf("exercise.go has no package-level map named %s; declare it with var, outside any function, as var %s = map[...]...{...}",
			table, table)
	}
}

// isMap reports whether e is a map literal, like map[string]int{"a": 1}.
func isMap(e ast.Expr) bool {
	lit, ok := e.(*ast.CompositeLit)
	if !ok {
		return false
	}
	_, ok = lit.Type.(*ast.MapType)
	return ok
}
