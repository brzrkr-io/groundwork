func TestRunningDeploys(t *testing.T) {
	got := runQuery(t, "1_running_deploys.sql")
	checkColumns(t, "1_running_deploys.sql", got, "id", "service", "started_at")
	want := [][]string{
		{"8", "billing", "2026-03-06 16:58:00"},
		{"9", "api", "2026-03-06 17:02:00"},
	}
	checkRows(t, "1_running_deploys.sql", got, want)
}

func TestNotProduction(t *testing.T) {
	got := runQuery(t, "2_not_production.sql")
	checkColumns(t, "2_not_production.sql", got, "id", "service", "environment")
	want := [][]string{
		{"1", "api", "staging"},
		{"3", "checkout", "NULL"},
		{"6", "search", "staging"},
		{"7", "search", "NULL"},
		{"8", "billing", "staging"},
	}
	checkRows(t, "2_not_production.sql", got, want)
}

