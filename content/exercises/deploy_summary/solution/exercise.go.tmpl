// Package deploy is the Groundwork exercise "Practice: deploy summary".
package deploy

import (
	"fmt"
	"strings"
)

// Release returns the cleaned-up service name and version, such as
// "api v1.4.2".
func Release(service, version string) string {
	return strings.ToLower(strings.TrimSpace(service)) + " " + version
}

// ReplicasNeeded returns how many replicas serve peakRPS requests per second
// when each replica serves rpsPerReplica.
func ReplicasNeeded(peakRPS, rpsPerReplica int) int {
	return (peakRPS + rpsPerReplica - 1) / rpsPerReplica
}

// Summary returns the one-line deploy summary, such as
// "api v1.4.2 -> production: 3 replicas x 256 MiB = 768 MiB".
func Summary(service, version, env string, replicas, memoryMiB int) string {
	return fmt.Sprintf("%s -> %s: %d replicas x %d MiB = %d MiB",
		Release(service, version), env, replicas, memoryMiB, replicas*memoryMiB)
}

// MonthlyCost returns the monthly memory cost of a deploy, such as
// "$6.00/month".
func MonthlyCost(replicas, memoryMiB int, dollarsPerGiB float64) string {
	gib := float64(replicas*memoryMiB) / 1024
	return fmt.Sprintf("$%.2f/month", gib*dollarsPerGiB)
}
