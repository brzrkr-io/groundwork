package services

import (
	"strconv"
	"testing"
)

func BenchmarkPorts(b *testing.B) {
	for _, n := range []int{10, 1000} {
		b.Run(strconv.Itoa(n), func(b *testing.B) {
			svcs := make([]Service, n)
			for i := range svcs {
				svcs[i] = Service{Name: "svc-" + strconv.Itoa(i), Port: 8000 + i}
			}
			b.ReportAllocs()
			for b.Loop() {
				Ports(svcs)
			}
		})
	}
}
