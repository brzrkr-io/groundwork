// Package triage is the Groundwork exercise "Practice: HTTP status triage".
package triage

import (
	"fmt"
	"strconv"
	"strings"
)

// StatusClass returns the class of an HTTP status code: "informational",
// "success", "redirect", "client error", "server error" or "unknown".
func StatusClass(code int) string {
	switch {
	case code >= 100 && code <= 199:
		return "informational"
	case code >= 200 && code <= 299:
		return "success"
	case code >= 300 && code <= 399:
		return "redirect"
	case code >= 400 && code <= 499:
		return "client error"
	case code >= 500 && code <= 599:
		return "server error"
	default:
		return "unknown"
	}
}

// ShouldRetry reports whether a request that got code is worth retrying.
func ShouldRetry(code int) bool {
	switch code {
	case 429, 502, 503, 504:
		return true
	default:
		return false
	}
}

// ParseStatus converts text such as "503" into a status code between 100 and
// 599. It returns an error when the text is not a valid status code.
func ParseStatus(text string) (int, error) {
	code, err := strconv.Atoi(strings.TrimSpace(text))
	if err != nil {
		return 0, err
	}
	if code < 100 || code > 599 {
		return 0, fmt.Errorf("status code %d is outside 100-599", code)
	}
	return code, nil
}

// Triage returns a one-line summary of the response a service gave.
func Triage(service, statusText string) string {
	code, err := ParseStatus(statusText)
	if err != nil {
		return fmt.Sprintf("%s: invalid status %q", service, statusText)
	}
	retry := "no retry"
	if ShouldRetry(code) {
		retry = "retry"
	}
	return fmt.Sprintf("%s: %d %s, %s", service, code, StatusClass(code), retry)
}
