package triage

import "testing"

func TestStatusClass(t *testing.T) {
	if got := StatusClass(100); got != "informational" {
		t.Errorf(`StatusClass(100) = %q, want "informational"`, got)
	}
	if got := StatusClass(199); got != "informational" {
		t.Errorf(`StatusClass(199) = %q, want "informational"`, got)
	}
	if got := StatusClass(200); got != "success" {
		t.Errorf(`StatusClass(200) = %q, want "success"`, got)
	}
	if got := StatusClass(204); got != "success" {
		t.Errorf(`StatusClass(204) = %q, want "success"`, got)
	}
	if got := StatusClass(299); got != "success" {
		t.Errorf(`StatusClass(299) = %q, want "success"`, got)
	}
	if got := StatusClass(301); got != "redirect" {
		t.Errorf(`StatusClass(301) = %q, want "redirect"`, got)
	}
	if got := StatusClass(399); got != "redirect" {
		t.Errorf(`StatusClass(399) = %q, want "redirect"`, got)
	}
	if got := StatusClass(400); got != "client error" {
		t.Errorf(`StatusClass(400) = %q, want "client error"`, got)
	}
	if got := StatusClass(404); got != "client error" {
		t.Errorf(`StatusClass(404) = %q, want "client error"`, got)
	}
	if got := StatusClass(499); got != "client error" {
		t.Errorf(`StatusClass(499) = %q, want "client error"`, got)
	}
	if got := StatusClass(500); got != "server error" {
		t.Errorf(`StatusClass(500) = %q, want "server error"`, got)
	}
	if got := StatusClass(503); got != "server error" {
		t.Errorf(`StatusClass(503) = %q, want "server error"`, got)
	}
	if got := StatusClass(599); got != "server error" {
		t.Errorf(`StatusClass(599) = %q, want "server error"`, got)
	}
	if got := StatusClass(99); got != "unknown" {
		t.Errorf(`StatusClass(99) = %q, want "unknown"`, got)
	}
	if got := StatusClass(600); got != "unknown" {
		t.Errorf(`StatusClass(600) = %q, want "unknown"`, got)
	}
	if got := StatusClass(0); got != "unknown" {
		t.Errorf(`StatusClass(0) = %q, want "unknown"`, got)
	}
}

func TestShouldRetry(t *testing.T) {
	if !ShouldRetry(429) {
		t.Errorf("ShouldRetry(429) = false, want true")
	}
	if !ShouldRetry(502) {
		t.Errorf("ShouldRetry(502) = false, want true")
	}
	if !ShouldRetry(503) {
		t.Errorf("ShouldRetry(503) = false, want true")
	}
	if !ShouldRetry(504) {
		t.Errorf("ShouldRetry(504) = false, want true")
	}
	if ShouldRetry(200) {
		t.Errorf("ShouldRetry(200) = true, want false")
	}
	if ShouldRetry(404) {
		t.Errorf("ShouldRetry(404) = true, want false")
	}
	if ShouldRetry(500) {
		t.Errorf("ShouldRetry(500) = true, want false")
	}
	if ShouldRetry(501) {
		t.Errorf("ShouldRetry(501) = true, want false")
	}
	if ShouldRetry(505) {
		t.Errorf("ShouldRetry(505) = true, want false")
	}
}

func TestParseStatus(t *testing.T) {
	got, err := ParseStatus("503")
	if got != 503 || err != nil {
		t.Errorf(`ParseStatus("503") = %d, %v, want 503, nil`, got, err)
	}
	got, err = ParseStatus("200")
	if got != 200 || err != nil {
		t.Errorf(`ParseStatus("200") = %d, %v, want 200, nil`, got, err)
	}
	got, err = ParseStatus(" 404 ")
	if got != 404 || err != nil {
		t.Errorf(`ParseStatus(" 404 ") = %d, %v, want 404, nil`, got, err)
	}
	got, err = ParseStatus("100")
	if got != 100 || err != nil {
		t.Errorf(`ParseStatus("100") = %d, %v, want 100, nil`, got, err)
	}
	got, err = ParseStatus("599")
	if got != 599 || err != nil {
		t.Errorf(`ParseStatus("599") = %d, %v, want 599, nil`, got, err)
	}
	got, err = ParseStatus("abc")
	if got != 0 || err == nil {
		t.Errorf(`ParseStatus("abc") = %d, %v, want 0 and an error`, got, err)
	}
	got, err = ParseStatus("")
	if got != 0 || err == nil {
		t.Errorf(`ParseStatus("") = %d, %v, want 0 and an error`, got, err)
	}
	got, err = ParseStatus("42")
	if got != 0 || err == nil {
		t.Errorf(`ParseStatus("42") = %d, %v, want 0 and an error`, got, err)
	}
	got, err = ParseStatus("99")
	if got != 0 || err == nil {
		t.Errorf(`ParseStatus("99") = %d, %v, want 0 and an error`, got, err)
	}
	got, err = ParseStatus("600")
	if got != 0 || err == nil {
		t.Errorf(`ParseStatus("600") = %d, %v, want 0 and an error`, got, err)
	}
	got, err = ParseStatus("5o3")
	if got != 0 || err == nil {
		t.Errorf(`ParseStatus("5o3") = %d, %v, want 0 and an error`, got, err)
	}
	got, err = ParseStatus("-200")
	if got != 0 || err == nil {
		t.Errorf(`ParseStatus("-200") = %d, %v, want 0 and an error`, got, err)
	}
}

func TestTriage(t *testing.T) {
	if got := Triage("checkout", "503"); got != "checkout: 503 server error, retry" {
		t.Errorf(`Triage("checkout", "503") = %q, want "checkout: 503 server error, retry"`, got)
	}
	if got := Triage("gateway", "429"); got != "gateway: 429 client error, retry" {
		t.Errorf(`Triage("gateway", "429") = %q, want "gateway: 429 client error, retry"`, got)
	}
	if got := Triage("search", "404"); got != "search: 404 client error, no retry" {
		t.Errorf(`Triage("search", "404") = %q, want "search: 404 client error, no retry"`, got)
	}
	if got := Triage("api", "200"); got != "api: 200 success, no retry" {
		t.Errorf(`Triage("api", "200") = %q, want "api: 200 success, no retry"`, got)
	}
	if got := Triage("payments", "500"); got != "payments: 500 server error, no retry" {
		t.Errorf(`Triage("payments", "500") = %q, want "payments: 500 server error, no retry"`, got)
	}
	if got := Triage("web", " 301"); got != "web: 301 redirect, no retry" {
		t.Errorf(`Triage("web", " 301") = %q, want "web: 301 redirect, no retry"`, got)
	}
	if got := Triage("billing", "oops"); got != `billing: invalid status "oops"` {
		t.Errorf(`Triage("billing", "oops") = %q, want "billing: invalid status \"oops\""`, got)
	}
	if got := Triage("auth", "700"); got != `auth: invalid status "700"` {
		t.Errorf(`Triage("auth", "700") = %q, want "auth: invalid status \"700\""`, got)
	}
}
