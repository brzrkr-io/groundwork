{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoDeletingBuckets",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": "*"
    },
    {
      "Sid": "ProtectPayroll",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::acme-payroll",
        "arn:aws:s3:::acme-payroll/*"
      ]
    },
    {
      "Sid": "NoTerminating",
      "Effect": "Deny",
      "Action": "ec2:TerminateInstances",
      "Resource": "*"
    }
  ]
}
