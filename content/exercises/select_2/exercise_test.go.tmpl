package heartbeat

import (
	"fmt"
	"slices"
	"testing"
	"testing/synctest"
	"time"
)

// sendEvents sends "event 1", "event 2", ... one per second, then closes
// the channel.
func sendEvents(count int) <-chan string {
	events := make(chan string, count) // buffered, so the sender never gets stuck
	go func() {
		for i := 1; i <= count; i++ {
			time.Sleep(time.Second)
			events <- fmt.Sprintf("event %d", i)
		}
		close(events)
	}()
	return events
}

func TestCollectFor(t *testing.T) {
	tests := []struct {
		name        string
		events      int
		window      time.Duration
		want        []string
		wantElapsed time.Duration
	}{
		{"window ends first", 10, 3500 * time.Millisecond, []string{"event 1", "event 2", "event 3"}, 3500 * time.Millisecond},
		{"short window", 10, 1500 * time.Millisecond, []string{"event 1"}, 1500 * time.Millisecond},
		{"channel closes first", 2, 5 * time.Second, []string{"event 1", "event 2"}, 2 * time.Second},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// synctest.Test gives the test a fake clock: sleeps and timers
			// finish instantly, but time.Now moves forward by the right amount.
			synctest.Test(t, func(t *testing.T) {
				events := sendEvents(tt.events)

				start := time.Now()
				got := CollectFor(events, tt.window)
				elapsed := time.Since(start)

				if !slices.Equal(got, tt.want) {
					t.Errorf("CollectFor(%d events, one per second, window %v) = %q, want %q", tt.events, tt.window, got, tt.want)
				}
				if elapsed != tt.wantElapsed {
					t.Errorf("CollectFor returned after %v, want %v", elapsed, tt.wantElapsed)
				}

				time.Sleep(time.Minute) // let the sender finish before the test ends
			})
		})
	}
}

func TestHeartbeat(t *testing.T) {
	tests := []struct {
		name      string
		interval  time.Duration
		stopAfter time.Duration
		want      int
	}{
		{"every second", time.Second, 3500 * time.Millisecond, 3},
		{"every two seconds", 2 * time.Second, 5 * time.Second, 2},
		{"stopped before the first beat", 10 * time.Second, 4 * time.Second, 0},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			synctest.Test(t, func(t *testing.T) {
				stop := make(chan struct{})
				go func() {
					time.Sleep(tt.stopAfter)
					close(stop)
				}()

				calls := 0
				beat := func() { calls++ }

				start := time.Now()
				returned := make(chan int)
				go func() { returned <- Heartbeat(tt.interval, stop, beat) }()

				select {
				case got := <-returned:
					elapsed := time.Since(start)
					if got != tt.want || calls != tt.want {
						t.Errorf("Heartbeat(%v), stopped after %v: returned %d and called beat %d times, want %d and %d",
							tt.interval, tt.stopAfter, got, calls, tt.want, tt.want)
					}
					if elapsed != tt.stopAfter {
						t.Errorf("Heartbeat returned after %v, want %v (as soon as stop is closed)", elapsed, tt.stopAfter)
					}
				case <-time.After(time.Hour):
					t.Fatalf("Heartbeat(%v) was still running an hour after stop was closed at %v: does your select have a case for stop?",
						tt.interval, tt.stopAfter)
				}

				time.Sleep(time.Minute) // let the stop goroutine finish before the test ends
			})
		})
	}
}
