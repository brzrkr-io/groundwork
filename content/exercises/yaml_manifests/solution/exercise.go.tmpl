// Package manifests is the Gopherlings exercise "YAML manifests: reading them into Go".
package manifests

import (
	"errors"
	"fmt"
	"strings"

	appsv1 "k8s.io/api/apps/v1"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"sigs.k8s.io/yaml"
)

// ParseDeployment reads one YAML document into a Deployment.
func ParseDeployment(data []byte) (*appsv1.Deployment, error) {
	var d appsv1.Deployment
	if err := yaml.Unmarshal(data, &d); err != nil {
		return nil, fmt.Errorf("parse deployment: %w", err)
	}
	return &d, nil
}

// ReadType reads only the apiVersion and kind of one YAML document.
func ReadType(data []byte) (metav1.TypeMeta, error) {
	var tm metav1.TypeMeta
	if err := yaml.Unmarshal(data, &tm); err != nil {
		return tm, fmt.Errorf("read type: %w", err)
	}
	if tm.Kind == "" {
		return tm, errors.New("read type: missing kind")
	}
	return tm, nil
}

// SplitDocuments splits a multi-document YAML stream on lines that are
// exactly "---". It returns the trimmed, non-empty documents in order.
func SplitDocuments(stream string) []string {
	var docs []string
	var current []string
	for line := range strings.SplitSeq(stream, "\n") {
		if line == "---" {
			docs = addDocument(docs, current)
			current = nil
			continue
		}
		current = append(current, line)
	}
	return addDocument(docs, current)
}

// addDocument joins lines into one document, trims it, and appends it to
// docs unless it is empty.
func addDocument(docs []string, lines []string) []string {
	doc := strings.TrimSpace(strings.Join(lines, "\n"))
	if doc == "" {
		return docs
	}
	return append(docs, doc)
}
