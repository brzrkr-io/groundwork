package breaker

import (
	"errors"
	"fmt"
	"sync"
	"testing"
	"time"
)

var errTimeout = errors.New("billing API: timeout")

// fakeClock is a clock the test moves by hand.
type fakeClock struct {
	t time.Time
}

func (c *fakeClock) now() time.Time          { return c.t }
func (c *fakeClock) advance(d time.Duration) { c.t = c.t.Add(d) }

func newClock() *fakeClock {
	return &fakeClock{t: time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)}
}

func fail() error    { return errTimeout }
func succeed() error { return nil }

// trip opens b by sending it threshold failures.
func trip(b *Breaker, threshold int) {
	for range threshold {
		b.Call(fail)
	}
}

func TestStateString(t *testing.T) {
	tests := []struct {
		state State
		want  string
	}{
		{Closed, "closed"},
		{Open, "open"},
		{HalfOpen, "half-open"},
		{State(7), "unknown"},
		{State(-1), "unknown"},
	}
	for _, tt := range tests {
		if got := tt.state.String(); got != tt.want {
			t.Errorf("State(%d).String() = %q, want %q", int(tt.state), got, tt.want)
		}
	}
}

func TestCallClosedAndOpen(t *testing.T) {
	t.Run("closed runs fn and returns its error", func(t *testing.T) {
		b := New(3, time.Minute, newClock().now)
		ran := 0
		err := b.Call(func() error { ran++; return nil })
		if err != nil || ran != 1 {
			t.Errorf("Call(success) = %v with fn run %d times, want <nil> with fn run 1 time", err, ran)
		}
		err = b.Call(func() error { ran++; return errTimeout })
		if !errors.Is(err, errTimeout) || ran != 2 {
			t.Errorf("Call(failure) = %v with fn run %d times total, want %v with fn run 2 times", err, ran, errTimeout)
		}
	})

	for _, threshold := range []int{1, 3} {
		t.Run(fmt.Sprintf("opens after %d failures", threshold), func(t *testing.T) {
			b := New(threshold, time.Minute, newClock().now)
			for i := range threshold - 1 {
				b.Call(fail)
				if got := b.State(); got != Closed {
					t.Fatalf("threshold %d: after %d failures, State() = %v, want %v", threshold, i+1, got, Closed)
				}
			}
			b.Call(fail)
			if got := b.State(); got != Open {
				t.Fatalf("threshold %d: after %d failures, State() = %v, want %v", threshold, threshold, got, Open)
			}
		})
	}

	t.Run("open fails fast without running fn", func(t *testing.T) {
		b := New(2, time.Minute, newClock().now)
		trip(b, 2)
		for range 2 {
			ran := false
			err := b.Call(func() error { ran = true; return nil })
			if !errors.Is(err, ErrOpen) {
				t.Errorf("Call() on an open breaker = %v, want %v", err, ErrOpen)
			}
			if ran {
				t.Errorf("Call() on an open breaker ran fn, want fn not run")
			}
		}
	})

	t.Run("success resets the failure count", func(t *testing.T) {
		b := New(3, time.Minute, newClock().now)
		calls := []func() error{fail, fail, succeed, fail, fail, succeed, fail, fail}
		for _, fn := range calls {
			b.Call(fn)
		}
		if got := b.State(); got != Closed {
			t.Errorf("after fail, fail, ok, fail, fail, ok, fail, fail with threshold 3: State() = %v, want %v", got, Closed)
		}
	})

	t.Run("safe for concurrent use", func(t *testing.T) {
		b := New(50, time.Minute, newClock().now)
		var wg sync.WaitGroup
		for range 50 {
			wg.Go(func() { b.Call(fail) })
		}
		wg.Wait()
		if got := b.State(); got != Open {
			t.Errorf("after 50 concurrent failures with threshold 50: State() = %v, want %v", got, Open)
		}
	})
}

func TestHalfOpen(t *testing.T) {
	const cooldown = 30 * time.Second

	t.Run("stays open until the cooldown has passed", func(t *testing.T) {
		clock := newClock()
		b := New(2, cooldown, clock.now)
		trip(b, 2)
		clock.advance(cooldown - time.Second)
		ran := false
		err := b.Call(func() error { ran = true; return nil })
		if !errors.Is(err, ErrOpen) || ran {
			t.Errorf("Call() 29s after opening = %v (fn run: %t), want %v (fn run: false)", err, ran, ErrOpen)
		}
	})

	t.Run("successful trial closes the breaker", func(t *testing.T) {
		clock := newClock()
		b := New(2, cooldown, clock.now)
		trip(b, 2)
		clock.advance(cooldown)
		var during State
		err := b.Call(func() error { during = b.State(); return nil })
		if err != nil {
			t.Fatalf("trial Call() = %v, want <nil>", err)
		}
		if during != HalfOpen {
			t.Errorf("State() during the trial = %v, want %v", during, HalfOpen)
		}
		if got := b.State(); got != Closed {
			t.Errorf("State() after a successful trial = %v, want %v", got, Closed)
		}
		// The failure count starts again from zero.
		b.Call(fail)
		if got := b.State(); got != Closed {
			t.Errorf("State() after 1 new failure with threshold 2 = %v, want %v", got, Closed)
		}
	})

	t.Run("failed trial opens the breaker again", func(t *testing.T) {
		clock := newClock()
		b := New(2, cooldown, clock.now)
		trip(b, 2)
		clock.advance(cooldown + 5*time.Second)
		if err := b.Call(fail); !errors.Is(err, errTimeout) {
			t.Fatalf("trial Call(fail) = %v, want %v", err, errTimeout)
		}
		if got := b.State(); got != Open {
			t.Fatalf("State() after a failed trial = %v, want %v", got, Open)
		}
		// The cooldown starts again from the failed trial.
		clock.advance(10 * time.Second)
		if err := b.Call(succeed); !errors.Is(err, ErrOpen) {
			t.Errorf("Call() 10s after the failed trial = %v, want %v", err, ErrOpen)
		}
		clock.advance(cooldown)
		if err := b.Call(succeed); err != nil {
			t.Errorf("Call() 40s after the failed trial = %v, want <nil>", err)
		}
		if got := b.State(); got != Closed {
			t.Errorf("State() after the second trial succeeded = %v, want %v", got, Closed)
		}
	})

	t.Run("only one trial at a time", func(t *testing.T) {
		clock := newClock()
		b := New(2, cooldown, clock.now)
		trip(b, 2)
		clock.advance(cooldown)
		var inner error
		b.Call(func() error {
			// A second call arrives while the trial is still running.
			inner = b.Call(succeed)
			return nil
		})
		if !errors.Is(inner, ErrOpen) {
			t.Errorf("Call() during a running trial = %v, want %v", inner, ErrOpen)
		}
	})
}
