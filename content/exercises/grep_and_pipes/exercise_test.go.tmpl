	expect(t, ""+
		"2026-10-13T09:15:02Z ERROR payments msg=\"card declined\" req=7f3a9c\n"+
		"2026-10-13T09:15:12Z ERROR api msg=\"upstream timeout\" req=9e8d7c\n"+
		"2026-10-13T09:15:18Z ERROR payments msg=\"gateway unreachable\" req=0f1e2d\n"+
		"2026-10-13T09:15:26Z ERROR checkout msg=\"stock check failed\" req=b8c9d0\n"+
		"2026-10-13T09:15:33Z ERROR payments msg=\"card declined\" req=d4e5f6\n",
		"1_error_lines.sh", "testdata/app.log")
	expect(t, ""+
		"2026-10-13T22:00:15Z ERROR mailer msg=\"smtp auth failed\" req=c2e8f4\n"+
		"2026-10-13T22:00:40Z ERROR worker msg=\"job failed: reports\" req=1d4f7a\n"+
		"2026-10-13T22:00:52Z ERROR mailer msg=\"smtp auth failed\" req=f85b21\n",
		"1_error_lines.sh", "testdata/worker.log")
}

func TestCountProblems(t *testing.T) {
	expect(t, "6\n", "2_count_problems.sh", "testdata/app.log")
	expect(t, "3\n", "2_count_problems.sh", "testdata/worker.log")
	// No ERROR or FATAL lines: grep -c prints 0 and exits with status 1.
	expect(t, "0\n", "2_count_problems.sh", "testdata/quiet.log")
}

