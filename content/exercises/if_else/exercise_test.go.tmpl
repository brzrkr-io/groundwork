package ifelse

import "testing"

func TestDiskAlert(t *testing.T) {
	if got := DiskAlert(42); got != "ok" {
		t.Errorf(`DiskAlert(42) = %q, want "ok"`, got)
	}
	if got := DiskAlert(79); got != "ok" {
		t.Errorf(`DiskAlert(79) = %q, want "ok"`, got)
	}
	if got := DiskAlert(80); got != "warning" {
		t.Errorf(`DiskAlert(80) = %q, want "warning"`, got)
	}
	if got := DiskAlert(89); got != "warning" {
		t.Errorf(`DiskAlert(89) = %q, want "warning"`, got)
	}
	if got := DiskAlert(90); got != "critical" {
		t.Errorf(`DiskAlert(90) = %q, want "critical"`, got)
	}
	if got := DiskAlert(100); got != "critical" {
		t.Errorf(`DiskAlert(100) = %q, want "critical"`, got)
	}
}

func TestClampReplicas(t *testing.T) {
	if got := ClampReplicas(-3); got != 1 {
		t.Errorf("ClampReplicas(-3) = %d, want 1", got)
	}
	if got := ClampReplicas(0); got != 1 {
		t.Errorf("ClampReplicas(0) = %d, want 1", got)
	}
	if got := ClampReplicas(1); got != 1 {
		t.Errorf("ClampReplicas(1) = %d, want 1", got)
	}
	if got := ClampReplicas(4); got != 4 {
		t.Errorf("ClampReplicas(4) = %d, want 4", got)
	}
	if got := ClampReplicas(10); got != 10 {
		t.Errorf("ClampReplicas(10) = %d, want 10", got)
	}
	if got := ClampReplicas(25); got != 10 {
		t.Errorf("ClampReplicas(25) = %d, want 10", got)
	}
}

func TestScaleAdvice(t *testing.T) {
	if got := ScaleAdvice(1000, 0); got != "no replicas" {
		t.Errorf(`ScaleAdvice(1000, 0) = %q, want "no replicas"`, got)
	}
	if got := ScaleAdvice(1000, -1); got != "no replicas" {
		t.Errorf(`ScaleAdvice(1000, -1) = %q, want "no replicas"`, got)
	}
	if got := ScaleAdvice(1000, 5); got != "scale up" {
		t.Errorf(`ScaleAdvice(1000, 5) = %q, want "scale up"`, got)
	}
	if got := ScaleAdvice(202, 2); got != "scale up" {
		t.Errorf(`ScaleAdvice(202, 2) = %q, want "scale up"`, got)
	}
	if got := ScaleAdvice(500, 5); got != "steady" {
		t.Errorf(`ScaleAdvice(500, 5) = %q, want "steady"`, got)
	}
	if got := ScaleAdvice(300, 5); got != "steady" {
		t.Errorf(`ScaleAdvice(300, 5) = %q, want "steady"`, got)
	}
	if got := ScaleAdvice(100, 5); got != "steady" {
		t.Errorf(`ScaleAdvice(100, 5) = %q, want "steady"`, got)
	}
	if got := ScaleAdvice(50, 5); got != "scale down" {
		t.Errorf(`ScaleAdvice(50, 5) = %q, want "scale down"`, got)
	}
	if got := ScaleAdvice(59, 3); got != "scale down" {
		t.Errorf(`ScaleAdvice(59, 3) = %q, want "scale down"`, got)
	}
}
