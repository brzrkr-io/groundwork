package variables

import "testing"

func TestFQDN(t *testing.T) {
	if got := FQDN("web-01", "prod.example.com"); got != "web-01.prod.example.com" {
		t.Errorf(`FQDN("web-01", "prod.example.com") = %q, want "web-01.prod.example.com"`, got)
	}

	if got := FQDN("db-02", "staging.example.com"); got != "db-02.staging.example.com" {
		t.Errorf(`FQDN("db-02", "staging.example.com") = %q, want "db-02.staging.example.com"`, got)
	}
}

func TestLogPath(t *testing.T) {
	if got := LogPath("nginx", "2026-10-11"); got != "/var/log/nginx/2026-10-11.log" {
		t.Errorf(`LogPath("nginx", "2026-10-11") = %q, want "/var/log/nginx/2026-10-11.log"`, got)
	}

	if got := LogPath("api", "2026-01-31"); got != "/var/log/api/2026-01-31.log" {
		t.Errorf(`LogPath("api", "2026-01-31") = %q, want "/var/log/api/2026-01-31.log"`, got)
	}
}

func TestAlertTitle(t *testing.T) {
	if got := AlertTitle("critical", "api", "disk almost full"); got != "[critical] api: disk almost full" {
		t.Errorf(`AlertTitle("critical", "api", "disk almost full") = %q, want "[critical] api: disk almost full"`, got)
	}

	if got := AlertTitle("warning", "billing", "slow responses"); got != "[warning] billing: slow responses" {
		t.Errorf(`AlertTitle("warning", "billing", "slow responses") = %q, want "[warning] billing: slow responses"`, got)
	}
}
