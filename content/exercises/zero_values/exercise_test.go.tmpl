package zerovalues

import "testing"

func TestZeroSummary(t *testing.T) {
	want := `port=0 host="" debug=false ratio=0`
	if got := ZeroSummary(); got != want {
		t.Errorf("ZeroSummary() = %q, want %q", got, want)
	}
}

func TestPortOrDefault(t *testing.T) {
	if got := PortOrDefault(0); got != 8080 {
		t.Errorf("PortOrDefault(0) = %d, want 8080", got)
	}
	if got := PortOrDefault(9090); got != 9090 {
		t.Errorf("PortOrDefault(9090) = %d, want 9090", got)
	}
	if got := PortOrDefault(443); got != 443 {
		t.Errorf("PortOrDefault(443) = %d, want 443", got)
	}
}

func TestConnectionString(t *testing.T) {
	if got := ConnectionString("", 0, 0); got != "localhost:8080 timeout=30s" {
		t.Errorf(`ConnectionString("", 0, 0) = %q, want "localhost:8080 timeout=30s"`, got)
	}
	if got := ConnectionString("db.internal", 5432, 5); got != "db.internal:5432 timeout=5s" {
		t.Errorf(`ConnectionString("db.internal", 5432, 5) = %q, want "db.internal:5432 timeout=5s"`, got)
	}
	if got := ConnectionString("cache", 0, 10); got != "cache:8080 timeout=10s" {
		t.Errorf(`ConnectionString("cache", 0, 10) = %q, want "cache:8080 timeout=10s"`, got)
	}
	if got := ConnectionString("", 9000, 0); got != "localhost:9000 timeout=30s" {
		t.Errorf(`ConnectionString("", 9000, 0) = %q, want "localhost:9000 timeout=30s"`, got)
	}
}
